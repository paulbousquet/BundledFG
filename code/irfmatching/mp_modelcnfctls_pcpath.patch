diff --git a/tests/test_get_posterior_mode_pcpaths.m b/tests/test_get_posterior_mode_pcpaths.m
new file mode 100644
index 0000000..f1914e4
--- /dev/null
+++ b/tests/test_get_posterior_mode_pcpaths.m
@@ -0,0 +1,173 @@
+function tests = test_get_posterior_mode_pcpaths
+%TEST_GET_POSTERIOR_MODE_PCPATHS Preflight tests for the mode driver.
+
+tests = functiontests(localfunctions);
+
+end
+
+function setupOnce(testCase)
+
+tests_dir = fileparts(mfilename('fullpath'));
+repo_root = fileparts(tests_dir);
+
+testCase.TestData.original_path = path;
+testCase.TestData.repo_root = repo_root;
+addpath(fullfile(repo_root, 'model_estim'));
+
+testCase.TestData.temp_dir = tempname;
+mkdir(testCase.TestData.temp_dir);
+
+end
+
+function teardownOnce(testCase)
+
+path(testCase.TestData.original_path);
+if isfolder(testCase.TestData.temp_dir)
+    existing_results = fullfile(testCase.TestData.temp_dir, 'existing.mat');
+    if isfile(existing_results)
+        delete(existing_results);
+    end
+    rmdir(testCase.TestData.temp_dir);
+end
+
+end
+
+function test_missing_empirical_targets_fail_clearly(testCase)
+
+missing_targets = fullfile(testCase.TestData.temp_dir, ...
+    'deliberately_missing_targets.mat');
+testCase.verifyError(@() get_posterior_mode_pcpaths( ...
+    struct('data_file', missing_targets)), ...
+    'get_posterior_mode_pcpaths:EmpiricalDataNotFound');
+
+end
+
+function test_relative_paths_reach_missing_data_check(testCase)
+
+original_working_directory = pwd;
+working_directory_cleanup = onCleanup( ...
+    @() cd(original_working_directory));
+cd(testCase.TestData.temp_dir);
+
+relative_targets = fullfile('model_estim', '_data', ...
+    'deliberately_missing_relative_targets.mat');
+absolute_targets = fullfile(testCase.TestData.repo_root, ...
+    relative_targets);
+testCase.assertFalse(isfile(absolute_targets));
+relative_repo_root = path_relative_to( ...
+    testCase.TestData.temp_dir, testCase.TestData.repo_root);
+testCase.assertFalse(javaObject( ...
+    'java.io.File', relative_repo_root).isAbsolute());
+
+options = struct( ...
+    'repo_root', relative_repo_root, ...
+    'data_file', relative_targets);
+caught_error = [];
+try
+    get_posterior_mode_pcpaths(options);
+catch caught_error
+end
+testCase.assertNotEmpty(caught_error);
+testCase.verifyEqual(caught_error.identifier, ...
+    'get_posterior_mode_pcpaths:EmpiricalDataNotFound');
+testCase.verifySubstring(caught_error.message, absolute_targets);
+testCase.verifyEqual(pwd, testCase.TestData.temp_dir);
+
+end
+
+function test_rejects_unknown_options_before_loading_data(testCase)
+
+testCase.verifyError(@() get_posterior_mode_pcpaths( ...
+    struct('unexpected_option', true)), ...
+    'get_posterior_mode_pcpaths:UnknownOption');
+
+end
+
+function test_rejects_invalid_dimension_combinations(testCase)
+
+testCase.verifyError(@() get_posterior_mode_pcpaths( ...
+    struct('H_path', 7, 'J_news', 8)), ...
+    'get_posterior_mode_pcpaths:NonSquarePathSystem');
+
+testCase.verifyError(@() get_posterior_mode_pcpaths( ...
+    struct('K_pc', 3)), ...
+    'get_posterior_mode_pcpaths:InvalidFactorCount');
+
+testCase.verifyError(@() get_posterior_mode_pcpaths( ...
+    struct('T_model', 20, 'L_pi', 25, 'L_y', 25)), ...
+    'get_posterior_mode_pcpaths:InvalidModelHorizon');
+
+end
+
+function test_existing_results_require_explicit_overwrite_permission(testCase)
+
+existing_results = fullfile(testCase.TestData.temp_dir, 'existing.mat');
+marker = 1;
+save(existing_results, 'marker');
+missing_targets = fullfile(testCase.TestData.temp_dir, 'missing_targets.mat');
+
+options = struct( ...
+    'data_file', missing_targets, ...
+    'save_results', true, ...
+    'save_file', existing_results);
+testCase.verifyError(@() get_posterior_mode_pcpaths(options), ...
+    'get_posterior_mode_pcpaths:ResultsFileExists');
+
+options.overwrite_results = true;
+testCase.verifyError(@() get_posterior_mode_pcpaths(options), ...
+    'get_posterior_mode_pcpaths:EmpiricalDataNotFound');
+
+options.save_results = false;
+options.overwrite_results = false;
+testCase.verifyError(@() get_posterior_mode_pcpaths(options), ...
+    'get_posterior_mode_pcpaths:EmpiricalDataNotFound');
+
+end
+
+function test_results_may_not_alias_input_even_with_overwrite(testCase)
+
+original_working_directory = pwd;
+working_directory_cleanup = onCleanup( ...
+    @() cd(original_working_directory));
+cd(testCase.TestData.temp_dir);
+
+alias_name = 'aliased_input_and_results.mat';
+testCase.assertFalse(isfile(alias_name));
+options = struct( ...
+    'repo_root', testCase.TestData.repo_root, ...
+    'data_file', fullfile('.', alias_name), ...
+    'save_results', true, ...
+    'save_file', alias_name, ...
+    'overwrite_results', true);
+testCase.verifyError(@() get_posterior_mode_pcpaths(options), ...
+    'get_posterior_mode_pcpaths:ResultsAliasInput');
+testCase.verifyFalse(isfile(alias_name));
+
+end
+
+function test_rejects_directory_as_results_path(testCase)
+
+missing_targets = fullfile(testCase.TestData.temp_dir, ...
+    'missing_targets_for_directory_save.mat');
+options = struct( ...
+    'repo_root', testCase.TestData.repo_root, ...
+    'data_file', missing_targets, ...
+    'save_results', true, ...
+    'save_file', testCase.TestData.temp_dir, ...
+    'overwrite_results', true);
+testCase.verifyError(@() get_posterior_mode_pcpaths(options), ...
+    'get_posterior_mode_pcpaths:InvalidResultsPath');
+
+end
+
+function relative_path = path_relative_to(base_directory, target_path)
+
+base_file = javaObject('java.io.File', base_directory);
+target_file = javaObject('java.io.File', target_path);
+relative_path = char( ...
+    base_file.toPath().relativize(target_file.toPath()).toString());
+if isempty(relative_path)
+    relative_path = '.';
+end
+
+end
diff --git a/tests/test_h3_vs_pc_identification.m b/tests/test_h3_vs_pc_identification.m
new file mode 100644
index 0000000..22fe4d8
--- /dev/null
+++ b/tests/test_h3_vs_pc_identification.m
@@ -0,0 +1,126 @@
+function tests = test_h3_vs_pc_identification
+%TEST_H3_VS_PC_IDENTIFICATION Population identification-audit tests.
+
+tests = functiontests(localfunctions);
+
+end
+
+function setupOnce(testCase)
+
+repo_root = fileparts(fileparts(mfilename('fullpath')));
+testCase.TestData.original_path = path;
+addpath(fullfile(repo_root, '_auxiliary_functions'));
+addpath(fullfile(repo_root, 'model_estim'));
+
+end
+
+function teardownOnce(testCase)
+
+path(testCase.TestData.original_path);
+
+end
+
+function test_frozen_empirical_design_and_exact_timing(testCase)
+
+design = get_empirical_v_n174(80);
+testCase.verifyEqual(design.contract_horizons, (0:7)');
+testCase.verifyEqual(design.contract_labels(4), "ED4");
+testCase.verifyEqual(design.M_F, [eye(8), zeros(8, 72)], ...
+    'AbsTol', 0);
+testCase.verifyEqual(diag(design.Sigma_f), ...
+    [6.884493854947044; 0.8757776096042114], 'AbsTol', 1e-15);
+testCase.verifyEqual(design.V_path_model(1, :), ...
+    [0.0130289663256642, 0.0542329828533712], 'AbsTol', 1e-15);
+
+end
+
+function test_scalar_contract_direction_identities(testCase)
+
+design = get_empirical_v_n174(8);
+direction = build_scalar_contract_direction( ...
+    design.V_path_model, design.Sigma_f, 3);
+contract_covariance = design.V_path_model * design.Sigma_f * ...
+    design.V_path_model';
+expected_path = contract_covariance(:, 4) / contract_covariance(4, 4);
+
+testCase.verifyEqual(direction.v_h, expected_path, 'AbsTol', 1e-13);
+testCase.verifyEqual(direction.v_h(4), 1, 'AbsTol', 1e-14);
+testCase.verifyEqual(direction.v_h, ...
+    design.V_path_model * direction.a_h, 'AbsTol', 1e-14);
+testCase.verifyEqual(direction.a_h' * direction.a_perp, 0, ...
+    'AbsTol', 1e-14);
+
+end
+
+function test_factor_rotation_leaves_treatment_paths_invariant(testCase)
+
+design = get_empirical_v_n174(8);
+theta = 0.41;
+Q = [cos(theta), -sin(theta); sin(theta), cos(theta)];
+baseline = build_scalar_contract_direction( ...
+    design.V_path_model, design.Sigma_f, 3);
+rotated = build_scalar_contract_direction(design.V_path_model * Q, ...
+    Q' * design.Sigma_f * Q, 3);
+
+testCase.verifyEqual(rotated.v_h, baseline.v_h, 'AbsTol', 1e-13);
+testCase.verifyEqual(rotated.v_perp, baseline.v_perp, 'AbsTol', 1e-13);
+
+end
+
+function test_centered_finite_differences_recover_linear_jacobians(testCase)
+
+A = [1, 2, -1; 0.5, -0.2, 0.8];
+B = [A; 2 * A];
+moment_handle = @(param) toy_moments(param, A, B);
+result = finite_difference_path_jacobians(moment_handle, ...
+    [0.4, 0.5, 0.6], [0.1, 0.2, 0.3], zeros(1, 3), ones(1, 3), ...
+    struct('StepFraction', 1e-4, 'HalfStepRatio', 0.5, ...
+    'ReliabilityTolerance', 1e-8));
+
+testCase.verifyEqual(result.D_h3, A, 'AbsTol', 1e-10);
+testCase.verifyEqual(result.D_pc, B, 'AbsTol', 1e-10);
+testCase.verifyTrue(result.all_reliable);
+
+end
+
+function test_published_truth_has_robust_weak_local_identification(testCase)
+
+result = diagnose_h3_vs_pc_identification(struct( ...
+    'NProfilePoints', 3, 'RunMultistart', false, ...
+    'RunRobustness', false, 'SaveOutputs', false));
+
+testCase.verifyEqual(result.classification.label, ...
+    'weak_local_identification');
+testCase.verifyEqual(result.h3_svd.ranks(end), 9);
+testCase.verifyEqual(result.pc_svd.ranks(end), 9);
+testCase.verifyGreaterThan(result.minimum_singular_value_gain, 8.0);
+testCase.verifyGreaterThan(result.sensitivity_gain_along_q, 11.9);
+testCase.verifyTrue(result.finite_difference.all_reliable);
+testCase.verifyGreaterThan(result.path_rcond, 0.1);
+testCase.verifyLessThan(result.path_reconstruction_error, 1e-12);
+
+end
+
+function test_population_targets_use_no_prior_or_sampling_covariance(testCase)
+
+result = diagnose_h3_vs_pc_identification(struct( ...
+    'NProfilePoints', 3, 'RunMultistart', false, ...
+    'RunRobustness', false, 'SaveOutputs', false));
+
+testCase.verifyFalse(result.prior_used);
+testCase.verifyFalse(result.sampling_uncertainty_used);
+testCase.verifyEqual(result.population_loss_h3_at_truth, 0, 'AbsTol', 0);
+testCase.verifyEqual(result.population_loss_pc_at_truth, 0, 'AbsTol', 0);
+testCase.verifyEqual(result.truth.B_h3, ...
+    result.truth.B_pc * result.scalar_direction.a_h, 'AbsTol', 1e-11);
+testCase.verifyEqual(result.truth.m_h3, ...
+    sqrt(result.scalar_direction.denominator) * result.truth.m_h3_raw, ...
+    'AbsTol', 1e-13);
+
+end
+
+function output = toy_moments(param, A, B)
+
+output = struct('m_h3', A * param(:), 'm_pc', B * param(:));
+
+end
diff --git a/tests/test_map_paths_to_news.m b/tests/test_map_paths_to_news.m
new file mode 100644
index 0000000..d1a1e8b
--- /dev/null
+++ b/tests/test_map_paths_to_news.m
@@ -0,0 +1,266 @@
+function tests = test_map_paths_to_news
+%TEST_MAP_PATHS_TO_NEWS Unit tests for exact policy-path inversion.
+
+tests = functiontests(localfunctions);
+
+end
+
+function setupOnce(testCase)
+
+tests_dir = fileparts(mfilename('fullpath'));
+repo_root = fileparts(tests_dir);
+
+testCase.TestData.original_path = path;
+testCase.TestData.fixture = make_fixture();
+addpath(fullfile(repo_root, '_auxiliary_functions'));
+
+end
+
+function teardownOnce(testCase)
+
+path(testCase.TestData.original_path);
+
+end
+
+function test_exact_square_reconstruction_and_diagnostics(testCase)
+
+f = testCase.TestData.fixture;
+P_expected = f.M_F * f.R(:,1:f.J);
+
+[news_basis, path_fit, diagnostics] = map_paths_to_news( ...
+    f.R, f.V, f.M_F, f.H, f.J, f.options);
+
+tol = scaled_tolerance(f.V);
+testCase.verifySize(news_basis, [f.J, size(f.V,2)]);
+testCase.verifySize(path_fit, size(f.V));
+testCase.verifyLessThanOrEqual(max(abs(path_fit(:) - f.V(:))), tol);
+testCase.verifyEqual(diagnostics.P_news, P_expected, 'AbsTol', tol);
+testCase.verifyEqual(diagnostics.rcond, rcond(P_expected), ...
+    'AbsTol', 10*eps);
+testCase.verifyEqual(diagnostics.singular_values, svd(P_expected), ...
+    'AbsTol', tol);
+testCase.verifyEqual(diagnostics.max_abs_path_error, ...
+    max(abs(path_fit(:) - f.V(:))), 'AbsTol', eps);
+testCase.verifyEqual(diagnostics.news_norms(:), ...
+    sqrt(sum(news_basis.^2,1)).', 'AbsTol', tol);
+testCase.verifyFalse(diagnostics.is_ill_conditioned);
+
+end
+
+function test_canonical_news_shock_recovery(testCase)
+
+f = testCase.TestData.fixture;
+P_news = f.M_F * f.R(:,1:f.J);
+
+for j = 1:f.J
+    V_test = P_news(:,j);
+    news_basis = map_paths_to_news( ...
+        f.R, V_test, f.M_F, f.H, f.J, f.options);
+
+    expected = zeros(f.J,1);
+    expected(j) = 1;
+    testCase.verifyEqual(news_basis, expected, ...
+        'AbsTol', scaled_tolerance(expected));
+end
+
+end
+
+function test_linear_combination_identities(testCase)
+
+f = testCase.TestData.fixture;
+P_news = f.M_F * f.R(:,1:f.J);
+news_basis = map_paths_to_news( ...
+    f.R, f.V, f.M_F, f.H, f.J, f.options);
+
+factor_realization = [0.35; -0.60];
+macro_news = reshape(cos(1:(5*f.J)), 5, f.J) / 7;
+
+testCase.verifyEqual(P_news * (news_basis * factor_realization), ...
+    f.V * factor_realization, 'AbsTol', scaled_tolerance(f.V));
+testCase.verifyEqual(macro_news * (news_basis * factor_realization), ...
+    (macro_news * news_basis) * factor_realization, ...
+    'AbsTol', scaled_tolerance(macro_news));
+
