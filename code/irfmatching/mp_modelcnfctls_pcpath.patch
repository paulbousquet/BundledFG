+function out = build_scalar_contract_direction( ...
+    V_path_model, Sigma_f, h_star)
+%BUILD_SCALAR_CONTRACT_DIRECTION Population path induced by one contract.
+%
+% H_STAR is zero based. The returned path is the population regression of
+% the complete contract vector on the selected contract change, normalized
+% so that its selected coordinate equals one.
+
+validate_finite_matrix(V_path_model, 'V_path_model');
+validate_finite_matrix(Sigma_f, 'Sigma_f');
+if size(Sigma_f, 1) ~= size(Sigma_f, 2) || ...
+        size(Sigma_f, 1) ~= size(V_path_model, 2)
+    error('build_scalar_contract_direction:DimensionMismatch', ...
+        'Sigma_f must be square with one row per column of V_path_model.');
+end
+if norm(Sigma_f - Sigma_f', inf) > ...
+        100 * eps(max(1, norm(Sigma_f, inf)))
+    error('build_scalar_contract_direction:InvalidCovariance', ...
+        'Sigma_f must be symmetric.');
+end
+try
+    chol((Sigma_f + Sigma_f') / 2);
+catch
+    error('build_scalar_contract_direction:InvalidCovariance', ...
+        'Sigma_f must be positive definite.');
+end
+if ~isnumeric(h_star) || ~isreal(h_star) || ~isscalar(h_star) || ...
+        ~isfinite(h_star) || h_star < 0 || h_star ~= fix(h_star) || ...
+        h_star >= size(V_path_model, 1)
+    error('build_scalar_contract_direction:InvalidHorizon', ...
+        'h_star must be a zero-based row index of V_path_model.');
+end
+
+selected_row = V_path_model(h_star + 1, :);
+denominator = selected_row * Sigma_f * selected_row';
+denominator_tolerance = 100 * eps(max(1, ...
+    norm(selected_row)^2 * norm(Sigma_f, 2)));
+if ~isfinite(denominator) || denominator <= denominator_tolerance
+    error('build_scalar_contract_direction:DegenerateContract', ...
+        'The selected contract has zero or numerically negligible variance.');
+end
+
+a_h = (Sigma_f * selected_row') / denominator;
+v_h = V_path_model * a_h;
+normalization_error = abs(v_h(h_star + 1) - 1);
+normalization_tolerance = 100 * eps(max(1, norm(v_h, inf)));
+if normalization_error > normalization_tolerance
+    error('build_scalar_contract_direction:NormalizationFailed', ...
+        'The selected coordinate is not one to numerical precision.');
+end
+
+a_perp = [-a_h(2); a_h(1)] / norm(a_h);
+v_perp = V_path_model * a_perp;
+
+out = struct();
+out.h_star = h_star;
+out.selected_row = selected_row;
+out.denominator = denominator;
+out.a_h = a_h;
+out.v_h = v_h;
+out.a_perp = a_perp;
+out.v_perp = v_perp;
+out.normalization_error = normalization_error;
+out.normalization_tolerance = normalization_tolerance;
+
+end
+
+function validate_finite_matrix(value, name)
+
+if ~isnumeric(value) || ~isfloat(value) || ~isreal(value) || ...
+        ~ismatrix(value) || isempty(value) || any(~isfinite(value(:)))
+    error('build_scalar_contract_direction:InvalidInput', ...
+        '%s must be a nonempty finite real floating-point matrix.', name);
+end
+
+end
