+
+[~, initial_profile] = guarded_objective(0);
+verify_stored_profile(testCase, result, 1, initial_profile);
+verify_stored_profile(testCase, result, 2, initial_profile);
+[~, final_profile] = guarded_objective(0.25);
+verify_stored_profile(testCase, result, 3, final_profile);
+
+end
