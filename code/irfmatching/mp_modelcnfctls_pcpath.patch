+function f = make_fixture()
+
+f.H = 4;
+f.J = 4;
+f.T = 7;
+f.K = 2;
+f.L_pi = 3;
+f.L_y = 2;
+M = f.L_pi + f.L_y;
+
+P_news = [1.00  0.20 -0.10  0.05;
+          0.15  0.95  0.12 -0.02;
+         -0.05  0.10  1.10  0.08;
+          0.02 -0.04  0.09  0.90];
+
+f.R = zeros(f.T, f.T);
+f.R(1:f.H,1:f.J) = P_news;
+f.R(5:7,1:f.J) = [0.30 0.20 0.10 0;
+                   0.20 0.25 0.15 0.05;
+                   0.10 0.20 0.20 0.10];
+f.Pi = zeros(f.T, f.T);
+f.Y = zeros(f.T, f.T);
+f.Pi(:,1:f.J) = reshape(sin(1:(f.T*f.J)), f.T, f.J) / 5;
+f.Y(:,1:f.J) = reshape(cos(1:(f.T*f.J)), f.T, f.J) / 4;
+
+V = [0.21  0.88;
+     0.36  0.27;
+     0.37  0.08;
+     0.38 -0.07];
+M_F = [eye(f.H), zeros(f.H, f.T-f.H)];
+news_basis = P_news \ V;
+B_model = [f.Pi(1:f.L_pi,1:f.J) * news_basis;
+           f.Y(1:f.L_y,1:f.J) * news_basis];
+target_offset = [ 0.010 -0.020;
+                 -0.030  0.015;
+                  0.020  0.010;
+                 -0.015  0.025;
+                  0.005 -0.010];
+f.B_emp = B_model + target_offset;
+
+A = reshape(sin(1:((M*f.K)^2)), M*f.K, M*f.K);
+precision = A' * A + diag(linspace(1, 2, M*f.K));
+
+f.emp = struct();
+f.emp.V_path_model = V;
+f.emp.M_F = M_F;
+f.emp.target_pc = f.B_emp(:);
+f.emp.Sigma_B_inv = precision;
+
+f.cfg = struct();
+f.cfg.H_path = f.H;
+f.cfg.J_news = f.J;
+f.cfg.K_pc = f.K;
+f.cfg.L_pi = f.L_pi;
+f.cfg.L_y = f.L_y;
+f.cfg.T_model = f.T;
+f.cfg.map_options = struct( ...
+    'rcond_fail', 1e-12, ...
+    'rcond_warn', 1e-8, ...
+    'path_tol_abs', 1e-12, ...
+    'path_tol_rel', 1e-11, ...
+    'emit_warning', false);
+
+end
+
+function tol = scaled_tolerance(value)
+
+tol = 1e-11 * max(1, norm(value(:), inf));
+
+end
