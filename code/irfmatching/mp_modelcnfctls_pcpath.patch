+function test_orthogonal_rotation_invariance_with_nonisotropic_precision(testCase)
+
+f = testCase.TestData.fixture;
+[loss_base, out_base] = profile_pcpath_irfs(f.Pi, f.Y, f.R, f.emp, f.cfg);
+
+theta = 0.37;
+Q = [cos(theta), -sin(theta);
+     sin(theta),  cos(theta)];
+[emp_rotated, ~] = transform_factor_basis(f, Q);
+[loss_rotated, out_rotated] = profile_pcpath_irfs( ...
+    f.Pi, f.Y, f.R, emp_rotated, f.cfg);
+
+tol = scaled_tolerance([out_base.B_model(:); out_base.news_basis(:)]);
+testCase.verifyEqual(loss_rotated, loss_base, 'AbsTol', tol);
+testCase.verifyEqual(out_rotated.news_basis, out_base.news_basis * Q, ...
+    'AbsTol', tol);
+testCase.verifyEqual(out_rotated.B_model, out_base.B_model * Q, ...
+    'AbsTol', tol);
+testCase.verifyEqual(out_rotated.rate_pc_full, out_base.rate_pc_full * Q, ...
+    'AbsTol', tol);
+
+% This guards against an accidentally isotropic fixture: omitting the
+% covariance rotation must materially alter this objective.
+emp_wrong_weight = emp_rotated;
+emp_wrong_weight.Sigma_B_inv = f.emp.Sigma_B_inv;
+loss_wrong_weight = profile_pcpath_irfs( ...
+    f.Pi, f.Y, f.R, emp_wrong_weight, f.cfg);
+testCase.verifyGreaterThan(abs(loss_wrong_weight - loss_base), 1e-6);
+
+end
