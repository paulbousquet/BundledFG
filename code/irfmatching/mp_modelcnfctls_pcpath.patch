+function test_rank_hank_seven_nine_parameter_parity_at_two_T(testCase)
+
+repo_root = testCase.TestData.repo_root;
+models = {'/rank', '/hank'};
+truncations = [10, 12];
+
+for i_model = 1:numel(models)
+    model_name = models{i_model};
+    for T_value = truncations
+        initialize_model(repo_root, model_name, T_value);
+        if strcmp(model_name, '/rank')
+            param7 = [0.73, 0.85, 0.99999, 0.74, ...
+                0.99999, 5.3, 0.47];
+        else
+            param7 = [0.9654, 0.9530, 0.99999, 0.8763, ...
+                0.99999, 5.7686, 0.4618];
+        end
+        compare_legacy_and_pcpath(testCase, param7, model_name);
+        compare_legacy_and_pcpath( ...
+            testCase, [param7, 0.82, 0.77], model_name);
+    end
+end
+
+end
