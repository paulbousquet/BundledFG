+function tests = test_plot_model_irfs_pcpaths
+%TEST_PLOT_MODEL_IRFS_PCPATHS Headless smoke and validation tests.
+
+tests = functiontests(localfunctions);
+
+end
+
+function setupOnce(test_case)
+
+test_case.TestData.original_path = path;
+repo_root = fileparts(fileparts(mfilename('fullpath')));
+addpath(fullfile(repo_root, 'model_estim'));
+
+end
+
+function teardownOnce(test_case)
+
+path(test_case.TestData.original_path);
+
+end
+
+function test_creates_all_diagnostic_figures(test_case)
+
+[profile, emp, cfg] = synthetic_inputs(2);
+figures = plot_model_irfs_pcpaths(profile, emp, cfg, ...
+    struct('Visible', 'off'));
+cleanup = onCleanup(@() close_figures(figures));
+
+verifyTrue(test_case, isgraphics(figures.path_and_news, 'figure'));
+verifyTrue(test_case, isgraphics(figures.macro_irfs, 'figure'));
+verifyTrue(test_case, ...
+    isgraphics(figures.tail_and_conditioning, 'figure'));
+verifyEqual(test_case, numel(findall(figures.path_and_news, ...
+    'Type', 'axes')), 4);
+verifyEqual(test_case, numel(findall(figures.macro_irfs, ...
+    'Type', 'axes')), 4);
+
+end
+
+function test_accepts_one_factor(test_case)
+
+[profile, emp, cfg] = synthetic_inputs(1);
+figures = plot_model_irfs_pcpaths(profile, emp, cfg, ...
+    struct('Visible', 'off'));
+cleanup = onCleanup(@() close_figures(figures));
+
+verifyTrue(test_case, isgraphics(figures.path_and_news, 'figure'));
+verifyEqual(test_case, numel(findall(figures.macro_irfs, ...
+    'Type', 'axes')), 2);
+
+end
+
+function test_rejects_inconsistent_profile_dimensions(test_case)
+
+[profile, emp, cfg] = synthetic_inputs(2);
+profile.news_basis = profile.news_basis(1:end - 1, :);
+verifyError(test_case, ...
+    @() plot_model_irfs_pcpaths(profile, emp, cfg, ...
+    struct('Visible', 'off')), ...
+    'plot_model_irfs_pcpaths:DimensionMismatch');
+
+end
+
+function test_rejects_unknown_options(test_case)
+
+[profile, emp, cfg] = synthetic_inputs(1);
+verifyError(test_case, ...
+    @() plot_model_irfs_pcpaths(profile, emp, cfg, ...
+    struct('Visible', 'off', 'Unexpected', true)), ...
+    'plot_model_irfs_pcpaths:InvalidOptions');
+
+end
+
+function [profile, emp, cfg] = synthetic_inputs(K_pc)
+
+cfg = struct('H_path', 3, 'J_news', 3, 'K_pc', K_pc, ...
+    'L_pi', 4, 'L_y', 5);
+rng(19);
+emp = struct();
+emp.h_path = (0:(cfg.H_path - 1))';
+emp.V_path_model = randn(cfg.H_path, K_pc);
+emp.B_pi_emp = randn(cfg.L_pi, K_pc);
+emp.B_y_emp = randn(cfg.L_y, K_pc);
+
+profile = struct();
+profile.V_fit = emp.V_path_model;
+profile.news_basis = randn(cfg.J_news, K_pc);
+profile.Pi_pc_model = randn(cfg.L_pi, K_pc);
+profile.Y_pc_model = randn(cfg.L_y, K_pc);
+profile.rate_pc_full = randn(9, K_pc);
+profile.rate_diagnostics = struct( ...
+    'last_news_horizon', cfg.J_news - 1, ...
+    'measurement_support_horizons', (0:(cfg.H_path - 1))', ...
+    'last_measurement_rate_horizon', cfg.H_path - 1, ...
+    'measurement_tolerance', eps);
+profile.path_diagnostics = struct( ...
+    'singular_values', [2; 1; 0.4], ...
+    'rcond', 0.2);
+
+end
+
+function close_figures(figures)
+
+handles = struct2cell(figures);
+for i_handle = 1:numel(handles)
+    if isgraphics(handles{i_handle}, 'figure')
+        close(handles{i_handle});
+    end
+end
+
+end
