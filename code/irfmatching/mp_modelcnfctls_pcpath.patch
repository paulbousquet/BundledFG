+warning_options = f.options;
+warning_options.emit_warning = true;
+
+testCase.verifyWarning(@() map_paths_to_news( ...
+    R_ill, f.V, f.M_F, f.H, f.J, warning_options), warning_id);
+
+warning_state = warning('query', warning_id);
+cleanup = onCleanup(@() warning(warning_state.state, warning_id));
+warning('off', warning_id);
+[~, path_fit, diagnostics] = map_paths_to_news( ...
+    R_ill, f.V, f.M_F, f.H, f.J, warning_options);
+
+testCase.verifyTrue(diagnostics.is_ill_conditioned);
+testCase.verifyLessThan(diagnostics.rcond, f.options.rcond_warn);
+testCase.verifyGreaterThan(diagnostics.rcond, f.options.rcond_fail);
+testCase.verifyLessThanOrEqual(max(abs(path_fit(:) - f.V(:))), ...
+    scaled_tolerance(f.V));
