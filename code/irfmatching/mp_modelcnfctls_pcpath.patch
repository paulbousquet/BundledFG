+function result = get_posterior_mode_pcpaths(overrides)
+%GET_POSTERIOR_MODE_PCPATHS Estimate a DSGE model conditional on PC paths.
+%
+% RESULT = GET_POSTERIOR_MODE_PCPATHS() uses repository-relative defaults
+% and requires an exact empirical target file at
+% model_estim/_data/pc_targets.mat.
+%
+% RESULT = GET_POSTERIOR_MODE_PCPATHS(OVERRIDES) accepts a scalar struct.
+% Important fields are:
+%   repo_root, data_file, model, behavioral, load_hank, save_results,
+%   save_file, overwrite_results, allow_unverified_save, H_path, J_news,
+%   K_pc, L_pi, L_y, T_model, M_F,
+%   allow_identity_M_F, map_options, optimizer_options, x0,
+%   lower_bound, and upper_bound.
+%
+% The empirical loader must either obtain the contract measurement matrix
+% from the target data, receive OVERRIDES.M_F, or be given the explicit
+% opt-in OVERRIDES.allow_identity_M_F=true. Results are written only when
+% OVERRIDES.save_results is true.
+%
+% This driver reuses the repository's global sequence-space calibration.
+% Calls therefore reinitialize global T and the legacy calibration, prior,
+% and (for HANK) household-Jacobian state.
+
+if nargin < 1 || isempty(overrides)
+    overrides = struct();
+end
+
+repo_root_default = fileparts(fileparts(mfilename('fullpath')));
+options = normalize_options(overrides, repo_root_default);
+cfg = build_config(options);
+validate_save_request(options);
+
+if ~isfile(options.data_file)
+    error('get_posterior_mode_pcpaths:EmpiricalDataNotFound', ...
+        ['Empirical PC-path targets were not found at:\n  %s\n' ...
+         'Supply options.data_file pointing to the exact PCA loadings, ' ...
+         'macro LP coefficients, covariance matrix, and scaling metadata.'], ...
+        options.data_file);
+end
+
+auxiliary_dir = fullfile(options.repo_root, '_auxiliary_functions');
+if ~isfolder(auxiliary_dir)
+    error('get_posterior_mode_pcpaths:InvalidRepositoryRoot', ...
+        'The auxiliary-function directory does not exist: %s', auxiliary_dir);
+end
+
+original_matlab_path = path;
+path_cleanup = onCleanup(@() restore_matlab_path(original_matlab_path));
+addpath(auxiliary_dir);
+
+emp = get_empirical_pc_targets(options.data_file, cfg);
+
+global T %#ok<GVMIS>
+T = cfg.T_model;
+[m_d_mean, m_f_mean] = initialize_legacy_model( ...
+    options.repo_root, options.model, options.load_hank);
+
+[legacy_x0, legacy_lower_bound, legacy_upper_bound] = ...
+    legacy_start_and_bounds(options.model, options.behavioral, ...
+    m_d_mean, m_f_mean);
+[x0, lower_bound, upper_bound] = apply_bound_overrides( ...
+    options, legacy_x0, legacy_lower_bound, legacy_upper_bound);
+
+objective = @(param) solve_model_pcpaths( ...
+    param, emp, cfg, options.model);
+[param_sol, posterior_mode, exit_flag, optimizer_output] = ...
+    fminsearchcon(objective, x0, lower_bound, upper_bound, ...
+    [], [], [], options.optimizer_options);
+
+[objective_at_mode, final_profile] = solve_model_pcpaths( ...
+    param_sol, emp, cfg, options.model);
+
+converged = isfinite(exit_flag) && exit_flag > 0;
+admissible = isfinite(objective_at_mode) && ...
+    isstruct(final_profile) && isscalar(final_profile) && ...
+    isfield(final_profile, 'admissible') && final_profile.admissible;
+verified = converged && admissible;
+if ~converged
+    warning('get_posterior_mode_pcpaths:OptimizerDidNotConverge', ...
+        ['The optimizer returned exit_flag=%g. The candidate is returned ' ...
+         'for diagnosis but is not marked as a verified posterior mode.'], ...
+        exit_flag);
+end
+if ~admissible
+    warning('get_posterior_mode_pcpaths:InadmissibleOptimum', ...
+        ['The optimizer candidate has a nonfinite objective or an ' ...
+         'inadmissible policy-path map.']);
+end
+
+result = struct();
+result.repo_root = options.repo_root;
+result.data_file = options.data_file;
+result.model = options.model;
+result.behavioral = options.behavioral;
+result.load_hank = options.load_hank;
+result.cfg = cfg;
+result.emp = emp;
+result.start = struct( ...
+    'x0', x0, ...
+    'lower_bound', lower_bound, ...
+    'upper_bound', upper_bound);
+result.optimum = struct( ...
+    'param', param_sol, ...
+    'objective', posterior_mode, ...
+    'objective_recomputed', objective_at_mode);
+result.exit_flag = exit_flag;
+result.optimizer_status = exit_flag;
+result.optimizer_output = optimizer_output;
+result.final_profile = final_profile;
+result.converged = converged;
+result.admissible = admissible;
+result.verified = verified;
+result.status = mode_status(converged, admissible);
+result.options = options;
+
+if options.save_results
+    if ~verified && ~options.allow_unverified_save
+        warning('get_posterior_mode_pcpaths:UnverifiedResultNotSaved', ...
+            ['save_results was requested, but the candidate is not both ' ...
+             'converged and admissible. Set allow_unverified_save=true ' ...
+             'only to save it explicitly for diagnosis.']);
+        result.saved_file = '';
+        result.save_status = 'skipped_unverified';
+    else
+        if isfile(options.save_file) && ~options.overwrite_results
+            error('get_posterior_mode_pcpaths:ResultsFileExists', ...
+                ['Refusing to overwrite existing results file: %s. Set ' ...
+                 'overwrite_results=true to replace it explicitly.'], ...
+                options.save_file);
+        end
+        result.saved_file = options.save_file;
+        result.save_status = 'saved';
+        save_result_atomically(options.save_file, result, ...
+            options.overwrite_results);
+    end
+else
+    result.saved_file = '';
+    result.save_status = 'not_requested';
+end
+
+end
+
+function options = normalize_options(overrides, repo_root_default)
+
+if ~isstruct(overrides) || ~isscalar(overrides)
+    error('get_posterior_mode_pcpaths:InvalidOptions', ...
+        'The options override must be a scalar struct.');
+end
+
+defaults = struct();
+defaults.repo_root = repo_root_default;
+defaults.data_file = '';
+defaults.model = '/rank';
+defaults.behavioral = true;
+defaults.load_hank = true;
+defaults.save_results = false;
+defaults.save_file = '';
+defaults.overwrite_results = false;
+defaults.allow_unverified_save = false;
+defaults.H_path = 8;
+defaults.J_news = 8;
+defaults.K_pc = 2;
+defaults.L_pi = 25;
+defaults.L_y = 25;
+defaults.T_model = 300;
+defaults.M_F = [];
+defaults.allow_identity_M_F = false;
+defaults.map_options = struct();
+defaults.optimizer_options = [];
+defaults.x0 = [];
+defaults.lower_bound = [];
+defaults.upper_bound = [];
+
+options = defaults;
+override_names = fieldnames(overrides);
+for i_option = 1:numel(override_names)
+    option_name = override_names{i_option};
+    if ~isfield(defaults, option_name)
+        error('get_posterior_mode_pcpaths:UnknownOption', ...
+            'Unknown option field ''%s''.', option_name);
+    end
+    options.(option_name) = overrides.(option_name);
+end
+
+options.repo_root = canonicalize_path(validate_text( ...
+    options.repo_root, 'repo_root', false), pwd, 'repo_root');
+if ~isfolder(options.repo_root)
+    error('get_posterior_mode_pcpaths:InvalidRepositoryRoot', ...
+        'options.repo_root is not an existing directory: %s', ...
+        options.repo_root);
+end
+
+if isempty(options.data_file)
+    options.data_file = fullfile( ...
+        options.repo_root, 'model_estim', '_data', 'pc_targets.mat');
+else
+    options.data_file = validate_text( ...
+        options.data_file, 'data_file', false);
+end
+options.data_file = canonicalize_path( ...
+    options.data_file, options.repo_root, 'data_file');
+
+options.model = validate_text(options.model, 'model', false);
+if ~ismember(options.model, {'/rank', '/hank'})
+    error('get_posterior_mode_pcpaths:InvalidModel', ...
+        'options.model must be either ''/rank'' or ''/hank''.');
+end
+
+options.behavioral = validate_logical_scalar( ...
+    options.behavioral, 'behavioral');
+options.load_hank = validate_logical_scalar( ...
+    options.load_hank, 'load_hank');
+options.save_results = validate_logical_scalar( ...
+    options.save_results, 'save_results');
+options.overwrite_results = validate_logical_scalar( ...
+    options.overwrite_results, 'overwrite_results');
+options.allow_unverified_save = validate_logical_scalar( ...
+    options.allow_unverified_save, 'allow_unverified_save');
+options.allow_identity_M_F = validate_logical_scalar( ...
+    options.allow_identity_M_F, 'allow_identity_M_F');
+
+dimension_names = {'H_path', 'J_news', 'K_pc', ...
+    'L_pi', 'L_y', 'T_model'};
+for i_dimension = 1:numel(dimension_names)
+    dimension_name = dimension_names{i_dimension};
+    options.(dimension_name) = validate_positive_integer( ...
+        options.(dimension_name), dimension_name);
+end
+if options.H_path ~= options.J_news
+    error('get_posterior_mode_pcpaths:NonSquarePathSystem', ...
+        ['The exact first-slice driver requires H_path == J_news; ' ...
+         'received H_path=%d and J_news=%d.'], ...
+        options.H_path, options.J_news);
+end
+if ~ismember(options.K_pc, [1, 2])
+    error('get_posterior_mode_pcpaths:InvalidFactorCount', ...
+        'K_pc must be one or two; received %d.', options.K_pc);
+end
+if options.T_model < max([options.H_path, options.J_news, ...
+        options.L_pi, options.L_y])
+    error('get_posterior_mode_pcpaths:InvalidModelHorizon', ...
+        ['T_model must be at least H_path, J_news, L_pi, and L_y. ' ...
+         'Received T_model=%d.'], options.T_model);
+end
+
+if ~isempty(options.M_F)
+    if ~isnumeric(options.M_F) || ~isfloat(options.M_F) || ...
+            ~isreal(options.M_F) || ...
+            ~isequal(size(options.M_F), ...
+            [options.H_path, options.T_model]) || ...
+            any(~isfinite(options.M_F(:)))
+        error('get_posterior_mode_pcpaths:InvalidMeasurementMatrix', ...
+            'M_F must be a finite H_path-by-T_model floating-point matrix.');
+    end
+end
+if ~isstruct(options.map_options) || ~isscalar(options.map_options)
+    error('get_posterior_mode_pcpaths:InvalidOptions', ...
+        'map_options must be a scalar struct.');
+end
+
+default_optimizer_options = optimset( ...
+    'Display', 'iter', ...
+    'MaxFunEvals', 1000, ...
+    'TolFun', 1e-4, ...
+    'TolX', 1e-4);
+if isempty(options.optimizer_options)
+    options.optimizer_options = default_optimizer_options;
+elseif ~isstruct(options.optimizer_options) || ...
+        ~isscalar(options.optimizer_options)
+    error('get_posterior_mode_pcpaths:InvalidOptimizerOptions', ...
+        'optimizer_options must be a scalar options struct.');
+else
+    options.optimizer_options = optimset( ...
+        default_optimizer_options, options.optimizer_options);
+end
+
+if isempty(options.save_file)
+    model_label = options.model(2:end);
+    if options.behavioral
+        expectation_label = 'behavioral';
+    else
+        expectation_label = 'rational';
+    end
+    options.save_file = fullfile(options.repo_root, 'model_estim', ...
+        '_results', sprintf('posterior_mode_pcpaths_%s_%s.mat', ...
+        model_label, expectation_label));
+else
+    options.save_file = validate_text( ...
+        options.save_file, 'save_file', false);
+end
+options.save_file = canonicalize_path( ...
+    options.save_file, options.repo_root, 'save_file');
+
+end
+
+function validate_save_request(options)
+
+if ~options.save_results
+    return
+end
+
+if paths_equal(options.save_file, options.data_file)
+    error('get_posterior_mode_pcpaths:ResultsAliasInput', ...
+        'The results file must not overwrite the empirical target file.');
+end
+if isfolder(options.save_file)
+    error('get_posterior_mode_pcpaths:InvalidResultsPath', ...
+        'The results path names an existing directory: %s', ...
+        options.save_file);
+end
+
+save_parent = fileparts(options.save_file);
+if ~isempty(save_parent) && ~isfolder(save_parent)
+    error('get_posterior_mode_pcpaths:MissingResultsDirectory', ...
+        ['The requested results directory does not exist: %s. Create it ' ...
+         'or provide options.save_file in an existing directory.'], ...
+        save_parent);
+end
+if isfile(options.save_file) && ~options.overwrite_results
+    error('get_posterior_mode_pcpaths:ResultsFileExists', ...
+        ['Refusing to overwrite existing results file: %s. Set ' ...
+         'overwrite_results=true to replace it explicitly.'], ...
+        options.save_file);
+end
+
+end
+
+function cfg = build_config(options)
+
+cfg = struct();
+cfg.H_path = options.H_path;
+cfg.J_news = options.J_news;
+cfg.K_pc = options.K_pc;
+cfg.L_pi = options.L_pi;
+cfg.L_y = options.L_y;
+cfg.T_model = options.T_model;
+cfg.allow_identity_M_F = options.allow_identity_M_F;
+cfg.map_options = options.map_options;
+if ~isempty(options.M_F)
+    cfg.M_F = options.M_F;
+end
+
+end
+
+function [m_d_mean, m_f_mean] = initialize_legacy_model( ...
+    repo_root, model_name, load_hank_option)
+
+% These names are required by the legacy setup scripts because scripts run
+% in this function workspace.
+path = repo_root; %#ok<NASGU>
+vintage = ''; %#ok<NASGU>
+model = model_name; %#ok<NASGU>
+load_hank = double(load_hank_option); %#ok<NASGU>
+m_d_mean = NaN;
+m_f_mean = NaN;
+
+global T %#ok<GVMIS,NUSED>
+warning_id = 'MATLAB:dispatcher:nameConflict';
+warning_state = warning('query', warning_id);
+warning_cleanup = onCleanup(@() restore_warning_state( ...
+    warning_state, warning_id));
+auxiliary_dir = fullfile(repo_root, '_auxiliary_functions');
+run(fullfile(auxiliary_dir, 'get_calibration_general.m'));
+
+% The legacy HANK builder changes folders internally. Running that script
+% by absolute path gives MATLAB's RUN cleanup ownership of the folder and
+% prevents the function driver from leaving the caller elsewhere.
+if strcmp(model_name, '/hank') && ~load_hank_option
+    hank_builder = fullfile(auxiliary_dir, '_hank_inputs', ...
+        'get_hank_inputs_2.m');
+    run(hank_builder);
+    load_hank = 1; %#ok<NASGU>
+end
+run(fullfile(auxiliary_dir, 'get_baseline_jacobians.m'));
+run(fullfile(auxiliary_dir, 'get_priors_general.m'));
+
+if ~isfinite(m_d_mean) || ~isfinite(m_f_mean)
+    error('get_posterior_mode_pcpaths:PriorInitializationFailed', ...
+        'The legacy prior script did not initialize behavioral prior means.');
+end
+
+end
+
+function status = mode_status(converged, admissible)
+
+if converged && admissible
+    status = 'converged_admissible';
+elseif converged
+    status = 'converged_inadmissible';
+elseif admissible
+    status = 'not_converged_admissible';
+else
+    status = 'not_converged_inadmissible';
+end
+
+end
+
+function [x0, lower_bound, upper_bound] = legacy_start_and_bounds( ...
+    model, behavioral, m_d_mean, m_f_mean)
+
+if behavioral
+    if strcmp(model, '/rank')
+        x0 = [0.71, 0.86, 0.99999, 0.946, 0.99999, ...
+            5.3, 0.47, m_d_mean, m_f_mean];
+    else
+        x0 = [0.9598, 0.85, 0.99999, 0.95, 0.99999, ...
+            5.3219, 0.47, m_d_mean, m_f_mean];
+    end
+    n_param = 9;
+else
+    if strcmp(model, '/rank')
+        x0 = [0.73, 0.85, 0.99999, 0.74, 0.99999, 5.3, 0.47];
+    else
+        x0 = [0.9654, 0.9530, 0.999999, 0.8763, ...
+            0.999999, 5.7686, 0.4618];
+    end
+    n_param = 7;
+end
+
+[lower_bound, upper_bound] = get_pcpath_parameter_bounds(n_param);
+lower_bound = lower_bound.';
+upper_bound = upper_bound.';
+
+end
+
+function [x0, lower_bound, upper_bound] = apply_bound_overrides( ...
+    options, legacy_x0, legacy_lower_bound, legacy_upper_bound)
+
+if isempty(options.x0)
+    x0 = legacy_x0;
+else
+    x0 = validate_parameter_vector(options.x0, numel(legacy_x0), ...
+        'x0', true);
+end
+if isempty(options.lower_bound)
+    lower_bound = legacy_lower_bound;
+else
+    lower_bound = validate_parameter_vector(options.lower_bound, ...
+        numel(legacy_x0), 'lower_bound', false);
+end
+if isempty(options.upper_bound)
+    upper_bound = legacy_upper_bound;
+else
+    upper_bound = validate_parameter_vector(options.upper_bound, ...
+        numel(legacy_x0), 'upper_bound', false);
+end
+
+if any(lower_bound > upper_bound)
+    error('get_posterior_mode_pcpaths:InvalidBounds', ...
+        'Each lower bound must be less than or equal to its upper bound.');
+end
+if any(x0 < lower_bound) || any(x0 > upper_bound)
+    error('get_posterior_mode_pcpaths:InvalidStartingPoint', ...
+        'x0 must lie inside the supplied parameter bounds.');
+end
+
+end
+
+function value = validate_parameter_vector( ...
+    value, expected_length, name, require_finite)
+
+if ~isnumeric(value) || ~isfloat(value) || ~isreal(value) || ...
+        ~isvector(value) || numel(value) ~= expected_length || ...
+        any(isnan(value))
+    error('get_posterior_mode_pcpaths:InvalidParameterOptions', ...
+        '%s must be a real floating-point vector of length %d.', ...
+        name, expected_length);
+end
+if require_finite && any(~isfinite(value))
+    error('get_posterior_mode_pcpaths:InvalidParameterOptions', ...
+        '%s must contain only finite values.', name);
+end
+value = value(:).';
+
+end
+
+function value = validate_positive_integer(value, name)
+
+if ~isnumeric(value) || ~isreal(value) || ~isscalar(value) || ...
+        ~isfinite(value) || value <= 0 || value ~= fix(value)
+    error('get_posterior_mode_pcpaths:InvalidDimension', ...
+        '%s must be a finite positive integer scalar.', name);
+end
+
+end
+
+function value = validate_logical_scalar(value, name)
+
+is_binary_numeric = isnumeric(value) && isreal(value) && ...
+    isscalar(value) && isfinite(value) && (value == 0 || value == 1);
+if ~(islogical(value) && isscalar(value)) && ~is_binary_numeric
+    error('get_posterior_mode_pcpaths:InvalidOptions', ...
+        '%s must be a scalar logical or numeric zero/one.', name);
+end
+value = logical(value);
+
+end
+
+function value = validate_text(value, name, allow_empty)
+
+if isstring(value) && isscalar(value)
+    value = char(value);
+end
+if ~ischar(value) || ~isrow(value) || (~allow_empty && isempty(value))
+    error('get_posterior_mode_pcpaths:InvalidOptions', ...
+        '%s must be a nonempty character vector or string scalar.', name);
+end
+
+end
+
+function restore_matlab_path(original_matlab_path)
+
+path(original_matlab_path);
+
+end
+
+function restore_warning_state(warning_state, warning_id)
+
+warning(warning_state.state, warning_id);
+
+end
+
+function absolute_path = canonicalize_path( ...
+    path_value, base_directory, name)
+
+try
+    candidate = javaObject('java.io.File', path_value);
+    if ~candidate.isAbsolute()
+        candidate = javaObject( ...
+            'java.io.File', base_directory, path_value);
+    end
+    absolute_path = char(candidate.getCanonicalPath());
+catch canonical_error
+    error('get_posterior_mode_pcpaths:InvalidPath', ...
+        'Could not canonicalize %s path ''%s'': %s', ...
+        name, path_value, canonical_error.message);
+end
+if isempty(absolute_path) || ~isrow(absolute_path)
+    error('get_posterior_mode_pcpaths:InvalidPath', ...
+        'Canonicalizing %s did not produce a nonempty path.', name);
+end
+
+end
+
+function equal = paths_equal(first_path, second_path)
+
+if ispc
+    equal = strcmpi(first_path, second_path);
+else
+    equal = strcmp(first_path, second_path);
+end
+
+end
+
+function save_result_atomically(save_file, result, overwrite_results)
+
+save_parent = fileparts(save_file);
+if ~isfolder(save_parent) || isfolder(save_file)
+    error('get_posterior_mode_pcpaths:InvalidResultsPath', ...
+        'The results path must name a file in an existing directory.');
+end
+temporary_file = canonicalize_path( ...
+    [tempname(save_parent), '.mat'], save_parent, ...
+    'temporary results file');
+if ~paths_equal(fileparts(temporary_file), save_parent) || ...
+        paths_equal(temporary_file, save_file) || isfile(temporary_file)
+    error('get_posterior_mode_pcpaths:UnsafeTemporaryResultsPath', ...
+        'Could not establish a unique temporary results file.');
+end
+temporary_cleanup = onCleanup(@() delete_temporary_result( ...
+    temporary_file, save_parent));
+save(temporary_file, 'result', '-v7.3');
+
+move_completed_result(temporary_file, save_file, overwrite_results);
+clear temporary_cleanup
+
+end
+
+function move_completed_result(source_file, target_file, overwrite_results)
+
+empty_strings = javaArray('java.lang.String', 0);
+source_path = javaMethod( ...
+    'get', 'java.nio.file.Paths', source_file, empty_strings);
+target_path = javaMethod( ...
+    'get', 'java.nio.file.Paths', target_file, empty_strings);
+if overwrite_results
+    copy_options = javaArray('java.nio.file.CopyOption', 1);
+    copy_options(1) = ...
+        java.nio.file.StandardCopyOption.REPLACE_EXISTING;
+else
+    copy_options = javaArray('java.nio.file.CopyOption', 0);
+end
+
+try
+    javaMethod('move', 'java.nio.file.Files', ...
+        source_path, target_path, copy_options);
+catch move_error
+    if ~overwrite_results && isfile(target_file)
+        error('get_posterior_mode_pcpaths:ResultsFileExists', ...
+            ['A results file appeared before the completed temporary ' ...
+             'file could be installed: %s'], target_file);
+    end
+    contextual_error = MException( ...
+        'get_posterior_mode_pcpaths:SaveFailed', ...
+        'Could not install the completed results file.');
+    contextual_error = addCause(contextual_error, move_error);
+    throw(contextual_error);
+end
+
+end
+
+function delete_temporary_result(temporary_file, expected_parent)
+
+if ~isfile(temporary_file)
+    return
+end
+if ~paths_equal(fileparts(temporary_file), expected_parent)
+    warning('get_posterior_mode_pcpaths:TemporaryCleanupRefused', ...
+        'Refusing to delete a temporary file outside the validated directory.');
+    return
+end
+delete(temporary_file);
+
+end
diff --git a/model_estim/make_h3_pc_heldout_figure.m b/model_estim/make_h3_pc_heldout_figure.m
new file mode 100644
index 0000000..18c39d0
--- /dev/null
+++ b/model_estim/make_h3_pc_heldout_figure.m
@@ -0,0 +1,100 @@
+function make_h3_pc_heldout_figure(result, filename)
+%MAKE_H3_PC_HELDOUT_FIGURE Plot errors for the orthogonal policy path.
+
+figure_handle = figure('Visible', 'off', 'Color', 'w', ...
+    'Position', [100, 100, 1100, 700]);
+cleanup = onCleanup(@() close(figure_handle));
+n_macro = result.cfg.L_pi + result.cfg.L_y;
+subplot(1, 2, 1);
+truth_handle = yline(0, 'k--', 'LineWidth', 1.2);
+hold on;
+[h3_handle, pc_handle] = plot_dispersion(result, 1:result.cfg.L_pi);
+hold off;
+grid on;
+xlabel('Horizon');
+ylabel('Deviation from true inflation response');
+title('Held-out path error: inflation');
+legend([truth_handle, h3_handle, pc_handle], ...
+    {'Truth', 'H=3-equivalent fits', 'Two-PC-equivalent fits'}, ...
+    'Location', 'best');
+subplot(1, 2, 2);
+truth_handle = yline(0, 'k--', 'LineWidth', 1.2);
+hold on;
+[h3_handle, pc_handle] = plot_dispersion( ...
+    result, (result.cfg.L_pi + 1):n_macro);
+hold off;
+grid on;
+xlabel('Horizon');
+ylabel('Deviation from true output response');
+title('Held-out path error: output');
+legend([truth_handle, h3_handle, pc_handle], ...
+    {'Truth', 'H=3-equivalent fits', 'Two-PC-equivalent fits'}, ...
+    'Location', 'best');
+exportgraphics(figure_handle, filename, 'Resolution', 220);
+
+end
+
+function [h3_handle, pc_handle] = plot_dispersion(result, row_indices)
+
+selected_h3 = select_equivalent( ...
+    result.multistart_h3, result.multistart_loss_threshold);
+if isempty(selected_h3)
+    [~, selected_h3] = mink(result.loss_profile.loss_h3, ...
+        min(8, numel(result.loss_profile.loss_h3)));
+    h3_parameters = result.loss_profile.parameters(selected_h3, :);
+else
+    h3_parameters = result.multistart_h3.solutions(selected_h3, :);
+end
+for i_selected = 1:size(h3_parameters, 1)
+    moments = evaluate_from_result(h3_parameters(i_selected, :), result);
+    plot_deviation(moments, result, row_indices, [0.30, 0.58, 0.88]);
+end
+
+selected_pc = select_equivalent( ...
+    result.multistart_pc, result.multistart_loss_threshold);
+for i_selected = 1:numel(selected_pc)
+    moments = evaluate_from_result( ...
+        result.multistart_pc.solutions(selected_pc(i_selected), :), result);
+    plot_deviation(moments, result, row_indices, [0.90, 0.42, 0.15]);
+end
+% Stable legend handles independent of the number and ordering of traces.
+h3_handle = plot(NaN, NaN, '-', 'Color', [0.30, 0.58, 0.88], ...
+    'LineWidth', 1.5);
+pc_handle = plot(NaN, NaN, '-', 'Color', [0.90, 0.42, 0.15], ...
+    'LineWidth', 1.5);
+
+end
+
+function plot_deviation(moments, result, row_indices, color)
+
+plot((0:(numel(row_indices) - 1))', ...
+    moments.B_perp(row_indices) - result.truth.B_perp(row_indices), ...
+    'Color', color, 'LineWidth', 0.8);
+
+end
+
+function moments = evaluate_from_result(param, result)
+
+n_macro = result.cfg.L_pi + result.cfg.L_y;
+emp_two = struct( ...
+    'V_path_model', result.design.V_path_model, ...
+    'target_pc', zeros(n_macro * result.cfg.K_pc, 1), ...
+    'Sigma_B_inv', eye(n_macro * result.cfg.K_pc), ...
+    'M_F', result.design.M_F);
+moments = evaluate_h3_and_pc_moments(param, emp_two, result.cfg, ...
+    result.model, result.scalar_direction);
+
+end
+
+function selected = select_equivalent(multistart, threshold)
+
+if isempty(multistart.loss)
+    selected = zeros(0, 1);
+    return
+end
+selected = find(isfinite(multistart.loss) & multistart.loss <= threshold);
+if numel(selected) > 20
+    selected = selected(1:20);
+end
+
+end
diff --git a/model_estim/plot_model_irfs_pcpaths.m b/model_estim/plot_model_irfs_pcpaths.m
