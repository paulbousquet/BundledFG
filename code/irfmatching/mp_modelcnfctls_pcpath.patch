+function demo = demo_pcpath_method_synthetic(options)
+%DEMO_PCPATH_METHOD_SYNTHETIC Illustrate PC-path profiling without real B.
+%
+% DEMO = DEMO_PCPATH_METHOD_SYNTHETIC() constructs synthetic rate-path and
+% macro targets at a known scalar propagation parameter. For every trial
+% parameter, current/news wedges are recomputed from the rate block alone;
+% only then are macro responses compared. This is a teaching and regression
+% example, not an empirical estimate. It deliberately does not fabricate a
+% production B matrix, covariance, or contract measurement operator.
+%
+% OPTIONS.MakePlot (default false) creates a loss-profile figure.
+
+if nargin < 1 || isempty(options)
+    options = struct();
+end
+options = normalize_options(options);
+
+model_estim_dir = fileparts(mfilename('fullpath'));
+repo_root = fileparts(model_estim_dir);
+auxiliary_dir = fullfile(repo_root, '_auxiliary_functions');
+original_path = path;
+path_cleanup = onCleanup(@() path(original_path));
+addpath(auxiliary_dir);
+
+cfg = struct( ...
+    'H_path', 4, ...
+    'J_news', 4, ...
+    'K_pc', 2, ...
+    'L_pi', 6, ...
+    'L_y', 6, ...
+    'T_model', 12, ...
+    'allow_identity_M_F', false, ...
+    'map_options', struct( ...
+        'rcond_fail', 1e-12, ...
+        'rcond_warn', 1e-8, ...
+        'path_tol_abs', 1e-12, ...
+        'path_tol_rel', 1e-10, ...
+        'emit_warning', false));
+
+M_F = zeros(cfg.H_path, cfg.T_model);
+M_F(1, 1) = 1;
+M_F(2, 2:3) = [0.7, 0.3];
+M_F(3, 3:4) = [0.6, 0.4];
+M_F(4, 4:6) = [0.5, 0.3, 0.2];
+
+psi_true = 0.65;
+news_basis_true = [1.00, 0.20; -0.30, 0.80; ...
+                   0.15, -0.10; 0.05, 0.25];
+[Pi_true, Y_true, R_true] = synthetic_irfs(psi_true, cfg.T_model);
+V_path_model = M_F * R_true(:, 1:cfg.J_news) * news_basis_true;
+B_pi_emp = Pi_true(1:cfg.L_pi, 1:cfg.J_news) * news_basis_true;
+B_y_emp = Y_true(1:cfg.L_y, 1:cfg.J_news) * news_basis_true;
+n_target = (cfg.L_pi + cfg.L_y) * cfg.K_pc;
+target_standard_errors = linspace(0.04, 0.08, n_target)';
+
+source = struct();
+source.V_path_model = V_path_model;
+source.B_pi_emp = B_pi_emp;
+source.B_y_emp = B_y_emp;
+source.Sigma_B = diag(target_standard_errors.^2);
+source.M_F = M_F;
+source.h_path = (0:(cfg.H_path - 1))';
+source.metadata = synthetic_metadata();
+emp = get_empirical_pc_targets(source, cfg);
+
+psi_grid = linspace(0.20, 1.10, 91)';
+loss_grid = NaN(size(psi_grid));
+for i_grid = 1:numel(psi_grid)
+    [Pi_trial, Y_trial, R_trial] = ...
+        synthetic_irfs(psi_grid(i_grid), cfg.T_model);
+    loss_grid(i_grid) = profile_pcpath_irfs( ...
+        Pi_trial, Y_trial, R_trial, emp, cfg);
+end
+[minimum_loss, minimum_index] = min(loss_grid);
+psi_hat_grid = psi_grid(minimum_index);
+[~, true_profile] = profile_pcpath_irfs( ...
+    Pi_true, Y_true, R_true, emp, cfg);
+
+figure_handle = [];
+if options.MakePlot
+    figure_handle = figure('Color', 'w', ...
+        'Name', 'Synthetic PC-path method demonstration');
+    plot(psi_grid, loss_grid, 'LineWidth', 1.6);
+    hold on;
+    xline(psi_true, '--k', 'Synthetic truth');
+    hold off;
+    grid on;
+    xlabel('Trial propagation parameter \psi');
+    ylabel('Macro-only minimum-distance loss');
+    title('Rate-path inversion is recomputed at every trial parameter');
+end
+
+demo = struct();
+demo.description = ...
+    'Synthetic method demonstration only; not an empirical estimate.';
+demo.synthetic_only = true;
+demo.production_ready = false;
+demo.psi_true = psi_true;
+demo.psi_grid = psi_grid;
+demo.loss_grid = loss_grid;
+demo.psi_hat_grid = psi_hat_grid;
+demo.minimum_loss = minimum_loss;
+demo.true_profile = true_profile;
+demo.news_basis_true = news_basis_true;
+demo.max_abs_path_error = ...
+    true_profile.path_diagnostics.max_abs_path_error;
+demo.max_abs_macro_residual = max(abs(true_profile.resid));
+demo.emp = emp;
+demo.cfg = cfg;
+demo.figure = figure_handle;
+demo.missing_production_inputs = { ...
+    'estimated B_pi_emp and B_y_emp', ...
+    'joint sampling covariance Sigma_B', ...
+    'empirical model-unit PC rate paths V_path_model', ...
+    'contract/calendar-consistent measurement matrix M_F'};
+
+if nargout == 0
+    fprintf(['Synthetic PC-path demo: true psi=%g, grid minimizer=%g, ' ...
+        'minimum loss=%g, max path error=%g.\n'], ...
+        psi_true, psi_hat_grid, minimum_loss, ...
+        demo.max_abs_path_error);
+    clear demo
+end
+
+end
+
+function [Pi_irf, Y_irf, R_irf] = synthetic_irfs(psi, T_model)
+
+Pi_irf = zeros(T_model);
+Y_irf = zeros(T_model);
+R_irf = zeros(T_model);
+for shock_index = 1:T_model
+    for response_index = shock_index:T_model
+        horizon = response_index - shock_index;
+        R_irf(response_index, shock_index) = ...
+            (1 + 0.12 * psi) * 0.78^horizon;
+        Pi_irf(response_index, shock_index) = ...
+            (0.08 + 0.22 * psi) * 0.72^horizon;
+        Y_irf(response_index, shock_index) = ...
+            -(0.30 - 0.12 * psi + 0.08 * psi^2) * 0.66^horizon;
+    end
+end
+
+end
+
+function metadata = synthetic_metadata()
+
+metadata = struct( ...
+    'schema_version', 'pcpaths-v1', ...
+    'source_provenance', 'deterministic synthetic teaching example', ...
+    'pca_reconstruction', 'synthetic two-column path basis', ...
+    'score_normalization', 'fixed synthetic normalization', ...
+    'rate_unit_conversion', 'already in arbitrary model units', ...
+    'contract_measurement', 'synthetic overlapping rate averages', ...
+    'target_order', 'pc-major:[inflation;output]', ...
+    'covariance_provenance', 'diagonal synthetic illustration weights');
+
+end
+
+function options = normalize_options(options)
+
+if ~isstruct(options) || ~isscalar(options)
+    error('demo_pcpath_method_synthetic:InvalidOptions', ...
+        'options must be a scalar struct.');
+end
+allowed = {'MakePlot'};
+unknown = setdiff(fieldnames(options), allowed);
+if ~isempty(unknown)
+    error('demo_pcpath_method_synthetic:InvalidOptions', ...
+        'Unknown option ''%s''.', unknown{1});
+end
+if ~isfield(options, 'MakePlot') || isempty(options.MakePlot)
+    options.MakePlot = false;
+end
+is_binary = isnumeric(options.MakePlot) && isreal(options.MakePlot) && ...
+    isscalar(options.MakePlot) && isfinite(options.MakePlot) && ...
+    (options.MakePlot == 0 || options.MakePlot == 1);
+if ~(islogical(options.MakePlot) && isscalar(options.MakePlot)) && ...
+        ~is_binary
+    error('demo_pcpath_method_synthetic:InvalidOptions', ...
+        'options.MakePlot must be a scalar logical or zero/one.');
+end
+options.MakePlot = logical(options.MakePlot);
+
+end
