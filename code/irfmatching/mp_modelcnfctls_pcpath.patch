+function validate_temporary_directory(directory)
+
+temporary_root = tempdir;
+is_safe = ischar(directory) && isrow(directory) && ...
+    isfolder(directory) && ...
+    startsWith(directory, temporary_root, 'IgnoreCase', true) && ...
