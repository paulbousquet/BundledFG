+Pi_changed(:,1:f.cfg.J_news) = ...
+    1.7 * Pi_changed(:,1:f.cfg.J_news) + 0.13;
+Y_changed(:,1:f.cfg.J_news) = ...
+    -0.8 * Y_changed(:,1:f.cfg.J_news) - 0.07;
+[loss_changed, out_changed] = profile_pcpath_irfs( ...
