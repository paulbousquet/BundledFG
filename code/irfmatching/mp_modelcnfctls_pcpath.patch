+function snapshot = take_global_snapshot()
+
+names = model_global_names();
+values = cell(size(names));
+for i_name = 1:numel(names)
+    name = names{i_name};
+    eval(['global ' name]);
+    values{i_name} = eval(name);
+end
+snapshot = struct('names', {names}, 'values', {values});
+
+end
+
+function restore_global_snapshot(snapshot)
+
+for i_name = 1:numel(snapshot.names)
+    name = snapshot.names{i_name};
+    value = snapshot.values{i_name};
+    if isempty(value)
+        eval(['clear global ' name]); %#ok<EVLDUAL>
+    else
+        eval(['global ' name]);
+        eval([name ' = value;']);
+    end
+end
+
+end
+
+function verify_global_snapshot(testCase, snapshot)
+
+for i_name = 1:numel(snapshot.names)
+    name = snapshot.names{i_name};
+    eval(['global ' name]);
+    actual = eval(name);
+    testCase.verifyEqual(actual, snapshot.values{i_name}, ...
+        sprintf('Global %s was not restored.', name));
+end
+
+end
