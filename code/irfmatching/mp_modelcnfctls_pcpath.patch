+function result = save_outputs(result, figure_handle, options)
+
+output_directory = options.OutputDirectory;
+if isempty(output_directory)
+    error('demo_pcpath_rank7_synthetic:MissingOutputDirectory', ...
+        'OutputDirectory is required when SaveOutputs=true.');
+end
+if ~isfolder(output_directory)
+    mkdir(output_directory);
+end
+
+if result.empirical_v_used
+    file_prefix = 'pc_path_empirical_v_dgp';
+else
+    file_prefix = 'pc_path_rank7_demonstration';
+end
+figure_file = fullfile(output_directory, [file_prefix '.png']);
+report_file = fullfile(output_directory, [file_prefix '_results.md']);
+parameter_csv = fullfile(output_directory, ...
+    [file_prefix '_parameter_recovery.csv']);
+mat_file = fullfile(output_directory, [file_prefix '_results.mat']);
+if result.empirical_v_used
+    v_csv = fullfile(output_directory, [file_prefix '_V.csv']);
+    files = {figure_file, report_file, parameter_csv, mat_file, v_csv};
+else
+    v_csv = '';
+    files = {figure_file, report_file, parameter_csv, mat_file};
+end
+if ~options.Overwrite && any(cellfun(@isfile, files))
+    error('demo_pcpath_rank7_synthetic:OutputExists', ...
+        'One or more demonstration output files already exist.');
+end
+
+exportgraphics(figure_handle, figure_file, 'Resolution', 220);
+writetable(result.parameter_table, parameter_csv);
+if result.empirical_v_used
+    v_table = table(result.contract_labels, ...
+        result.emp.V_path_model(:, 1), result.emp.V_path_model(:, 2), ...
+        'VariableNames', {'Contract', 'PC1', 'PC2'});
+    writetable(v_table, v_csv);
+end
+result.output_files = struct( ...
+    'directory', output_directory, ...
+    'figure', figure_file, ...
+    'report', report_file, ...
+    'parameter_csv', parameter_csv, ...
+    'v_csv', v_csv, ...
+    'mat_file', mat_file);
+save(mat_file, 'result');
+write_report(report_file, result);
+
+end
