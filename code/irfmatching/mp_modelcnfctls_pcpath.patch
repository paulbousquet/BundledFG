+function out = evaluate_h3_and_pc_moments( ...
+    param, emp_two, cfg_two, model, scalar_direction)
+%EVALUATE_H3_AND_PC_MOMENTS Evaluate scalar and two-PC population moments.
+%
+% The model is solved once. Both news bases use only the rate block.
+
+if ~isstruct(scalar_direction) || ~isscalar(scalar_direction) || ...
+        ~all(isfield(scalar_direction, {'v_h', 'v_perp'}))
+    error('evaluate_h3_and_pc_moments:InvalidDirection', ...
+        'scalar_direction must contain v_h and v_perp.');
+end
+
+[~, profile] = solve_model_pcpaths(param, emp_two, cfg_two, model);
+if ~isfield(profile, 'admissible') || ~profile.admissible
+    error('evaluate_h3_and_pc_moments:InadmissibleParameters', ...
+        'The policy-path model evaluation was inadmissible: %s', ...
+        profile.failure_message);
+end
+
+P_news = profile.path_diagnostics.P_news;
+X_news = [ ...
+    profile.Pi_m_model(1:cfg_two.L_pi, 1:cfg_two.J_news); ...
+    profile.Y_m_model(1:cfg_two.L_y, 1:cfg_two.J_news)];
+news_h3 = P_news \ scalar_direction.v_h;
+news_perp = P_news \ scalar_direction.v_perp;
+B_h3 = X_news * news_h3;
+B_perp = X_news * news_perp;
+
+out = struct();
+out.m_h3 = B_h3(:);
+out.m_pc = profile.B_model(:);
+out.m_perp = B_perp(:);
+out.B_h3 = B_h3;
+out.B_pc = profile.B_model;
+out.B_perp = B_perp;
+out.news_h3 = news_h3;
+out.news_pc = profile.news_basis;
+out.news_perp = news_perp;
+out.profile = profile;
+out.prior_not_used = true;
+
+end
