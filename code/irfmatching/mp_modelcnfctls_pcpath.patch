+function tests = test_get_pcpath_parameter_bounds
+%TEST_GET_PCPATH_PARAMETER_BOUNDS Shared posterior-support tests.
+
+tests = functiontests(localfunctions);
+
+end
+
+function setupOnce(testCase)
+
+repo_root = fileparts(fileparts(mfilename('fullpath')));
+testCase.TestData.original_path = path;
+addpath(fullfile(repo_root, '_auxiliary_functions'));
+
+end
+
+function teardownOnce(testCase)
+
+path(testCase.TestData.original_path);
+
+end
+
+function test_seven_and_nine_parameter_supports(testCase)
+
+for n_param = [7, 9]
+    [lower_bound, upper_bound] = ...
+        get_pcpath_parameter_bounds(n_param);
+    testCase.verifyEqual(lower_bound, zeros(n_param, 1));
