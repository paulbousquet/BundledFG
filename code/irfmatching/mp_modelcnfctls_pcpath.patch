+function [emp_transformed, vector_transform] = transform_factor_basis(f, Q)
+
+M = f.cfg.L_pi + f.cfg.L_y;
+vector_transform = kron(Q', eye(M));
+B_emp_transformed = f.B_emp * Q;
+
+emp_transformed = f.emp;
+emp_transformed.V_path_model = f.emp.V_path_model * Q;
+emp_transformed.target_pc = B_emp_transformed(:);
+emp_transformed.Sigma_B_inv = ...
+    vector_transform * f.emp.Sigma_B_inv * vector_transform';
+
+end
