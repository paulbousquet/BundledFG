index 0000000..689e8ae
--- /dev/null
+++ b/model_estim/plot_model_irfs_pcpaths.m
@@ -0,0 +1,318 @@
+function figures = plot_model_irfs_pcpaths(profile, emp, cfg, options)
+%PLOT_MODEL_IRFS_PCPATHS Plot path-conditioned model diagnostics by PC.
+%
+% FIGURES = PLOT_MODEL_IRFS_PCPATHS(PROFILE, EMP, CFG) visualizes the
+% empirical/reconstructed policy paths, recovered current/news wedges,
+% empirical/model macro IRFs, the full model-implied rate paths, and the
+% singular values of the policy-path Jacobian. PROFILE is the diagnostic
+% output returned by SOLVE_MODEL_PCPATHS.
+%
+% OPTIONS is an optional scalar struct with fields Visible (default "on"),
+% OutputDirectory (default empty), FilePrefix (default "pcpaths"), and
+% ExportFormat (default "png"). Files are written only when
+% OutputDirectory is nonempty.
+
+if nargin < 4 || isempty(options)
+    options = struct();
+end
+options = normalize_options(options);
+validate_inputs(profile, emp, cfg);
+
+factor_labels = compose("PC %d", 1:cfg.K_pc);
+path_horizons = double(emp.h_path(:));
+news_horizons = (0:(cfg.J_news - 1))';
+pi_horizons = (0:(cfg.L_pi - 1))';
+y_horizons = (0:(cfg.L_y - 1))';
+rate_horizons = (0:(size(profile.rate_pc_full, 1) - 1))';
+
+figures = struct();
+figures.path_and_news = figure( ...
+    'Name', 'PC policy paths and recovered news wedges', ...
+    'Color', 'w', 'Visible', options.Visible);
+layout = tiledlayout(figures.path_and_news, cfg.K_pc, 2, ...
+    'TileSpacing', 'compact', 'Padding', 'compact');
+title(layout, 'Policy paths are imposed before macro IRFs are matched');
+for i_factor = 1:cfg.K_pc
+    nexttile(layout);
+    plot(path_horizons, emp.V_path_model(:, i_factor), 'o-', ...
+        'LineWidth', 1.4, 'DisplayName', 'Empirical path');
+    hold on;
+    plot(path_horizons, profile.V_fit(:, i_factor), '--', ...
+        'LineWidth', 1.6, 'DisplayName', 'Model reconstruction');
+    hold off;
+    yline(0, ':', 'HandleVisibility', 'off');
+    grid on;
+    xlabel('Path horizon');
+    ylabel('Model rate units');
+    title(factor_labels(i_factor));
+    legend('Location', 'best');
+
+    nexttile(layout);
+    stem(news_horizons, profile.news_basis(:, i_factor), 'filled', ...
+        'LineWidth', 1.1);
+    yline(0, ':');
+    grid on;
+    xlabel('Current/news wedge horizon');
+    ylabel('Wedge size');
+    title(sprintf('%s: recovered wedge sequence', ...
+        factor_labels(i_factor)));
+end
+
+figures.macro_irfs = figure( ...
+    'Name', 'Empirical and model macro IRFs by PC', ...
+    'Color', 'w', 'Visible', options.Visible);
+layout = tiledlayout(figures.macro_irfs, cfg.K_pc, 2, ...
+    'TileSpacing', 'compact', 'Padding', 'compact');
+title(layout, 'Macro responses conditional on each empirical policy path');
+for i_factor = 1:cfg.K_pc
+    nexttile(layout);
+    plot(pi_horizons, emp.B_pi_emp(:, i_factor), 'o-', ...
+        'LineWidth', 1.3, 'DisplayName', 'Empirical LP');
+    hold on;
+    plot(pi_horizons, profile.Pi_pc_model(:, i_factor), '--', ...
+        'LineWidth', 1.6, 'DisplayName', 'Model');
+    hold off;
+    yline(0, ':', 'HandleVisibility', 'off');
+    grid on;
+    xlabel('Response horizon');
+    ylabel('Inflation response');
+    title(sprintf('%s: inflation', factor_labels(i_factor)));
+    legend('Location', 'best');
+
+    nexttile(layout);
+    plot(y_horizons, emp.B_y_emp(:, i_factor), 'o-', ...
+        'LineWidth', 1.3, 'DisplayName', 'Empirical LP');
+    hold on;
+    plot(y_horizons, profile.Y_pc_model(:, i_factor), '--', ...
+        'LineWidth', 1.6, 'DisplayName', 'Model');
+    hold off;
+    yline(0, ':', 'HandleVisibility', 'off');
+    grid on;
+    xlabel('Response horizon');
+    ylabel('Output response');
+    title(sprintf('%s: output', factor_labels(i_factor)));
+    legend('Location', 'best');
+end
+
+figures.tail_and_conditioning = figure( ...
+    'Name', 'PC rate tails and path-map conditioning', ...
+    'Color', 'w', 'Visible', options.Visible);
+layout = tiledlayout(figures.tail_and_conditioning, 1, 2, ...
+    'TileSpacing', 'compact', 'Padding', 'compact');
+
+nexttile(layout);
+plot(rate_horizons, profile.rate_pc_full, 'LineWidth', 1.4);
+hold on;
+xline(profile.rate_diagnostics.last_news_horizon, '--k', ...
+    'Last allowed wedge', ...
+    'LabelVerticalAlignment', 'bottom');
+if profile.rate_diagnostics.last_measurement_rate_horizon ~= ...
+        profile.rate_diagnostics.last_news_horizon
+    xline(profile.rate_diagnostics.last_measurement_rate_horizon, ':k', ...
+        'Last rate used by M_F', 'LabelVerticalAlignment', 'top');
+end
+yline(0, ':k', 'HandleVisibility', 'off');
+hold off;
+grid on;
+xlabel('Rate-response horizon');
+ylabel('Model rate units');
+title('Underlying rate path and measurement support');
+legend(factor_labels, 'Location', 'best');
+
+nexttile(layout);
+singular_values = profile.path_diagnostics.singular_values(:);
+semilogy(1:numel(singular_values), singular_values, 'o-', ...
+    'LineWidth', 1.4);
+grid on;
+xlabel('Singular-value index');
+ylabel('Singular value (log scale)');
+title(sprintf('Policy-path map: rcond = %.3g', ...
+    profile.path_diagnostics.rcond));
+
+if ~isempty(options.OutputDirectory)
+    export_figure(figures.path_and_news, options, 'path_and_news');
+    export_figure(figures.macro_irfs, options, 'macro_irfs');
+    export_figure(figures.tail_and_conditioning, options, ...
+        'tail_and_conditioning');
+end
+
+end
+
+function options = normalize_options(options)
+
+if ~isstruct(options) || ~isscalar(options)
+    error('plot_model_irfs_pcpaths:InvalidOptions', ...
+        'options must be a scalar struct.');
+end
+
+defaults = struct( ...
+    'Visible', 'on', ...
+    'OutputDirectory', '', ...
+    'FilePrefix', 'pcpaths', ...
+    'ExportFormat', 'png');
+option_names = fieldnames(options);
+for i_option = 1:numel(option_names)
+    if ~isfield(defaults, option_names{i_option})
+        error('plot_model_irfs_pcpaths:InvalidOptions', ...
+            'Unknown option field ''%s''.', option_names{i_option});
+    end
+end
+default_names = fieldnames(defaults);
+for i_default = 1:numel(default_names)
+    name = default_names{i_default};
+    if ~isfield(options, name) || isempty(options.(name))
+        options.(name) = defaults.(name);
+    end
+end
+
+options.Visible = validate_text(options.Visible, 'Visible');
+if ~ismember(options.Visible, {'on', 'off'})
+    error('plot_model_irfs_pcpaths:InvalidOptions', ...
+        'options.Visible must be ''on'' or ''off''.');
+end
+options.OutputDirectory = validate_text( ...
+    options.OutputDirectory, 'OutputDirectory', true);
+options.FilePrefix = validate_text(options.FilePrefix, 'FilePrefix');
+options.ExportFormat = validate_text(options.ExportFormat, 'ExportFormat');
+if ~ismember(lower(options.ExportFormat), {'png', 'pdf', 'svg'})
+    error('plot_model_irfs_pcpaths:InvalidOptions', ...
+        'options.ExportFormat must be png, pdf, or svg.');
+end
+if ~isempty(options.OutputDirectory) && ...
+        ~isfolder(options.OutputDirectory)
+    error('plot_model_irfs_pcpaths:MissingOutputDirectory', ...
+        'Output directory does not exist: %s', ...
+        options.OutputDirectory);
+end
+
+end
+
+function validate_inputs(profile, emp, cfg)
+
+if ~isstruct(profile) || ~isscalar(profile) || ...
+        ~isstruct(emp) || ~isscalar(emp) || ...
+        ~isstruct(cfg) || ~isscalar(cfg)
+    error('plot_model_irfs_pcpaths:InvalidInput', ...
+        'profile, emp, and cfg must be scalar structs.');
+end
+require_fields(profile, {'V_fit', 'news_basis', 'Pi_pc_model', ...
+    'Y_pc_model', 'rate_pc_full', 'rate_diagnostics', ...
+    'path_diagnostics'}, 'profile');
+require_fields(emp, {'V_path_model', 'B_pi_emp', 'B_y_emp', ...
+    'h_path'}, 'emp');
+require_fields(cfg, {'H_path', 'J_news', 'K_pc', 'L_pi', 'L_y'}, 'cfg');
+require_fields(profile.path_diagnostics, {'singular_values', 'rcond'}, ...
+    'profile.path_diagnostics');
+require_fields(profile.rate_diagnostics, {'last_news_horizon', ...
+    'measurement_support_horizons', 'last_measurement_rate_horizon', ...
+    'measurement_tolerance'}, 'profile.rate_diagnostics');
+
+expected_shapes = { ...
+    profile.V_fit, [cfg.H_path, cfg.K_pc], 'profile.V_fit'; ...
+    profile.news_basis, [cfg.J_news, cfg.K_pc], 'profile.news_basis'; ...
+    profile.Pi_pc_model, [cfg.L_pi, cfg.K_pc], 'profile.Pi_pc_model'; ...
+    profile.Y_pc_model, [cfg.L_y, cfg.K_pc], 'profile.Y_pc_model'; ...
+    emp.V_path_model, [cfg.H_path, cfg.K_pc], 'emp.V_path_model'; ...
+    emp.B_pi_emp, [cfg.L_pi, cfg.K_pc], 'emp.B_pi_emp'; ...
+    emp.B_y_emp, [cfg.L_y, cfg.K_pc], 'emp.B_y_emp'};
+for i_value = 1:size(expected_shapes, 1)
+    value = expected_shapes{i_value, 1};
+    expected = expected_shapes{i_value, 2};
+    name = expected_shapes{i_value, 3};
+    if ~isnumeric(value) || ~isreal(value) || ...
+            any(~isfinite(value(:))) || ~isequal(size(value), expected)
+        error('plot_model_irfs_pcpaths:DimensionMismatch', ...
+            '%s must be a finite %d-by-%d numeric matrix.', ...
+            name, expected(1), expected(2));
+    end
+end
+if ~isnumeric(profile.rate_pc_full) || ...
+        size(profile.rate_pc_full, 2) ~= cfg.K_pc || ...
+        size(profile.rate_pc_full, 1) < cfg.H_path || ...
+        any(~isfinite(profile.rate_pc_full(:)))
+    error('plot_model_irfs_pcpaths:DimensionMismatch', ...
+        ['profile.rate_pc_full must be a finite matrix with K_pc columns ' ...
+         'and at least H_path rows.']);
+end
+if ~iscolumn(emp.h_path) || numel(emp.h_path) ~= cfg.H_path || ...
+        any(~isfinite(emp.h_path))
+    error('plot_model_irfs_pcpaths:DimensionMismatch', ...
+        'emp.h_path must be a finite H_path-by-1 vector.');
+end
+if ~isnumeric(profile.path_diagnostics.singular_values) || ...
+        isempty(profile.path_diagnostics.singular_values) || ...
+        any(~isfinite(profile.path_diagnostics.singular_values(:))) || ...
+        any(profile.path_diagnostics.singular_values(:) <= 0) || ...
+        ~isnumeric(profile.path_diagnostics.rcond) || ...
+        ~isscalar(profile.path_diagnostics.rcond) || ...
+        ~isfinite(profile.path_diagnostics.rcond) || ...
+        profile.path_diagnostics.rcond <= 0
+    error('plot_model_irfs_pcpaths:InvalidDiagnostics', ...
+        'Path singular values and rcond must be finite and positive.');
+end
+
+rate_diagnostics = profile.rate_diagnostics;
+n_rate_horizons = size(profile.rate_pc_full, 1);
+support = rate_diagnostics.measurement_support_horizons;
+valid_scalar_horizon = @(value) isnumeric(value) && isreal(value) && ...
+    isscalar(value) && isfinite(value) && value >= 0 && ...
+    value == fix(value) && value < n_rate_horizons;
+if ~valid_scalar_horizon(rate_diagnostics.last_news_horizon) || ...
+        ~valid_scalar_horizon( ...
+            rate_diagnostics.last_measurement_rate_horizon) || ...
+        ~isnumeric(support) || ~isreal(support) || ~iscolumn(support) || ...
+        isempty(support) || any(~isfinite(support)) || ...
+        any(support < 0) || any(support ~= fix(support)) || ...
+        any(support >= n_rate_horizons) || ...
+        max(support) ~= rate_diagnostics.last_measurement_rate_horizon || ...
+        ~isnumeric(rate_diagnostics.measurement_tolerance) || ...
+        ~isreal(rate_diagnostics.measurement_tolerance) || ...
+        ~isscalar(rate_diagnostics.measurement_tolerance) || ...
+        ~isfinite(rate_diagnostics.measurement_tolerance) || ...
+        rate_diagnostics.measurement_tolerance < 0
+    error('plot_model_irfs_pcpaths:InvalidDiagnostics', ...
+        'profile.rate_diagnostics contains invalid measurement support.');
+end
+
+end
+
+function require_fields(value, names, struct_name)
+
+for i_name = 1:numel(names)
+    if ~isfield(value, names{i_name})
+        error('plot_model_irfs_pcpaths:MissingField', ...
+            '%s is missing required field ''%s''.', ...
+            struct_name, names{i_name});
+    end
+end
+
+end
+
+function value = validate_text(value, name, allow_empty)
+
+if nargin < 3
+    allow_empty = false;
+end
+if isstring(value) && isscalar(value)
+    value = char(value);
+end
+if allow_empty && ischar(value) && isempty(value)
+    value = '';
+    return
+end
+if ~ischar(value) || ~isrow(value) || isempty(value)
+    error('plot_model_irfs_pcpaths:InvalidOptions', ...
+        'options.%s must be a character vector or string scalar.', name);
+end
+
+end
+
+function export_figure(figure_handle, options, suffix)
+
+file_name = sprintf('%s_%s.%s', options.FilePrefix, suffix, ...
+    lower(options.ExportFormat));
+exportgraphics(figure_handle, ...
+    fullfile(options.OutputDirectory, file_name), ...
+    'ContentType', 'auto');
+
+end
diff --git a/model_estim/sample_posterior_pcpaths.m b/model_estim/sample_posterior_pcpaths.m
new file mode 100644
index 0000000..c7907c5
--- /dev/null
+++ b/model_estim/sample_posterior_pcpaths.m
@@ -0,0 +1,1176 @@
+function result = sample_posterior_pcpaths(overrides)
+%SAMPLE_POSTERIOR_PCPATHS Sample the PC-path quasi-posterior by RWMH.
+%
+% RESULT = SAMPLE_POSTERIOR_PCPATHS(OVERRIDES) is a repository-relative
+% function driver around RUN_MH_PCPATHS. OVERRIDES must identify the exact
+% empirical target data and an initial state. The initial state must be
+% supplied directly in OVERRIDES.initial_param or come from exactly one of
+% OVERRIDES.mode_result and OVERRIDES.mode_file. Mode-based starts are
+% accepted only from a verified, admissible mode for the same model,
+% configuration, and empirical targets.
+%
+% Important options include:
+%   repo_root, data_file, model, behavioral, load_hank,
+%   initial_param, mode_result, mode_file,
+%   H_path, J_news, K_pc, L_pi, L_y, T_model, M_F,
+%   allow_identity_M_F, map_options,
+%   lower_bound, upper_bound, proposal_scale, proposal_factor,
+%   allow_fixed_parameter_conditioning,
+%   N_adapt, N_burn, N_keep, keep_every, N_draws,
+%   adapt_scale, adapt_jitter, normal_draws, uniform_draws,
+%   save_results, save_file, and overwrite_results.
+%
+% Saving is disabled by default and existing files are never overwritten
+% without OVERRIDES.overwrite_results=true. This driver reinitializes the
+% legacy global sequence-space calibration on every call. The legacy
+% proposal fixes coordinates 3 and 5 (and coordinate 8 when behavioral),
+% so its use requires allow_fixed_parameter_conditioning=true; supplying
+% a proposal_factor that moves those coordinates is the opt-out.
+
+if nargin < 1 || isempty(overrides)
+    overrides = struct();
+end
+
+repo_root_default = fileparts(fileparts(mfilename('fullpath')));
+options = normalize_options(overrides, repo_root_default);
+cfg = build_config(options);
+validate_save_request(options);
+
+if ~isfile(options.data_file)
+    error('sample_posterior_pcpaths:EmpiricalDataNotFound', ...
+        ['Empirical PC-path targets were not found at:\n  %s\n' ...
+         'Supply data_file pointing to the exact PCA/LP target MAT file.'], ...
+        options.data_file);
+end
+
+auxiliary_dir = fullfile(options.repo_root, '_auxiliary_functions');
+if ~isfolder(auxiliary_dir)
+    error('sample_posterior_pcpaths:InvalidRepositoryRoot', ...
+        'The auxiliary-function directory does not exist: %s', auxiliary_dir);
+end
+
+original_matlab_path = path;
+path_cleanup = onCleanup(@() restore_matlab_path(original_matlab_path));
+original_working_directory = pwd;
+cwd_cleanup = onCleanup(@() restore_working_directory( ...
+    original_working_directory));
+addpath(auxiliary_dir);
+
+emp = get_empirical_pc_targets(options.data_file, cfg);
+
+global T %#ok<GVMIS>
+T = cfg.T_model;
+prior_info = initialize_legacy_model( ...
+    options.repo_root, options.model, options.load_hank, ...
+    options.behavioral);
+
+n_param = 7 + 2 * double(options.behavioral);
+[lower_bound, upper_bound] = parameter_bounds( ...
+    options, n_param);
+[initial_param, initial_source] = resolve_initial_parameter( ...
+    options, cfg, emp, n_param);
+if any(initial_param < lower_bound) || any(initial_param > upper_bound)
+    error('sample_posterior_pcpaths:InitialParameterOutOfBounds', ...
+        'The initial parameter vector must lie inside the sampler bounds.');
+end
+
+[proposal_factor, proposal_details] = build_proposal_factor( ...
+    options, prior_info.prior_sds, ...
+    prior_info.legacy_proposal_sds, lower_bound, upper_bound);
+settings = build_sampler_settings(options, lower_bound, upper_bound);
+
+objective_handle = @(param) solve_model_pcpaths( ...
+    param, emp, cfg, options.model);
+try
+    [initial_objective, initial_profile] = objective_handle(initial_param);
+catch initial_error
+    error('sample_posterior_pcpaths:InitialObjectiveFailed', ...
+        'Initial objective evaluation failed (%s): %s', ...
+        initial_error.identifier, initial_error.message);
+end
+
+[initial_admissible, failure_identifier, failure_message] = ...
+    profile_admissibility(initial_profile);
+if ~isfinite(initial_objective) || ~initial_admissible
+    if isempty(failure_identifier)
+        failure_identifier = ...
+            'sample_posterior_pcpaths:NonfiniteInitialObjective';
+    end
+    if isempty(failure_message)
+        failure_message = 'The initial objective is NaN or Inf.';
+    end
+    error('sample_posterior_pcpaths:InadmissibleInitialState', ...
+        'Initial state rejected (%s): %s', ...
+        failure_identifier, failure_message);
+end
+
+[mode_objective_difference, mode_objective_tolerance] = ...
+    verify_mode_objective(initial_source, initial_objective);
+
+initial_check = struct();
+initial_check.source = initial_source;
+initial_check.param = initial_param;
+initial_check.objective = initial_objective;
+initial_check.admissible = true;
+initial_check.failure_identifier = '';
+initial_check.failure_message = '';
+initial_check.mode_objective_expected = ...
+    initial_source.mode_objective_recomputed;
+initial_check.mode_objective_difference = mode_objective_difference;
+initial_check.mode_objective_tolerance = mode_objective_tolerance;
+initial_check.profile = initial_profile;
+
+sampler_output = run_MH_pcpaths( ...
+    objective_handle, initial_param, proposal_factor, settings);
+
+result = struct();
+result.repo_root = options.repo_root;
+result.data_file = options.data_file;
+result.model = options.model;
+result.behavioral = options.behavioral;
+result.load_hank = options.load_hank;
+result.cfg = cfg;
+result.emp = emp;
+result.options = options_for_storage(options);
+result.prior_proposal_info = prior_info;
+result.proposal = proposal_details;
+result.bounds = struct( ...
+    'lower_bound', lower_bound, ...
+    'upper_bound', upper_bound);
+result.initial_check = initial_check;
+result.sampler = sampler_output;
+
+if options.save_results
+    if isfile(options.save_file) && ~options.overwrite_results
+        error('sample_posterior_pcpaths:ResultsFileExists', ...
+            ['Refusing to overwrite results created during sampling: %s. ' ...
+             'Set overwrite_results=true to replace it explicitly.'], ...
+            options.save_file);
+    end
+    result.saved_file = options.save_file;
+    result.save_status = 'saved';
+    save_result_safely(options.save_file, result, ...
+        options.overwrite_results);
+else
+    result.saved_file = '';
+    result.save_status = 'not_requested';
+end
+
+end
+
+function options = normalize_options(overrides, repo_root_default)
+
+if ~isstruct(overrides) || ~isscalar(overrides)
+    error('sample_posterior_pcpaths:InvalidOptions', ...
+        'The options override must be a scalar struct.');
+end
+
+defaults = struct();
+defaults.repo_root = repo_root_default;
+defaults.data_file = '';
+defaults.model = '/rank';
+defaults.behavioral = true;
+defaults.load_hank = true;
+defaults.initial_param = [];
+defaults.mode_result = [];
+defaults.mode_file = '';
+defaults.H_path = 8;
+defaults.J_news = 8;
+defaults.K_pc = 2;
+defaults.L_pi = 25;
+defaults.L_y = 25;
+defaults.T_model = 300;
+defaults.M_F = [];
+defaults.allow_identity_M_F = false;
+defaults.map_options = struct();
+defaults.lower_bound = [];
+defaults.upper_bound = [];
+defaults.proposal_scale = 0.8;
+defaults.proposal_factor = [];
+defaults.allow_fixed_parameter_conditioning = false;
+defaults.N_adapt = 100000;
+defaults.N_burn = 150000;
+defaults.N_keep = 1000;
+defaults.keep_every = 100;
+defaults.N_draws = [];
+defaults.adapt_scale = 0.6;
+defaults.adapt_jitter = 1e-10;
+defaults.normal_draws = [];
+defaults.uniform_draws = [];
+defaults.save_results = false;
+defaults.save_file = '';
+defaults.overwrite_results = false;
+
+options = defaults;
+override_names = fieldnames(overrides);
+for i_option = 1:numel(override_names)
+    option_name = override_names{i_option};
+    if ~isfield(defaults, option_name)
+        error('sample_posterior_pcpaths:UnknownOption', ...
+            'Unknown option field ''%s''.', option_name);
+    end
+    options.(option_name) = overrides.(option_name);
+end
+
+options.repo_root = canonicalize_path(validate_text( ...
+    options.repo_root, 'repo_root', false), pwd, 'repo_root');
+if ~isfolder(options.repo_root)
+    error('sample_posterior_pcpaths:InvalidRepositoryRoot', ...
+        'repo_root is not an existing directory: %s', options.repo_root);
+end
+if isempty(options.data_file)
+    options.data_file = fullfile(options.repo_root, ...
+        'model_estim', '_data', 'pc_targets.mat');
+else
+    options.data_file = validate_text( ...
+        options.data_file, 'data_file', false);
+end
+options.data_file = canonicalize_path( ...
+    options.data_file, options.repo_root, 'data_file');
+if ~isempty(options.mode_file)
+    options.mode_file = canonicalize_path(validate_text( ...
+        options.mode_file, 'mode_file', false), ...
+        options.repo_root, 'mode_file');
+end
+
+options.model = validate_text(options.model, 'model', false);
+if ~ismember(options.model, {'/rank', '/hank'})
+    error('sample_posterior_pcpaths:InvalidModel', ...
+        'model must be either ''/rank'' or ''/hank''.');
+end
+options.behavioral = validate_logical_scalar( ...
+    options.behavioral, 'behavioral');
+options.load_hank = validate_logical_scalar( ...
+    options.load_hank, 'load_hank');
+options.allow_identity_M_F = validate_logical_scalar( ...
+    options.allow_identity_M_F, 'allow_identity_M_F');
+options.save_results = validate_logical_scalar( ...
+    options.save_results, 'save_results');
+options.overwrite_results = validate_logical_scalar( ...
+    options.overwrite_results, 'overwrite_results');
+options.allow_fixed_parameter_conditioning = validate_logical_scalar( ...
+    options.allow_fixed_parameter_conditioning, ...
+    'allow_fixed_parameter_conditioning');
+
+dimension_names = {'H_path', 'J_news', 'K_pc', ...
+    'L_pi', 'L_y', 'T_model'};
+for i_dimension = 1:numel(dimension_names)
+    dimension_name = dimension_names{i_dimension};
+    options.(dimension_name) = validate_positive_integer( ...
+        options.(dimension_name), dimension_name);
+end
+if options.H_path ~= options.J_news
+    error('sample_posterior_pcpaths:NonSquarePathSystem', ...
+        ['The exact baseline requires H_path == J_news; received ' ...
+         'H_path=%d and J_news=%d.'], options.H_path, options.J_news);
+end
+if ~ismember(options.K_pc, [1, 2])
+    error('sample_posterior_pcpaths:InvalidFactorCount', ...
+        'K_pc must be one or two; received %d.', options.K_pc);
+end
+if options.T_model < max([options.H_path, options.J_news, ...
+        options.L_pi, options.L_y])
+    error('sample_posterior_pcpaths:InvalidModelHorizon', ...
+        'T_model must be at least H_path, J_news, L_pi, and L_y.');
+end
+
+if ~isempty(options.M_F)
+    validate_finite_matrix(options.M_F, 'M_F');
+    if ~isequal(size(options.M_F), ...
+            [options.H_path, options.T_model])
+        error('sample_posterior_pcpaths:InvalidMeasurementMatrix', ...
+            'M_F must be H_path-by-T_model.');
+    end
+end
+if ~isstruct(options.map_options) || ~isscalar(options.map_options)
+    error('sample_posterior_pcpaths:InvalidOptions', ...
+        'map_options must be a scalar struct.');
+end
+
+validate_initial_source_options(options);
+
+options.N_adapt = validate_nonnegative_integer( ...
+    options.N_adapt, 'N_adapt');
+options.N_burn = validate_nonnegative_integer( ...
+    options.N_burn, 'N_burn');
+options.N_keep = validate_positive_integer(options.N_keep, 'N_keep');
+options.keep_every = validate_positive_integer( ...
+    options.keep_every, 'keep_every');
+expected_draws = options.N_burn + options.N_keep * options.keep_every;
+if isempty(options.N_draws)
+    options.N_draws = expected_draws;
+else
+    options.N_draws = validate_positive_integer( ...
+        options.N_draws, 'N_draws');
+    if options.N_draws ~= expected_draws
+        error('sample_posterior_pcpaths:InvalidSamplerSettings', ...
+            ['N_draws must equal N_burn + N_keep*keep_every (%d); ' ...
+             'received %d.'], expected_draws, options.N_draws);
+    end
+end
+if options.N_adapt == 1 || options.N_adapt > options.N_burn
+    error('sample_posterior_pcpaths:InvalidSamplerSettings', ...
+        'N_adapt must be zero or at least two, and cannot exceed N_burn.');
+end
+
+options.proposal_scale = validate_positive_scalar( ...
+    options.proposal_scale, 'proposal_scale');
+options.adapt_scale = validate_positive_scalar( ...
+    options.adapt_scale, 'adapt_scale');
+options.adapt_jitter = validate_nonnegative_scalar( ...
+    options.adapt_jitter, 'adapt_jitter');
+
+n_param = 7 + 2 * double(options.behavioral);
+if ~isempty(options.initial_param)
+    options.initial_param = validate_parameter_vector( ...
+        options.initial_param, n_param, 'initial_param', true);
+end
+if ~isempty(options.lower_bound)
+    options.lower_bound = validate_parameter_vector( ...
+        options.lower_bound, n_param, 'lower_bound', false);
+end
+if ~isempty(options.upper_bound)
+    options.upper_bound = validate_parameter_vector( ...
+        options.upper_bound, n_param, 'upper_bound', false);
+end
+if ~isempty(options.proposal_factor)
+    validate_finite_matrix(options.proposal_factor, 'proposal_factor');
+    if ~isequal(size(options.proposal_factor), [n_param, n_param])
+        error('sample_posterior_pcpaths:InvalidProposalFactor', ...
+            'proposal_factor must be %d-by-%d.', n_param, n_param);
+    end
+    options.proposal_factor = double(options.proposal_factor);
+end
+validate_random_draws(options, n_param);
+
+if isempty(options.save_file)
+    model_label = options.model(2:end);
+    if options.behavioral
+        expectation_label = 'behavioral';
+    else
+        expectation_label = 'rational';
+    end
+    options.save_file = fullfile(options.repo_root, 'model_estim', ...
+        '_results', sprintf('posterior_draws_pcpaths_%s_%s.mat', ...
+        model_label, expectation_label));
+else
+    options.save_file = validate_text( ...
+        options.save_file, 'save_file', false);
+end
+options.save_file = canonicalize_path( ...
+    options.save_file, options.repo_root, 'save_file');
+
+end
+
+function validate_initial_source_options(options)
+
+has_explicit = ~isempty(options.initial_param);
+has_mode_result = ~isempty(options.mode_result);
+has_mode_file = ~isempty(options.mode_file);
+if double(has_explicit) + double(has_mode_result) + ...
+        double(has_mode_file) ~= 1
+    error('sample_posterior_pcpaths:InitialStateRequired', ...
+        ['Supply exactly one of initial_param, mode_result, or mode_file. ' ...
+         'Mode-based starts must come from a verified mode result.']);
+end
+if has_mode_result && ...
+        (~isstruct(options.mode_result) || ~isscalar(options.mode_result))
+    error('sample_posterior_pcpaths:InvalidModeResult', ...
+        'mode_result must be a scalar result struct.');
+end
+
+end
+
+function cfg = build_config(options)
+
+cfg = struct();
+cfg.H_path = options.H_path;
+cfg.J_news = options.J_news;
+cfg.K_pc = options.K_pc;
+cfg.L_pi = options.L_pi;
+cfg.L_y = options.L_y;
+cfg.T_model = options.T_model;
+cfg.allow_identity_M_F = options.allow_identity_M_F;
+cfg.map_options = options.map_options;
+if ~isempty(options.M_F)
+    cfg.M_F = options.M_F;
+end
+
+end
+
+function validate_save_request(options)
+
+if ~options.save_results
+    return
+end
+if paths_equal(options.save_file, options.data_file)
+    error('sample_posterior_pcpaths:UnsafeResultsPath', ...
+        'save_file must not alias the empirical data_file.');
+end
+if ~isempty(options.mode_file) && ...
+        paths_equal(options.save_file, options.mode_file)
+    error('sample_posterior_pcpaths:UnsafeResultsPath', ...
+        'save_file must not alias the input mode_file.');
+end
+if isfolder(options.save_file)
+    error('sample_posterior_pcpaths:InvalidResultsPath', ...
+        'save_file must identify a file, not an existing directory.');
+end
+save_parent = fileparts(options.save_file);
+if ~isempty(save_parent) && ~isfolder(save_parent)
+    error('sample_posterior_pcpaths:MissingResultsDirectory', ...
+        'The requested results directory does not exist: %s', save_parent);
+end
+if isfile(options.save_file) && ~options.overwrite_results
+    error('sample_posterior_pcpaths:ResultsFileExists', ...
+        ['Refusing to overwrite existing results file: %s. Set ' ...
+         'overwrite_results=true to replace it explicitly.'], ...
+        options.save_file);
+end
+
+end
+
+function prior_info = initialize_legacy_model( ...
+    repo_root, model_name, load_hank_option, behavioral)
+
+path = repo_root; %#ok<NASGU>
+vintage = ''; %#ok<NASGU>
+model = model_name; %#ok<NASGU>
+load_hank = double(load_hank_option); %#ok<NASGU>
+
+global T kappa_sd %#ok<GVMIS,NUSED>
+h_sd = NaN;
+theta_sd = NaN;
+calvo_p_sd = NaN;
+zeta_p_sd = NaN;
+calvo_w_sd = NaN;
+zeta_w_sd = NaN;
+kappa_sd = NaN;
+psi_uti_sd = NaN;
+m_d_sd = NaN;
+m_f_sd = NaN;
+m_d_mean = NaN;
+m_f_mean = NaN;
+
+warning_id = 'MATLAB:dispatcher:nameConflict';
+warning_state = warning('query', warning_id);
+warning_cleanup = onCleanup(@() restore_warning_state( ...
+    warning_state, warning_id));
+auxiliary_dir = fullfile(repo_root, '_auxiliary_functions');
+run(fullfile(auxiliary_dir, 'get_calibration_general.m'));
+
+if strcmp(model_name, '/hank') && ~load_hank_option
+    hank_builder = fullfile(auxiliary_dir, ...
+        '_hank_inputs', 'get_hank_inputs_2.m');
+    run(hank_builder);
+    load_hank = 1; %#ok<NASGU>
+end
+run(fullfile(auxiliary_dir, 'get_baseline_jacobians.m'));
+run(fullfile(auxiliary_dir, 'get_priors_general.m'));
+
+if strcmp(model_name, '/rank')
+    first_sd = h_sd;
+    first_name = 'h';
+else
+    first_sd = theta_sd;
+    first_name = 'theta';
+end
+prior_sds = [first_sd, calvo_p_sd, zeta_p_sd, ...
+    calvo_w_sd, zeta_w_sd, kappa_sd, psi_uti_sd];
+parameter_names = {first_name, 'calvo_p', 'zeta_p', ...
+    'calvo_w', 'zeta_w', 'kappa', 'psi_uti'};
+if behavioral
+    prior_sds = [prior_sds, m_d_sd, m_f_sd];
+    parameter_names = [parameter_names, {'m_d', 'm_f'}];
+end
+if any(~isfinite(prior_sds)) || any(prior_sds <= 0) || ...
+        ~isfinite(m_d_mean) || ~isfinite(m_f_mean)
+    error('sample_posterior_pcpaths:PriorInitializationFailed', ...
+        'The legacy prior script did not initialize finite positive SDs.');
+end
+
+legacy_proposal_sds = prior_sds;
+if strcmp(model_name, '/hank')
+    legacy_proposal_sds(1) = 0.1;
+end
+legacy_default_fixed_dimensions = [3, 5];
+if behavioral
+    legacy_default_fixed_dimensions = ...
+        [legacy_default_fixed_dimensions, 8];
+end
+legacy_proposal_sds(legacy_default_fixed_dimensions) = 0;
+
+prior_info = struct();
+prior_info.parameter_names = parameter_names;
+prior_info.prior_sds = prior_sds(:);
+prior_info.legacy_proposal_sds = legacy_proposal_sds(:);
+prior_info.legacy_default_fixed_dimensions = ...
+    legacy_default_fixed_dimensions(:);
+prior_info.m_d_mean = m_d_mean;
+prior_info.m_f_mean = m_f_mean;
+
+end
+
+function [lower_bound, upper_bound] = parameter_bounds(options, n_param)
+
+[default_lower, default_upper] = get_pcpath_parameter_bounds(n_param);
+if isempty(options.lower_bound)
+    lower_bound = default_lower;
+else
+    lower_bound = options.lower_bound(:);
+end
+if isempty(options.upper_bound)
+    upper_bound = default_upper;
+else
+    upper_bound = options.upper_bound(:);
+end
+if any(lower_bound > upper_bound)
+    error('sample_posterior_pcpaths:InvalidBounds', ...
+        'Each lower bound must be less than or equal to its upper bound.');
+end
+
+end
+
+function [initial_param, source] = resolve_initial_parameter( ...
+    options, cfg, emp, n_param)
+
+if ~isempty(options.initial_param)
+    initial_param = options.initial_param(:);
+    source = struct( ...
+        'type', 'explicit', ...
+        'file', '', ...
+        'mode_objective_recomputed', NaN);
+    return
+end
+
+if ~isempty(options.mode_result)
+    mode_result = options.mode_result;
+    source_type = 'passed_verified_mode';
+    source_file = '';
+else
+    mode_file = validate_text(options.mode_file, 'mode_file', false);
+    if ~isfile(mode_file)
+        error('sample_posterior_pcpaths:ModeFileNotFound', ...
+            'Mode result file not found: %s', mode_file);
+    end
+    loaded = load(mode_file);
+    if ~isfield(loaded, 'result') || ...
+            ~isstruct(loaded.result) || ~isscalar(loaded.result)
+        error('sample_posterior_pcpaths:InvalidModeFile', ...
+            'mode_file must contain one scalar struct variable named result.');
+    end
+    mode_result = loaded.result;
+    source_type = 'loaded_verified_mode';
+    source_file = mode_file;
+end
+
+validate_mode_result(mode_result, options, cfg, emp, n_param);
+initial_param = mode_result.optimum.param(:);
+source = struct( ...
+    'type', source_type, ...
+    'file', source_file, ...
+    'mode_objective_recomputed', ...
+    double(mode_result.optimum.objective_recomputed));
+
+end
+
+function validate_mode_result(mode_result, options, cfg, emp, n_param)
+
+required_fields = {'verified', 'converged', 'admissible', 'model', ...
+    'behavioral', 'load_hank', 'cfg', 'emp', 'optimum', ...
+    'final_profile'};
+require_fields(mode_result, required_fields, ...
+    'sample_posterior_pcpaths:InvalidModeResult', 'mode_result');
+if ~logical_true(mode_result.verified) || ...
+        ~logical_true(mode_result.converged) || ...
+        ~logical_true(mode_result.admissible)
+    error('sample_posterior_pcpaths:UnverifiedModeResult', ...
+        'The mode result must be verified, converged, and admissible.');
+end
+mode_model = validate_mode_text(mode_result.model, 'mode_result.model');
+mode_behavioral = validate_mode_logical( ...
+    mode_result.behavioral, 'mode_result.behavioral');
+mode_load_hank = validate_mode_logical( ...
+    mode_result.load_hank, 'mode_result.load_hank');
+if ~strcmp(mode_model, options.model) || ...
+        mode_behavioral ~= options.behavioral
+    error('sample_posterior_pcpaths:ModeResultMismatch', ...
+        'The mode result model or behavioral specification does not match.');
+end
+if mode_load_hank ~= options.load_hank
+    error('sample_posterior_pcpaths:ModeResultMismatch', ...
+        'The mode result load_hank initialization does not match.');
+end
+
+cfg_fields = {'H_path', 'J_news', 'K_pc', 'L_pi', 'L_y', ...
+    'T_model', 'map_options'};
+require_fields(mode_result.cfg, cfg_fields, ...
+    'sample_posterior_pcpaths:InvalidModeResult', 'mode_result.cfg');
+dimension_fields = cfg_fields(1:6);
+for i_field = 1:numel(dimension_fields)
+    field_name = dimension_fields{i_field};
+    validate_mode_positive_integer( ...
+        mode_result.cfg.(field_name), ...
+        ['mode_result.cfg.' field_name]);
+end
+for i_field = 1:numel(dimension_fields)
+    field_name = dimension_fields{i_field};
+    if mode_result.cfg.(field_name) ~= cfg.(field_name)
+        error('sample_posterior_pcpaths:ModeResultMismatch', ...
+            'Mode configuration field %s does not match.', field_name);
+    end
+end
+if ~isstruct(mode_result.cfg.map_options) || ...
+        ~isscalar(mode_result.cfg.map_options)
+    error('sample_posterior_pcpaths:InvalidModeResult', ...
+        'mode_result.cfg.map_options must be a scalar struct.');
+end
+if ~structs_equal(mode_result.cfg.map_options, cfg.map_options)
+    error('sample_posterior_pcpaths:ModeResultMismatch', ...
+        'The mode result map_options do not match the current map_options.');
+end
+
+emp_fields = {'V_path_model', 'target_pc', 'Sigma_B_inv', 'M_F'};
+require_fields(mode_result.emp, emp_fields, ...
+    'sample_posterior_pcpaths:InvalidModeResult', 'mode_result.emp');
+for i_field = 1:numel(emp_fields)
+    field_name = emp_fields{i_field};
+    require_consistency(mode_result.emp.(field_name), ...
+        emp.(field_name), ['mode_result.emp.' field_name]);
+end
+
+if ~isstruct(mode_result.optimum) || ~isscalar(mode_result.optimum) || ...
+        ~isfield(mode_result.optimum, 'param') || ...
+        ~isfield(mode_result.optimum, 'objective_recomputed')
+    error('sample_posterior_pcpaths:InvalidModeResult', ...
+        'mode_result.optimum must contain param and objective_recomputed.');
+end
+validate_parameter_vector(mode_result.optimum.param, ...
+    n_param, 'mode_result.optimum.param', true);
+if ~isnumeric(mode_result.optimum.objective_recomputed) || ...
+        ~isreal(mode_result.optimum.objective_recomputed) || ...
+        ~isscalar(mode_result.optimum.objective_recomputed) || ...
+        ~isfinite(mode_result.optimum.objective_recomputed)
+    error('sample_posterior_pcpaths:InvalidModeResult', ...
+        'The recomputed mode objective must be a finite real scalar.');
+end
+if ~isstruct(mode_result.final_profile) || ...
+        ~isscalar(mode_result.final_profile) || ...
+        ~isfield(mode_result.final_profile, 'admissible') || ...
+        ~logical_true(mode_result.final_profile.admissible)
+    error('sample_posterior_pcpaths:UnverifiedModeResult', ...
+        'mode_result.final_profile must be admissible.');
+end
+
+end
+
+function [proposal_factor, details] = build_proposal_factor( ...
+    options, prior_sds, legacy_proposal_sds, ...
+    lower_bound, upper_bound)
+
+fixed_parameters = lower_bound == upper_bound;
+legacy_fixed_dimensions = find(legacy_proposal_sds == 0);
+if isempty(options.proposal_factor)
+    proposal_factor = options.proposal_scale * ...
+        diag(legacy_proposal_sds);
+    proposal_factor(fixed_parameters, :) = 0;
+    source = 'legacy_proposal_sds_with_fixed_dimensions';
+else
+    proposal_factor = options.proposal_factor;
+    source = 'override';
+end
+if any(any(proposal_factor(fixed_parameters, :) ~= 0))
+    error('sample_posterior_pcpaths:ProposalMovesFixedParameter', ...
+        ['Rows of proposal_factor corresponding to fixed parameter bounds ' ...
+         'must be zero.']);
+end
+fixed_by_proposal = ~any(proposal_factor ~= 0, 2);
+conditioned_dimensions = find(fixed_by_proposal & ~fixed_parameters);
+if ~isempty(conditioned_dimensions) && ...
+        ~options.allow_fixed_parameter_conditioning
+    dimension_text = char(strjoin( ...
+        string(conditioned_dimensions.'), ', '));
+    error('sample_posterior_pcpaths:FixedParameterConditioningNotAllowed', ...
+        ['The proposal fixes parameter coordinates [%s] without equal ' ...
+         'lower and upper bounds. Set allow_fixed_parameter_conditioning=' ...
+         'true to sample that explicitly conditional posterior, or supply ' ...
+         'a proposal_factor that moves those coordinates.'], ...
+         dimension_text);
+end
+
+free_by_proposal = ~fixed_parameters & ~fixed_by_proposal;
+free_factor = proposal_factor(free_by_proposal, :);
+if isempty(free_factor)
+    proposal_singular_values = zeros(0, 1);
+    proposal_rank_tolerance = 0;
+    proposal_row_rank = 0;
+else
+    proposal_singular_values = svd(free_factor, 'econ');
+    proposal_rank_tolerance = max(size(free_factor)) * ...
+        eps(max(proposal_singular_values));
+    proposal_row_rank = sum( ...
+        proposal_singular_values > proposal_rank_tolerance);
+    if proposal_row_rank < size(free_factor, 1)
+        error('sample_posterior_pcpaths:RankDeficientProposalFactor', ...
+            ['The proposal factor has numerical row rank %d for %d free ' ...
+             'parameter coordinates. The option ' ...
+             'allow_fixed_parameter_conditioning authorizes explicit ' ...
+             'zero-row coordinate conditioning only, not an unidentified ' ...
+             'linear proposal subspace.'], ...
+            proposal_row_rank, size(free_factor, 1));
+    end
+end
+
+details = struct();
+details.source = source;
+details.proposal_scale = options.proposal_scale;
+details.prior_sds = prior_sds;
+details.legacy_proposal_sds = legacy_proposal_sds;
+details.initial_factor = proposal_factor;
+details.fixed_bound_dimensions = find(fixed_parameters);
+details.legacy_default_fixed_dimensions = ...
+    legacy_fixed_dimensions(:);
+details.fixed_by_proposal_dimensions = find(fixed_by_proposal);
+details.conditioned_dimensions = conditioned_dimensions;
+details.free_dimensions = find(free_by_proposal);
+details.free_proposal_row_rank = proposal_row_rank;
+details.proposal_rank_tolerance = proposal_rank_tolerance;
+details.proposal_singular_values = proposal_singular_values;
+details.fixed_parameter_conditioning_allowed = ...
+    options.allow_fixed_parameter_conditioning;
+
+end
+
+function settings = build_sampler_settings( ...
+    options, lower_bound, upper_bound)
+
+settings = struct();
+settings.N_adapt = options.N_adapt;
+settings.N_burn = options.N_burn;
+settings.N_keep = options.N_keep;
+settings.keep_every = options.keep_every;
+settings.N_draws = options.N_draws;
+settings.lower_bound = lower_bound;
+settings.upper_bound = upper_bound;
+settings.adapt_scale = options.adapt_scale;
+settings.adapt_jitter = options.adapt_jitter;
+if ~isempty(options.normal_draws)
+    settings.normal_draws = options.normal_draws;
+end
+if ~isempty(options.uniform_draws)
+    settings.uniform_draws = options.uniform_draws;
+end
+
+end
+
+function validate_random_draws(options, n_param)
+
+if ~isempty(options.normal_draws)
+    validate_finite_matrix(options.normal_draws, 'normal_draws');
+    if ~isequal(size(options.normal_draws), [n_param, options.N_draws])
+        error('sample_posterior_pcpaths:InvalidRandomDraws', ...
+            'normal_draws must be %d-by-%d.', n_param, options.N_draws);
+    end
+end
+if ~isempty(options.uniform_draws)
+    value = options.uniform_draws;
+    if ~isnumeric(value) || ~isfloat(value) || ~isreal(value) || ...
+            ~isvector(value) || numel(value) ~= options.N_draws || ...
+            any(~isfinite(value(:))) || any(value(:) < 0) || ...
+            any(value(:) >= 1)
+        error('sample_posterior_pcpaths:InvalidRandomDraws', ...
+            'uniform_draws must contain N_draws values in [0,1).');
+    end
+end
+
+end
+
+function [admissible, failure_identifier, failure_message] = ...
+    profile_admissibility(profile)
+
+admissible = false;
+failure_identifier = '';
+failure_message = '';
+if ~isstruct(profile) || ~isscalar(profile)
+    failure_identifier = 'sample_posterior_pcpaths:InvalidInitialProfile';
+    failure_message = 'The objective profile is not a scalar struct.';
+    return
+end
+if isfield(profile, 'failure_identifier')
+    failure_identifier = optional_text(profile.failure_identifier);
+end
+if isfield(profile, 'failure_message')
+    failure_message = optional_text(profile.failure_message);
+end
+if isfield(profile, 'admissible')
+    admissible = logical_true(profile.admissible);
+end
+
+end
+
+function [difference, tolerance] = verify_mode_objective( ...
+    initial_source, initial_objective)
+
+expected = initial_source.mode_objective_recomputed;
+if isnan(expected)
+    difference = NaN;
+    tolerance = NaN;
+    return
+end
+difference = abs(initial_objective - expected);
+tolerance = 1e-8 * max([1, abs(initial_objective), abs(expected)]);
+if difference > tolerance
+    error('sample_posterior_pcpaths:StaleModeResult', ...
+        ['The recomputed initial objective (%0.16g) differs from the ' ...
+         'verified mode objective (%0.16g) by %g, exceeding tolerance ' ...
+         '%g. Recompute the mode under the current code and inputs.'], ...
+        initial_objective, expected, difference, tolerance);
+end
+
+end
+
+function stored_options = options_for_storage(options)
+
+stored_options = options;
+large_fields = {'mode_result', 'normal_draws', 'uniform_draws'};
+for i_field = 1:numel(large_fields)
+    field_name = large_fields{i_field};
+    if isfield(stored_options, field_name)
+        stored_options = rmfield(stored_options, field_name);
+    end
+end
+stored_options.mode_result_was_passed = ~isempty(options.mode_result);
+stored_options.normal_draws_were_supplied = ~isempty(options.normal_draws);
+stored_options.uniform_draws_were_supplied = ~isempty(options.uniform_draws);
+
+end
+
+function save_result_safely(save_file, result, overwrite_results)
+
+save_parent = fileparts(save_file);
+if ~isfolder(save_parent)
+    error('sample_posterior_pcpaths:MissingResultsDirectory', ...
+        'The requested results directory does not exist: %s', save_parent);
+end
+temporary_file = canonicalize_path( ...
+    [tempname(save_parent), '.mat'], save_parent, ...
+    'temporary results file');
+temporary_parent = fileparts(temporary_file);
+if ~paths_equal(temporary_parent, save_parent) || ...
+        paths_equal(temporary_file, save_file) || isfile(temporary_file)
+    error('sample_posterior_pcpaths:UnsafeTemporaryResultsPath', ...
+        'Could not establish a unique temporary file in save_file''s directory.');
+end
+temporary_cleanup = onCleanup(@() delete_temporary_result( ...
+    temporary_file, save_parent));
+
+save(temporary_file, 'result', '-v7.3');
+if isfile(save_file) && ~overwrite_results
+    error('sample_posterior_pcpaths:ResultsFileExists', ...
+        ['Refusing to overwrite results created during temporary saving: ' ...
+         '%s. Set overwrite_results=true to replace it explicitly.'], ...
+        save_file);
+end
+move_temporary_result(temporary_file, save_file, overwrite_results);
+clear temporary_cleanup
+
+end
+
+function move_temporary_result( ...
+    temporary_file, save_file, overwrite_results)
+
+empty_path_components = javaArray('java.lang.String', 0);
+temporary_path = javaMethod('get', 'java.nio.file.Paths', ...
+    temporary_file, empty_path_components);
+save_path = javaMethod('get', 'java.nio.file.Paths', ...
+    save_file, empty_path_components);
+if overwrite_results
+    copy_options = javaArray('java.nio.file.CopyOption', 1);
+    copy_options(1) = javaMethod( ...
+        'valueOf', 'java.nio.file.StandardCopyOption', ...
+        'REPLACE_EXISTING');
+else
+    copy_options = javaArray('java.nio.file.CopyOption', 0);
+end
+
+try
+    javaMethod('move', 'java.nio.file.Files', ...
+        temporary_path, save_path, copy_options);
+catch move_error
+    is_existence_collision = ...
+        isa(move_error, 'matlab.exception.JavaException') && ...
+        isa(move_error.ExceptionObject, ...
+        'java.nio.file.FileAlreadyExistsException');
+    if ~overwrite_results && is_existence_collision
+        error('sample_posterior_pcpaths:ResultsFileExists', ...
+            ['Refusing to overwrite results created during temporary ' ...
+             'saving: %s. Set overwrite_results=true to replace it ' ...
+             'explicitly.'], save_file);
+    end
+    contextual_error = MException( ...
+        'sample_posterior_pcpaths:SaveFailed', ...
+        'Could not replace the requested results file: %s', save_file);
+    contextual_error = addCause(contextual_error, move_error);
+    throw(contextual_error);
+end
+
+end
+
+function delete_temporary_result(temporary_file, expected_parent)
+
+if ~isfile(temporary_file)
+    return
+end
+actual_parent = fileparts(temporary_file);
+if ~paths_equal(actual_parent, expected_parent)
+    warning('sample_posterior_pcpaths:TemporaryCleanupRefused', ...
+        'Refusing to delete a temporary file outside the validated directory.');
+    return
+end
+delete(temporary_file);
+
+end
+
+function require_consistency(value, reference, name)
+
+if ~isnumeric(value) || ~isnumeric(reference) || ...
+        ~isequal(size(value), size(reference)) || ...
+        any(~isfinite(value(:))) || any(~isfinite(reference(:)))
+    error('sample_posterior_pcpaths:ModeResultMismatch', ...
+        '%s has incompatible dimensions or nonfinite values.', name);
+end
+difference = norm(double(value) - double(reference), 'fro');
+scale = max([1, norm(double(value), 'fro'), ...
+    norm(double(reference), 'fro')]);
+if difference > 1e-12 * scale
+    error('sample_posterior_pcpaths:ModeResultMismatch', ...
+        '%s differs from the current empirical target.', name);
+end
+
+end
+
+function value = validate_parameter_vector( ...
+    value, expected_length, name, require_finite)
+
+if ~isnumeric(value) || ~isfloat(value) || ~isreal(value) || ...
+        ~isvector(value) || numel(value) ~= expected_length || ...
+        any(isnan(value(:)))
+    error('sample_posterior_pcpaths:InvalidParameterOptions', ...
+        '%s must be a real floating-point vector of length %d.', ...
+        name, expected_length);
+end
+if require_finite && any(~isfinite(value(:)))
+    error('sample_posterior_pcpaths:InvalidParameterOptions', ...
+        '%s must contain only finite values.', name);
+end
+value = double(value(:).');
+
+end
+
+function validate_finite_matrix(value, name)
+
+if ~isnumeric(value) || ~isfloat(value) || ~isreal(value) || ...
+        ~ismatrix(value) || isempty(value) || any(~isfinite(value(:)))
+    error('sample_posterior_pcpaths:InvalidOptions', ...
+        '%s must be a nonempty finite real floating-point matrix.', name);
+end
+
+end
+
+function value = validate_positive_integer(value, name)
+
+if ~isnumeric(value) || ~isreal(value) || ~isscalar(value) || ...
+        ~isfinite(value) || value <= 0 || value ~= fix(value)
+    error('sample_posterior_pcpaths:InvalidOptions', ...
+        '%s must be a finite positive integer.', name);
+end
+value = double(value);
+
+end
+
+function value = validate_nonnegative_integer(value, name)
+
+if ~isnumeric(value) || ~isreal(value) || ~isscalar(value) || ...
+        ~isfinite(value) || value < 0 || value ~= fix(value)
+    error('sample_posterior_pcpaths:InvalidOptions', ...
+        '%s must be a finite nonnegative integer.', name);
+end
+value = double(value);
+
+end
+
+function value = validate_positive_scalar(value, name)
+
+if ~isnumeric(value) || ~isreal(value) || ~isscalar(value) || ...
+        ~isfinite(value) || value <= 0
+    error('sample_posterior_pcpaths:InvalidOptions', ...
+        '%s must be a finite positive scalar.', name);
+end
+value = double(value);
+
+end
+
+function value = validate_nonnegative_scalar(value, name)
+
+if ~isnumeric(value) || ~isreal(value) || ~isscalar(value) || ...
+        ~isfinite(value) || value < 0
+    error('sample_posterior_pcpaths:InvalidOptions', ...
+        '%s must be a finite nonnegative scalar.', name);
+end
+value = double(value);
+
+end
+
+function value = validate_logical_scalar(value, name)
+
+is_binary_numeric = isnumeric(value) && isreal(value) && ...
+    isscalar(value) && isfinite(value) && (value == 0 || value == 1);
+if ~(islogical(value) && isscalar(value)) && ~is_binary_numeric
+    error('sample_posterior_pcpaths:InvalidOptions', ...
+        '%s must be a scalar logical or numeric zero/one.', name);
+end
+value = logical(value);
+
+end
+
+function tf = logical_true(value)
+
+is_binary_numeric = isnumeric(value) && isreal(value) && ...
+    isscalar(value) && isfinite(value) && (value == 0 || value == 1);
+tf = ((islogical(value) && isscalar(value)) || is_binary_numeric) && ...
+    logical(value);
+
+end
+
+function value = validate_text(value, name, allow_empty)
+
+if isstring(value) && isscalar(value)
+    value = char(value);
+end
+if ~ischar(value) || ~isrow(value) || (~allow_empty && isempty(value))
+    error('sample_posterior_pcpaths:InvalidOptions', ...
+        '%s must be a nonempty character vector or string scalar.', name);
+end
+
+end
+
+function value = validate_mode_text(value, name)
+
+if isstring(value) && isscalar(value)
+    value = char(value);
+end
+if ~ischar(value) || ~isrow(value) || isempty(value)
+    error('sample_posterior_pcpaths:InvalidModeResult', ...
+        '%s must be a nonempty character vector or string scalar.', name);
+end
+
+end
+
+function value = validate_mode_logical(value, name)
+
+is_binary_numeric = isnumeric(value) && isreal(value) && ...
+    isscalar(value) && isfinite(value) && (value == 0 || value == 1);
+if ~(islogical(value) && isscalar(value)) && ~is_binary_numeric
+    error('sample_posterior_pcpaths:InvalidModeResult', ...
+        '%s must be a scalar logical or numeric zero/one.', name);
+end
+value = logical(value);
+
+end
+
+function validate_mode_positive_integer(value, name)
+
+if ~isnumeric(value) || ~isreal(value) || ~isscalar(value) || ...
+        ~isfinite(value) || value <= 0 || value ~= fix(value)
+    error('sample_posterior_pcpaths:InvalidModeResult', ...
+        '%s must be a finite positive integer scalar.', name);
+end
+
+end
+
+function tf = structs_equal(left, right)
+
+tf = isstruct(left) && isscalar(left) && ...
+    isstruct(right) && isscalar(right) && ...
+    isequaln(orderfields(left), orderfields(right));
+
+end
+
+function absolute_path = canonicalize_path(value, base_directory, name)
+
+try
+    candidate = javaObject('java.io.File', value);
+    if ~candidate.isAbsolute()
+        candidate = javaObject( ...
+            'java.io.File', base_directory, value);
+    end
+    absolute_path = char(candidate.getCanonicalPath());
+catch path_error
+    contextual_error = MException( ...
+        'sample_posterior_pcpaths:InvalidPath', ...
+        'Could not canonicalize %s.', name);
+    contextual_error = addCause(contextual_error, path_error);
+    throw(contextual_error);
+end
+if isempty(absolute_path) || ~isrow(absolute_path)
+    error('sample_posterior_pcpaths:InvalidPath', ...
+        'Canonicalizing %s did not produce a nonempty path.', name);
+end
+
+end
+
+function tf = paths_equal(left, right)
+
+if ispc
+    tf = strcmpi(left, right);
+else
+    tf = strcmp(left, right);
+end
+
+end
+
+function value = optional_text(value)
+
+if isstring(value) && isscalar(value)
+    value = char(value);
+end
+if ~ischar(value) || ~isrow(value)
+    value = '';
+end
+
+end
+
+function require_fields(value, field_names, error_id, struct_name)
+
+if ~isstruct(value) || ~isscalar(value)
+    error(error_id, '%s must be a scalar struct.', struct_name);
+end
+for i_field = 1:numel(field_names)
+    field_name = field_names{i_field};
+    if ~isfield(value, field_name)
+        error(error_id, '%s is missing required field ''%s''.', ...
+            struct_name, field_name);
+    end
+end
+
+end
+
+function restore_matlab_path(original_matlab_path)
+
+path(original_matlab_path);
+
+end
+
+function restore_working_directory(original_working_directory)
+
+if isfolder(original_working_directory)
+    cd(original_working_directory);
+end
+
+end
+
+function restore_warning_state(warning_state, warning_id)
+
+warning(warning_state.state, warning_id);
+
+end
diff --git a/model_estim/screen_h3_vs_pc_identification.m b/model_estim/screen_h3_vs_pc_identification.m
new file mode 100644
index 0000000..627bab3
--- /dev/null
+++ b/model_estim/screen_h3_vs_pc_identification.m
@@ -0,0 +1,231 @@
+function result = screen_h3_vs_pc_identification(options)
+%SCREEN_H3_VS_PC_IDENTIFICATION Modest interior population-truth search.
+%
+% This is a deterministic Latin-hypercube screen, not an optimizer of the
+% H=3 singular value. Every candidate is evaluated by the same diagnostic.
+
+if nargin < 1 || isempty(options)
+    options = struct();
+end
+options = normalize_options(options);
+n_param = 9;
+starts = deterministic_latin_hypercube( ...
+    options.NCandidates, n_param, options.RandomSeed);
+candidates = options.SearchLower + ...
+    starts .* (options.SearchUpper - options.SearchLower);
+
+minimum_gain = NaN(options.NCandidates, 1);
+relative_gain = NaN(options.NCandidates, 1);
+direction_gain = NaN(options.NCandidates, 1);
+h3_minimum = NaN(options.NCandidates, 1);
+pc_minimum = NaN(options.NCandidates, 1);
+h3_relative = NaN(options.NCandidates, 1);
+pc_relative = NaN(options.NCandidates, 1);
+path_rcond = NaN(options.NCandidates, 1);
+derivatives_reliable = false(options.NCandidates, 1);
+h3_rank = NaN(options.NCandidates, 1);
+pc_rank = NaN(options.NCandidates, 1);
+status = strings(options.NCandidates, 1);
+
+for i_candidate = 1:options.NCandidates
+    diagnostic_options = struct( ...
+        'Param0', candidates(i_candidate, :), ...
+        'TModel', options.TModel, ...
+        'LPi', options.LPi, ...
+        'LY', options.LY, ...
+        'NProfilePoints', 3, ...
+        'MaximumProfileDistance', 0.05, ...
+        'RunMultistart', false, ...
+        'RunRobustness', false, ...
+        'SaveOutputs', false);
+    try
+        diagnostic = diagnose_h3_vs_pc_identification(diagnostic_options);
+        minimum_gain(i_candidate) = diagnostic.minimum_singular_value_gain;
+        relative_gain(i_candidate) = ...
+            diagnostic.pc_svd.minimum_to_maximum / ...
+            diagnostic.h3_svd.minimum_to_maximum;
+        direction_gain(i_candidate) = diagnostic.sensitivity_gain_along_q;
+        h3_minimum(i_candidate) = diagnostic.h3_svd.singular_values(end);
+        pc_minimum(i_candidate) = diagnostic.pc_svd.singular_values(end);
+        h3_relative(i_candidate) = diagnostic.h3_svd.minimum_to_maximum;
+        pc_relative(i_candidate) = diagnostic.pc_svd.minimum_to_maximum;
+        path_rcond(i_candidate) = diagnostic.path_rcond;
+        derivatives_reliable(i_candidate) = ...
+            diagnostic.finite_difference.all_reliable;
+        h3_rank(i_candidate) = diagnostic.h3_svd.ranks(end);
+        pc_rank(i_candidate) = diagnostic.pc_svd.ranks(end);
+        status(i_candidate) = "ok";
+    catch exception
+        status(i_candidate) = string(exception.identifier);
+    end
+    fprintf(['candidate %d/%d | status=%s | min gain=%.4g | ' ...
+        'relative gain=%.4g | q gain=%.4g\n'], ...
+        i_candidate, options.NCandidates, status(i_candidate), ...
+        minimum_gain(i_candidate), relative_gain(i_candidate), ...
+        direction_gain(i_candidate));
+end
+
+candidate_table = array2table(candidates, ...
+    'VariableNames', {'h', 'calvo_p', 'zeta_p', 'calvo_w', ...
+    'zeta_w', 'kappa', 'psi_uti', 'm_d', 'm_f'});
+candidate_table.Candidate = (1:options.NCandidates)';
+candidate_table.Status = status;
+candidate_table.H3SigmaMin = h3_minimum;
+candidate_table.TwoPCSigmaMin = pc_minimum;
+candidate_table.MinimumGain = minimum_gain;
+candidate_table.H3Relative = h3_relative;
+candidate_table.TwoPCRelative = pc_relative;
+candidate_table.RelativeGain = relative_gain;
+candidate_table.DirectionGain = direction_gain;
+candidate_table.PathRcond = path_rcond;
+candidate_table.DerivativesReliable = derivatives_reliable;
+candidate_table.H3Rank = h3_rank;
+candidate_table.TwoPCRank = pc_rank;
+candidate_table = movevars(candidate_table, 'Candidate', 'Before', 1);
+
+eligible = status == "ok" & derivatives_reliable & ...
+    path_rcond >= options.MinimumPathRcond;
+score = log10(minimum_gain);
+score(~eligible) = -Inf;
+[best_score, best_index] = max(score);
+if ~isfinite(best_score)
+    best_index = NaN;
+    best_candidate = NaN(1, n_param);
+else
+    best_candidate = candidates(best_index, :);
+end
+
+result = struct( ...
+    'options', options, ...
+    'candidates', candidates, ...
+    'candidate_table', candidate_table, ...
+    'eligible', eligible, ...
+    'score_log10_minimum_gain', score, ...
+    'best_index', best_index, ...
+    'best_candidate', best_candidate, ...
+    'best_score', best_score, ...
+    'output_files', struct());
+
+if options.SaveOutputs
+    if ~isfolder(options.OutputDirectory)
+        mkdir(options.OutputDirectory);
+    end
+    csv_file = fullfile(options.OutputDirectory, ...
+        'identification_screening_candidates.csv');
+    mat_file = fullfile(options.OutputDirectory, ...
+        'identification_screening_candidates.mat');
+    if ~options.Overwrite && (isfile(csv_file) || isfile(mat_file))
+        error('screen_h3_vs_pc_identification:OutputExists', ...
+            'One or more screening output files already exist.');
+    end
+    writetable(candidate_table, csv_file);
+    result.output_files = struct('csv', csv_file, 'mat', mat_file);
+    save(mat_file, 'result');
+end
+
+end
+
+function starts = deterministic_latin_hypercube(n_start, n_param, seed)
+
+previous_rng = rng;
+rng_cleanup = onCleanup(@() rng(previous_rng));
+rng(seed, 'twister');
+starts = zeros(n_start, n_param);
+for i_param = 1:n_param
+    permutation = randperm(n_start)';
+    starts(:, i_param) = (permutation - rand(n_start, 1)) / n_start;
+end
+
+end
+
+function options = normalize_options(options)
+
+defaults = struct( ...
+    'NCandidates', 25, ...
+    'RandomSeed', 314159, ...
+    'SearchLower', [0.25, 0.50, 0.50, 0.50, 0.50, 2.0, 0.20, 0.55, 0.45], ...
+    'SearchUpper', [0.90, 0.95, 0.95, 0.95, 0.95, 8.0, 0.80, 0.95, 0.95], ...
+    'TModel', 60, ...
+    'LPi', 12, ...
+    'LY', 12, ...
+    'MinimumPathRcond', 1e-4, ...
+    'SaveOutputs', false, ...
+    'OutputDirectory', '', ...
+    'Overwrite', false);
+if ~isstruct(options) || ~isscalar(options)
+    error('screen_h3_vs_pc_identification:InvalidOptions', ...
+        'options must be a scalar struct.');
+end
+names = fieldnames(defaults);
+unknown = setdiff(fieldnames(options), names);
+if ~isempty(unknown)
+    error('screen_h3_vs_pc_identification:InvalidOptions', ...
+        'Unknown option ''%s''.', unknown{1});
+end
+for i_name = 1:numel(names)
+    name = names{i_name};
+    if ~isfield(options, name) || isempty(options.(name))
+        options.(name) = defaults.(name);
+    end
+end
+integer_fields = {'NCandidates', 'RandomSeed', 'TModel', 'LPi', 'LY'};
+for i_field = 1:numel(integer_fields)
+    value = options.(integer_fields{i_field});
+    if ~isnumeric(value) || ~isscalar(value) || ~isfinite(value) || ...
+            value <= 0 || value ~= fix(value)
+        error('screen_h3_vs_pc_identification:InvalidOptions', ...
+            '%s must be a finite positive integer.', integer_fields{i_field});
+    end
+end
+if options.TModel < max([8, options.LPi, options.LY])
+    error('screen_h3_vs_pc_identification:InvalidOptions', ...
+        'TModel must cover every path and response horizon.');
+end
+range_fields = {'SearchLower', 'SearchUpper'};
+for i_field = 1:numel(range_fields)
+    name = range_fields{i_field};
+    value = options.(name);
+    if ~isnumeric(value) || ~isfloat(value) || ~isreal(value) || ...
+            ~isvector(value) || numel(value) ~= 9 || any(~isfinite(value(:)))
+        error('screen_h3_vs_pc_identification:InvalidOptions', ...
+            '%s must contain nine finite real values.', name);
+    end
+    options.(name) = value(:)';
+end
+if any(options.SearchLower >= options.SearchUpper)
+    error('screen_h3_vs_pc_identification:InvalidOptions', ...
+        'SearchLower must be strictly below SearchUpper.');
+end
+if ~isnumeric(options.MinimumPathRcond) || ...
+        ~isscalar(options.MinimumPathRcond) || ...
+        ~isfinite(options.MinimumPathRcond) || ...
+        options.MinimumPathRcond <= 0 || options.MinimumPathRcond > 1
+    error('screen_h3_vs_pc_identification:InvalidOptions', ...
+        'MinimumPathRcond must be in (0,1].');
+end
+logical_fields = {'SaveOutputs', 'Overwrite'};
+for i_field = 1:numel(logical_fields)
+    name = logical_fields{i_field};
+    value = options.(name);
+    is_binary = isnumeric(value) && isscalar(value) && isfinite(value) && ...
+        (value == 0 || value == 1);
+    if ~(islogical(value) && isscalar(value)) && ~is_binary
+        error('screen_h3_vs_pc_identification:InvalidOptions', ...
+            '%s must be a scalar logical or zero/one.', name);
+    end
+    options.(name) = logical(value);
+end
+if isstring(options.OutputDirectory) && isscalar(options.OutputDirectory)
+    options.OutputDirectory = char(options.OutputDirectory);
+end
+if ~ischar(options.OutputDirectory) || ...
+        (~isempty(options.OutputDirectory) && ~isrow(options.OutputDirectory))
+    error('screen_h3_vs_pc_identification:InvalidOptions', ...
+        'OutputDirectory must be a character row vector or scalar string.');
+end
+if options.SaveOutputs && isempty(options.OutputDirectory)
+    error('screen_h3_vs_pc_identification:MissingOutputDirectory', ...
+        'OutputDirectory is required when SaveOutputs=true.');
+end
+
+end
