+function initialize_rank_model(repo_root)
+
+path = repo_root; %#ok<NASGU>
+vintage = ''; %#ok<NASGU>
+model = '/rank'; %#ok<NASGU>
+load_hank = 1; %#ok<NASGU>
+auxiliary_dir = fullfile(repo_root, '_auxiliary_functions');
+run(fullfile(auxiliary_dir, 'get_calibration_general.m'));
+run(fullfile(auxiliary_dir, 'get_baseline_jacobians.m'));
+run(fullfile(auxiliary_dir, 'get_priors_general.m'));
+
+end
+
+function M_F = make_measurement_matrix(H_path, T_model)
+
+M_F = zeros(H_path, T_model);
+for i_path = 1:H_path
+    M_F(i_path, i_path) = 0.8;
+    M_F(i_path, i_path + 1) = 0.2;
+end
+
+end
+
+function [V_path_model, M_F, contract_labels, info] = ...
+        make_empirical_v_design(T_model)
+
+contract_labels = ["FF2"; "ED2"; "ED3"; "ED4"; ...
+    "ED5"; "ED6"; "ED7"; "ED8"];
+contract_standard_deviations = [ ...
+    0.061957457072553; ...
+    0.078151653862559; ...
+    0.086757262560638; ...
+    0.088801492415157; ...
+    0.090563338927930; ...
+    0.089411630655409; ...
+    0.085755771712437; ...
+    0.084908431137473];
+standardized_eigenvectors = [ ...
+     0.210288913413718,  0.875326157912900; ...
+     0.354879848443269,  0.280434559823092; ...
+     0.374344624221295,  0.081475073791727; ...
+     0.372826361654720, -0.116002230596633; ...
+     0.376268275368575, -0.152051531370801; ...
+     0.373598000306016, -0.178957681407913; ...
+     0.369772644647738, -0.200385995669873; ...
+     0.364445308413764, -0.199413646949749];
+V_path_model = diag(contract_standard_deviations) * ...
+    standardized_eigenvectors;
+
+% Exact timing supplied with the empirical design: contract row j is the
+% model-quarter response at H=j-1.
+M_F = [eye(8), zeros(8, T_model - 8)];
+
+info = struct();
+info.contract_labels = contract_labels;
+info.sample_size = 174;
+info.sample_start = '1994-02-04';
+info.sample_end = '2026-04-29';
+info.sample_filter = ['Date >= 1993-01-01, abs(ED2) > 0.01, and complete ' ...
+    'FF2/ED2-ED8 observations'];
+info.pca_implementation = ['sklearn StandardScaler(ddof=0), followed by ' ...
+    'PCA(n_components=2, svd_solver=full)'];
+info.source_file = 'jk_source_classified_with_pc1.csv';
+info.source_sha256 = ...
+    'e939c0abda019ba8828ddee42dd87e738dfc4529505e210231de197461989101';
+info.contract_standard_deviations = contract_standard_deviations;
+info.standardized_eigenvectors = standardized_eigenvectors;
+info.raw_loading_formula = ...
+    'V = diag(contract_standard_deviations) * standardized_eigenvectors';
+info.measurement_assumption = ['Exact mapping from the eight contract rows ' ...
+    'to model quarters 0:7'];
+
+end
+
+function news_basis = make_news_basis(J_news)
+
+horizon = (0:(J_news - 1))';
+level_pc = 0.75 * exp(-0.20 * horizon);
+slope_pc = 0.55 * exp(-0.16 * horizon) .* ...
+    (horizon - mean(horizon)) / max(horizon);
+news_basis = [level_pc, slope_pc];
+
+end
+
