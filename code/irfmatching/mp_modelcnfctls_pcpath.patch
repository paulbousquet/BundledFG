+testCase.verifyEqual(out_tail.resid, out_base.resid, 'AbsTol', tol);
+testCase.verifyEqual(out_tail.rate_pc_full(1:f.cfg.H_path,:), ...
+    out_base.rate_pc_full(1:f.cfg.H_path,:), 'AbsTol', tol);
+testCase.verifyGreaterThan(max(abs( ...
+    out_tail.rate_pc_full(f.cfg.H_path+1:end,:) - ...
+    out_base.rate_pc_full(f.cfg.H_path+1:end,:)), [], 'all'), 1e-6);
