diff --git a/tests/test_get_empirical_pc_targets.m b/tests/test_get_empirical_pc_targets.m
new file mode 100644
index 0000000..dbf0954
--- /dev/null
+++ b/tests/test_get_empirical_pc_targets.m
@@ -0,0 +1,294 @@
+function tests = test_get_empirical_pc_targets
+%TEST_GET_EMPIRICAL_PC_TARGETS Unit tests for empirical PC target loading.
+
+tests = functiontests(localfunctions);
+
+end
+
+function setupOnce(testCase)
+
+tests_dir = fileparts(mfilename('fullpath'));
+repo_root = fileparts(tests_dir);
+
+testCase.TestData.original_path = path;
+addpath(fullfile(repo_root, '_auxiliary_functions'));
+testCase.TestData.cfg = make_config();
+testCase.TestData.source = make_source(testCase.TestData.cfg);
+
+testCase.TestData.temp_dir = tempname;
+mkdir(testCase.TestData.temp_dir);
+
+end
+
+function teardownOnce(testCase)
+
+path(testCase.TestData.original_path);
+if isfolder(testCase.TestData.temp_dir)
+    data_file = fullfile(testCase.TestData.temp_dir, 'pc_targets.mat');
+    if isfile(data_file)
+        delete(data_file);
+    end
+    rmdir(testCase.TestData.temp_dir);
+end
+
+end
+
+function test_struct_input_stacks_outcomes_and_vectorizes_by_factor(testCase)
+
+source = testCase.TestData.source;
+cfg = testCase.TestData.cfg;
+emp = get_empirical_pc_targets(source, cfg);
+
+B_expected = [source.B_pi_emp; source.B_y_emp];
+target_expected = [B_expected(:,1); B_expected(:,2)];
+
+testCase.verifyEqual(emp.B_emp, B_expected);
+testCase.verifyEqual(emp.target_pc, target_expected);
+testCase.verifyEqual(emp.target_pc, B_expected(:));
+testCase.verifyEqual(emp.V_path_model, source.V_path_model);
+testCase.verifyEqual(emp.M_F, source.M_F);
+testCase.verifyEqual(emp.factor_scores, source.factor_scores);
+testCase.verifyEqual(emp.metadata, source.metadata);
+testCase.verifyEqual(emp.H_path, cfg.H_path);
+testCase.verifyEqual(emp.K_pc, cfg.K_pc);
+testCase.verifyEqual(emp.L_pi, cfg.L_pi);
+testCase.verifyEqual(emp.L_y, cfg.L_y);
+testCase.verifyEqual(emp.T_model, cfg.T_model);
+testCase.verifyEqual(emp.Sigma_B_chol * emp.Sigma_B_chol', ...
+    emp.Sigma_B, 'AbsTol', 1e-12);
+testCase.verifyEqual(emp.Sigma_B_inv_chol * emp.Sigma_B_inv_chol', ...
+    emp.Sigma_B_inv, 'AbsTol', 1e-12);
+testCase.verifyGreaterThan(emp.Sigma_B_rcond, 0);
+testCase.verifyGreaterThan(emp.Sigma_B_inv_rcond, 0);
+
+end
+
+function test_mat_file_input_matches_struct_input(testCase)
+
+source = testCase.TestData.source;
+cfg = testCase.TestData.cfg;
+data_file = fullfile(testCase.TestData.temp_dir, 'pc_targets.mat');
+save(data_file, '-struct', 'source');
+
+from_struct = get_empirical_pc_targets(source, cfg);
+from_file = get_empirical_pc_targets(string(data_file), cfg);
+
+testCase.verifyEqual(from_file.V_path_model, from_struct.V_path_model);
+testCase.verifyEqual(from_file.B_emp, from_struct.B_emp);
+testCase.verifyEqual(from_file.target_pc, from_struct.target_pc);
+testCase.verifyEqual(from_file.Sigma_B_inv, from_struct.Sigma_B_inv, ...
+    'AbsTol', 1e-12);
+testCase.verifyEqual(from_file.M_F, from_struct.M_F);
+testCase.verifyEqual(from_file.metadata, from_struct.metadata);
+
+end
+
+function test_covariance_and_precision_inputs_are_equivalent(testCase)
+
+source_covariance = testCase.TestData.source;
+cfg = testCase.TestData.cfg;
+n_target = (cfg.L_pi + cfg.L_y) * cfg.K_pc;
+precision_expected = source_covariance.Sigma_B \ eye(n_target);
+precision_expected = (precision_expected + precision_expected') / 2;
+
+source_precision = rmfield(source_covariance, 'Sigma_B');
+source_precision.Sigma_B_inv = precision_expected;
+
+source_both = source_covariance;
+source_both.Sigma_B_inv = precision_expected;
+
+emp_covariance = get_empirical_pc_targets(source_covariance, cfg);
+emp_precision = get_empirical_pc_targets(source_precision, cfg);
+emp_both = get_empirical_pc_targets(source_both, cfg);
+
+testCase.verifyEqual(emp_covariance.Sigma_B_inv, precision_expected, ...
+    'AbsTol', 1e-12);
+testCase.verifyEqual(emp_precision.Sigma_B_inv, precision_expected, ...
+    'AbsTol', 1e-12);
+testCase.verifyEqual(emp_both.Sigma_B_inv, precision_expected, ...
+    'AbsTol', 1e-12);
+testCase.verifyEqual(emp_covariance.Sigma_B_rcond, ...
+    rcond(emp_covariance.Sigma_B), 'AbsTol', eps);
+testCase.verifyEqual(emp_precision.Sigma_B_inv_rcond, ...
+    rcond(emp_precision.Sigma_B_inv), 'AbsTol', eps);
+
+source_inconsistent = source_both;
+source_inconsistent.Sigma_B_inv(1,1) = ...
+    source_inconsistent.Sigma_B_inv(1,1) + 0.2;
+testCase.verifyError(@() get_empirical_pc_targets( ...
+    source_inconsistent, cfg), ...
+    'get_empirical_pc_targets:InconsistentCovariance');
+
+end
+
+function test_measurement_matrix_reconciliation_and_identity_opt_in(testCase)
+
+source = testCase.TestData.source;
+cfg = testCase.TestData.cfg;
+
+cfg_matching = cfg;
+cfg_matching.M_F = source.M_F;
+emp_matching = get_empirical_pc_targets(source, cfg_matching);
+testCase.verifyEqual(emp_matching.M_F, source.M_F);
+
+source_without_M_F = rmfield(source, 'M_F');
+cfg_only = cfg;
+cfg_only.M_F = source.M_F;
+emp_cfg_only = get_empirical_pc_targets(source_without_M_F, cfg_only);
+testCase.verifyEqual(emp_cfg_only.M_F, source.M_F);
+
+cfg_inconsistent = cfg_matching;
+cfg_inconsistent.M_F(1,1) = cfg_inconsistent.M_F(1,1) + 0.1;
+testCase.verifyError(@() get_empirical_pc_targets( ...
+    source, cfg_inconsistent), ...
+    'get_empirical_pc_targets:InconsistentMeasurementMatrix');
+
+testCase.verifyError(@() get_empirical_pc_targets( ...
+    source_without_M_F, cfg), ...
+    'get_empirical_pc_targets:MissingMeasurementMatrix');
+
+cfg_without_opt_in = rmfield(cfg, 'allow_identity_M_F');
+testCase.verifyError(@() get_empirical_pc_targets( ...
+    source_without_M_F, cfg_without_opt_in), ...
+    'get_empirical_pc_targets:MissingMeasurementMatrix');
+
+cfg_identity = cfg;
+cfg_identity.allow_identity_M_F = true;
+emp_identity = get_empirical_pc_targets(source_without_M_F, cfg_identity);
+identity_expected = [eye(cfg.H_path), ...
+    zeros(cfg.H_path, cfg.T_model-cfg.H_path)];
+testCase.verifyEqual(emp_identity.M_F, identity_expected);
+
+end
+
+function test_rejects_missing_and_inconsistent_targets(testCase)
+
+source = testCase.TestData.source;
+cfg = testCase.TestData.cfg;
+
+source_missing = rmfield(source, 'B_y_emp');
+testCase.verifyError(@() get_empirical_pc_targets( ...
+    source_missing, cfg), ...
+    'get_empirical_pc_targets:MissingField');
+
+source_bad_size = source;
+source_bad_size.B_pi_emp = source_bad_size.B_pi_emp(1:end-1,:);
+testCase.verifyError(@() get_empirical_pc_targets( ...
+    source_bad_size, cfg), ...
+    'get_empirical_pc_targets:DimensionMismatch');
+
+source_dependent_paths = source;
+source_dependent_paths.V_path_model(:, 2) = ...
+    source_dependent_paths.V_path_model(:, 1);
+testCase.verifyError(@() get_empirical_pc_targets( ...
+    source_dependent_paths, cfg), ...
+    'get_empirical_pc_targets:RankDeficientPathTargets');
+
+source_bad_target = source;
+source_bad_target.target_pc = ...
+    [source.B_pi_emp; source.B_y_emp];
+source_bad_target.target_pc = source_bad_target.target_pc(:);
+source_bad_target.target_pc(1) = source_bad_target.target_pc(1) + 1;
+testCase.verifyError(@() get_empirical_pc_targets( ...
+    source_bad_target, cfg), ...
+    'get_empirical_pc_targets:InconsistentTarget');
+
+end
+
+function test_rejects_invalid_covariance_horizons_metadata_and_file(testCase)
+
+source = testCase.TestData.source;
+cfg = testCase.TestData.cfg;
+
+source_bad_covariance = source;
+n_target = size(source_bad_covariance.Sigma_B,1);
+source_bad_covariance.Sigma_B = diag([ones(1,n_target-1), -1]);
+testCase.verifyError(@() get_empirical_pc_targets( ...
+    source_bad_covariance, cfg), ...
+    'get_empirical_pc_targets:InvalidCovariance');
+
+source_no_covariance = rmfield(source, 'Sigma_B');
+testCase.verifyError(@() get_empirical_pc_targets( ...
+    source_no_covariance, cfg), ...
+    'get_empirical_pc_targets:MissingCovariance');
+
+source_bad_horizons = source;
+source_bad_horizons.h_path(end) = source_bad_horizons.h_path(end) + 1;
+testCase.verifyError(@() get_empirical_pc_targets( ...
+    source_bad_horizons, cfg), ...
+    'get_empirical_pc_targets:InvalidHorizons');
+
+source_bad_metadata = source;
+source_bad_metadata.metadata = 'undocumented';
+testCase.verifyError(@() get_empirical_pc_targets( ...
+    source_bad_metadata, cfg), ...
+    'get_empirical_pc_targets:InvalidMetadata');
+
+source_missing_metadata_field = source;
+source_missing_metadata_field.metadata = rmfield( ...
+    source_missing_metadata_field.metadata, 'rate_unit_conversion');
+testCase.verifyError(@() get_empirical_pc_targets( ...
+    source_missing_metadata_field, cfg), ...
+    'get_empirical_pc_targets:InvalidMetadata');
+
+source_bad_schema = source;
+source_bad_schema.metadata.schema_version = 'unversioned';
+testCase.verifyError(@() get_empirical_pc_targets( ...
+    source_bad_schema, cfg), ...
+    'get_empirical_pc_targets:UnsupportedMetadataSchema');
+
+source_bad_order = source;
+source_bad_order.metadata.target_order = 'outcome-major';
+testCase.verifyError(@() get_empirical_pc_targets( ...
+    source_bad_order, cfg), ...
+    'get_empirical_pc_targets:InvalidMetadata');
+
+missing_file = fullfile(testCase.TestData.temp_dir, 'missing.mat');
+testCase.verifyError(@() get_empirical_pc_targets(missing_file, cfg), ...
+    'get_empirical_pc_targets:FileNotFound');
+
+end
+
+function cfg = make_config()
+
+cfg = struct();
+cfg.H_path = 4;
+cfg.K_pc = 2;
+cfg.L_pi = 3;
+cfg.L_y = 2;
+cfg.T_model = 7;
+cfg.allow_identity_M_F = false;
+
+end
+
+function source = make_source(cfg)
+
+source = struct();
+source.V_path_model = [0.21  0.88;
+                       0.36  0.27;
+                       0.37  0.08;
+                       0.38 -0.07];
+source.B_pi_emp = [1 101;
+                   2 102;
+                   3 103];
+source.B_y_emp = [4 104;
+                  5 105];
+source.h_path = (0:cfg.H_path-1)';
+source.metadata = struct( ...
+    'schema_version', 'pcpaths-v1', ...
+    'source_provenance', 'deterministic synthetic unit-test fixture', ...
+    'pca_reconstruction', 'path_change = V_path_model * factor_score', ...
+    'score_normalization', 'unstandardized synthetic factor scores', ...
+    'rate_unit_conversion', 'already expressed in model quarterly units', ...
+    'contract_measurement', 'point-rate identity selector', ...
+    'covariance_provenance', 'deterministic synthetic SPD covariance', ...
+    'target_order', 'pc-major:[inflation;output]');
+source.factor_scores = [0.5 -0.2; -0.1 0.4];
+source.M_F = [eye(cfg.H_path), ...
+    zeros(cfg.H_path, cfg.T_model-cfg.H_path)];
+
+n_target = (cfg.L_pi + cfg.L_y) * cfg.K_pc;
+source.Sigma_B = diag(linspace(1, 2, n_target)) + ...
+    0.02 * ones(n_target);
+
+end
