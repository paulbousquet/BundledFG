+function result = demo_pcpath_rank7_synthetic(options)
+%DEMO_PCPATH_RANK7_SYNTHETIC Full seven-parameter DSGE method demonstration.
+%
+% RESULT = DEMO_PCPATH_RANK7_SYNTHETIC(OPTIONS) generates synthetic policy-
+% path and macro targets from the repository's RANK model, estimates all
+% seven structural parameters with the rate-only concentration step, and
+% optionally writes a figure, parameter table, MAT result, and Markdown
+% report. Set OPTIONS.PathDesign='empirical-v-n174' to hold fixed the
+% empirical FF2/ED2-ED8 raw-contract PC loading matrix while generating B
+% from the model. This is a method demonstration, not an empirical estimate.
+
+if nargin < 1 || isempty(options)
+    options = struct();
+end
+options = normalize_options(options);
+
+model_estim_dir = fileparts(mfilename('fullpath'));
+repo_root = fileparts(model_estim_dir);
+auxiliary_dir = fullfile(repo_root, '_auxiliary_functions');
+original_path = path;
+path_cleanup = onCleanup(@() path(original_path));
+addpath(auxiliary_dir);
+
+global T T_use n_shock shocks_match %#ok<GVMIS>
+T = 16;
+T_use = 8;
+n_shock = 8;
+shocks_match = 1;
+initialize_rank_model(repo_root);
+
+parameter_names = {'h', 'calvo_p', 'zeta_p', ...
+    'calvo_w', 'zeta_w', 'kappa', 'psi_uti'};
+parameter_labels = {'h', '\theta_p', '\zeta_p', ...
+    '\theta_w', '\zeta_w', '\kappa', '\psi_u'};
+true_param = [0.68, 0.78, 0.88, 0.72, 0.84, 5.20, 0.48];
+start_param = [0.57, 0.85, 0.81, 0.81, 0.76, 4.25, 0.59];
+lower_bound = [0.10, 0.40, 0.40, 0.40, 0.40, 1.00, 0.10];
+upper_bound = [0.95, 0.98, 0.98, 0.98, 0.98, 9.00, 0.90];
+
+cfg = struct( ...
+    'H_path', 8, ...
+    'J_news', 8, ...
+    'K_pc', 2, ...
+    'L_pi', 8, ...
+    'L_y', 8, ...
+    'T_model', T, ...
+    'allow_identity_M_F', strcmp(options.PathDesign, 'empirical-v-n174'), ...
+    'map_options', struct( ...
+        'rcond_fail', 1e-12, ...
+        'rcond_warn', 1e-8, ...
+        'path_tol_abs', 1e-11, ...
+        'path_tol_rel', 1e-9, ...
+        'emit_warning', false));
+
+[Pi_true, Y_true, R_true] = raw_rank_irfs(true_param, cfg);
+if strcmp(options.PathDesign, 'empirical-v-n174')
+    [V_path_model, M_F, contract_labels, design_info] = ...
+        make_empirical_v_design(cfg.T_model);
+    [news_basis_true, ~, truth_path_diagnostics] = map_paths_to_news( ...
+        R_true, V_path_model, M_F, cfg.H_path, cfg.J_news, ...
+        cfg.map_options);
+    metadata = empirical_v_dgp_metadata(design_info);
+else
+    M_F = make_measurement_matrix(cfg.H_path, cfg.T_model);
+    news_basis_true = make_news_basis(cfg.J_news);
+    V_path_model = M_F * R_true(:, 1:cfg.J_news) * news_basis_true;
+    contract_labels = strings(0, 1);
+    design_info = struct();
+    truth_path_diagnostics = struct();
+    metadata = synthetic_metadata();
+end
+B_pi_emp = Pi_true(1:cfg.L_pi, 1:cfg.J_news) * news_basis_true;
+B_y_emp = Y_true(1:cfg.L_y, 1:cfg.J_news) * news_basis_true;
+B_emp = [B_pi_emp; B_y_emp];
+target_scale = max(0.025, 0.08 * abs(B_emp(:)));
+
+source = struct( ...
+    'V_path_model', V_path_model, ...
+    'B_pi_emp', B_pi_emp, ...
+    'B_y_emp', B_y_emp, ...
+    'Sigma_B', diag(target_scale.^2), ...
+    'M_F', M_F, ...
+    'h_path', (0:(cfg.H_path - 1))', ...
+    'metadata', metadata);
+emp = get_empirical_pc_targets(source, cfg);
+
+span = upper_bound - lower_bound;
+start_unit = ((start_param - lower_bound) ./ span)';
+evaluation_count = 0;
+best_loss_history = zeros(0, 1);
+best_loss = Inf;
+if exist('lsqnonlin', 'file') ~= 2
+    error('demo_pcpath_rank7_synthetic:MissingOptimizationToolbox', ...
+        'This seven-parameter demonstration requires lsqnonlin.');
+end
+residual_objective = @weighted_residual_in_unit_cube;
+optimizer_options = optimoptions('lsqnonlin', ...
+    'Display', options.Display, ...
+    'MaxIterations', options.MaxIter, ...
+    'MaxFunctionEvaluations', options.MaxFunEvals, ...
+    'StepTolerance', options.TolX, ...
+    'FunctionTolerance', options.TolFun, ...
+    'OptimalityTolerance', options.TolFun, ...
+    'FiniteDifferenceType', 'central');
+[estimated_unit, residual_sum_squares, final_weighted_residual, ...
+        exitflag, optimizer_output] = lsqnonlin( ...
+        residual_objective, start_unit, zeros(7, 1), ones(7, 1), ...
+        optimizer_options);
+minimum_loss = 0.5 * residual_sum_squares;
+estimated_param = lower_bound + span .* estimated_unit';
+[~, estimated_profile] = solve_model_pcpaths( ...
+    estimated_param, emp, cfg, '/rank');
+[~, true_profile] = solve_model_pcpaths(true_param, emp, cfg, '/rank');
+
+absolute_error = estimated_param - true_param;
+relative_error = absolute_error ./ true_param;
+parameter_table = table( ...
+    string(parameter_names(:)), true_param(:), start_param(:), ...
+    estimated_param(:), absolute_error(:), relative_error(:), ...
+    'VariableNames', {'Parameter', 'True', 'Start', 'Estimated', ...
+    'AbsoluteError', 'RelativeError'});
+
+result = struct();
+if strcmp(options.PathDesign, 'empirical-v-n174')
+    result.description = ['Seven-parameter RANK DGP using the empirical ' ...
+        'FF2/ED2-ED8 V; B and the measurement operator remain synthetic.'];
+else
+    result.description = ['Seven-parameter synthetic RANK demonstration; ' ...
+        'not an empirical estimate.'];
+end
+result.synthetic_only = true;
+result.production_ready = false;
+result.path_design = options.PathDesign;
+result.empirical_v_used = strcmp(options.PathDesign, 'empirical-v-n174');
+result.contract_labels = contract_labels;
+result.design_info = design_info;
+result.truth_path_diagnostics = truth_path_diagnostics;
+result.model = '/rank';
+result.optimizer = 'lsqnonlin';
+result.parameter_names = parameter_names;
+result.true_param = true_param;
+result.start_param = start_param;
+result.estimated_param = estimated_param;
+result.absolute_error = absolute_error;
+result.relative_error = relative_error;
+result.parameter_table = parameter_table;
+result.minimum_loss = minimum_loss;
+result.final_weighted_residual = final_weighted_residual;
+result.exitflag = exitflag;
+result.optimizer_output = optimizer_output;
+result.evaluation_count = evaluation_count;
+result.best_loss_history = best_loss_history;
+result.emp = emp;
+result.cfg = cfg;
+result.news_basis_true = news_basis_true;
+result.true_profile = true_profile;
+result.estimated_profile = estimated_profile;
+result.max_abs_parameter_error = max(abs(absolute_error));
+result.max_abs_relative_parameter_error = max(abs(relative_error));
+result.max_abs_path_error = ...
+    estimated_profile.path_diagnostics.max_abs_path_error;
+result.max_abs_macro_residual = max(abs(estimated_profile.resid));
+if result.empirical_v_used
+    result.missing_production_inputs = { ...
+        'estimated B_pi_emp and B_y_emp', ...
+        'joint sampling covariance Sigma_B'};
+else
+    result.missing_production_inputs = { ...
+        'estimated B_pi_emp and B_y_emp', ...
+        'joint sampling covariance Sigma_B', ...
+        'empirical model-unit PC rate paths V_path_model', ...
+        'contract/calendar-consistent measurement matrix M_F'};
+end
+result.output_files = struct( ...
+    'directory', '', 'figure', '', 'report', '', ...
+    'parameter_csv', '', 'v_csv', '', 'mat_file', '');
+
+figure_handle = make_result_figure( ...
+    result, parameter_labels, B_pi_emp, B_y_emp);
+if options.SaveOutputs
+    result = save_outputs(result, figure_handle, options);
+end
+if ~options.KeepFigureOpen
+    close(figure_handle);
+end
+
+    function weighted_residual = weighted_residual_in_unit_cube(unit_param)
+        trial_param = lower_bound + span .* unit_param(:)';
+        [~, profile] = solve_model_pcpaths(trial_param, emp, cfg, '/rank');
+        if isfield(profile, 'admissible') && profile.admissible
+            weighted_residual = emp.Sigma_B_inv_chol' * profile.resid;
+        else
+            weighted_residual = 1e6 * ones(numel(emp.target_pc), 1);
+        end
+        loss = 0.5 * sum(weighted_residual.^2);
+        evaluation_count = evaluation_count + 1;
+        if isfinite(loss) && loss < best_loss
+            best_loss = loss;
+        end
+        best_loss_history(evaluation_count, 1) = best_loss;
+    end
+
+end
+
+function [Pi_model, Y_model, R_model] = raw_rank_irfs(param, cfg)
+
+zero_target = zeros(3 * cfg.L_pi, 1);
+identity_weight = eye(3 * cfg.L_pi);
+[~, Pi_model, Y_model, R_model, ~, ~, ~, ~] = solve_model( ...
+    param, zero_target, identity_weight, '/rank');
+
+end
