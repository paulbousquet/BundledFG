+tol = scaled_tolerance(out_base.news_basis);
+testCase.verifyEqual(out_changed.news_basis, out_base.news_basis, ...
+    'AbsTol', tol);
+testCase.verifyEqual(out_changed.V_fit, out_base.V_fit, 'AbsTol', tol);
+testCase.verifyGreaterThan(abs(loss_changed - loss_base), 1e-6);
