+end
+
+function f = make_fixture()
+
+f.H = 4;
+f.J = 4;
+f.T = 7;
+
+P_news = [1.00  0.20 -0.10  0.05;
+          0.15  0.95  0.12 -0.02;
+         -0.05  0.10  1.10  0.08;
+          0.02 -0.04  0.09  0.90];
+
+f.R = zeros(f.T, f.T);
+f.R(1:f.H,1:f.J) = P_news;
+f.R(5:7,1:f.J) = [0.30 0.20 0.10 0;
+                   0.20 0.25 0.15 0.05;
+                   0.10 0.20 0.20 0.10];
+
+f.V = [0.21  0.88;
+       0.36  0.27;
+       0.37  0.08;
+       0.38 -0.07];
+f.M_F = [eye(f.H), zeros(f.H, f.T-f.H)];
+f.options = struct( ...
+    'rcond_fail', 1e-12, ...
+    'rcond_warn', 1e-8, ...
+    'path_tol_abs', 1e-12, ...
+    'path_tol_rel', 1e-11, ...
+    'emit_warning', false);
+
+end
+
+function tol = scaled_tolerance(value)
+
+tol = 1e-11 * max(1, norm(value(:), inf));
+
+end
