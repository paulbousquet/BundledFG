+function tests = test_profile_pcpath_irfs
+%TEST_PROFILE_PCPATH_IRFS Tests for the pure PC-path profiling objective.
+
+tests = functiontests(localfunctions);
+
+end
+
+function setupOnce(testCase)
+
+tests_dir = fileparts(mfilename('fullpath'));
+repo_root = fileparts(tests_dir);
+
+testCase.TestData.original_path = path;
+testCase.TestData.fixture = make_fixture();
+addpath(fullfile(repo_root, '_auxiliary_functions'));
+
+end
+
+function teardownOnce(testCase)
+
+path(testCase.TestData.original_path);
+
+end
+
+function test_matches_manual_macro_only_objective_and_outputs_tail(testCase)
+
+f = testCase.TestData.fixture;
+[md_loss, out] = profile_pcpath_irfs(f.Pi, f.Y, f.R, f.emp, f.cfg);
+
+P_news = f.emp.M_F * f.R(:,1:f.cfg.J_news);
+news_basis = P_news \ f.emp.V_path_model;
+Pi_pc_model = f.Pi(1:f.cfg.L_pi,1:f.cfg.J_news) * news_basis;
+Y_pc_model = f.Y(1:f.cfg.L_y,1:f.cfg.J_news) * news_basis;
+B_model = [Pi_pc_model; Y_pc_model];
+model_target = B_model(:);
+resid = model_target - f.emp.target_pc;
+manual_loss = 0.5 * (resid' * f.emp.Sigma_B_inv * resid);
+rate_pc_full = f.R(:,1:f.cfg.J_news) * news_basis;
+tol = scaled_tolerance([B_model(:); rate_pc_full(:)]);
+
+testCase.verifyEqual(md_loss, manual_loss, 'AbsTol', tol);
+testCase.verifyEqual(out.news_basis, news_basis, 'AbsTol', tol);
+testCase.verifyEqual(out.V_fit, f.emp.V_path_model, 'AbsTol', tol);
+testCase.verifyEqual(out.P_news, P_news, 'AbsTol', tol);
+testCase.verifyEqual(out.Pi_pc_model, Pi_pc_model, 'AbsTol', tol);
+testCase.verifyEqual(out.Y_pc_model, Y_pc_model, 'AbsTol', tol);
+testCase.verifyEqual(out.B_model, B_model, 'AbsTol', tol);
+testCase.verifyEqual(out.model_target, model_target, 'AbsTol', tol);
+testCase.verifyEqual(out.resid, resid, 'AbsTol', tol);
+testCase.verifyEqual(out.md_loss, md_loss, 'AbsTol', tol);
+testCase.verifyEqual(out.rate_pc_full, rate_pc_full, 'AbsTol', tol);
+testCase.verifyEqual(out.rate_tail, rate_pc_full(f.cfg.H_path+1:end,:), ...
+    'AbsTol', tol);
+testCase.verifyEqual(out.rate_after_news, ...
+    rate_pc_full(f.cfg.J_news+1:end,:), 'AbsTol', tol);
+testCase.verifyEqual(out.rate_after_measurement, out.rate_tail, ...
+    'AbsTol', tol);
+testCase.verifyEqual(out.rate_diagnostics.last_news_horizon, ...
+    f.cfg.J_news - 1);
+testCase.verifyEqual( ...
+    out.rate_diagnostics.last_measurement_rate_horizon, ...
+    f.cfg.H_path - 1);
+testCase.verifyGreaterThan(out.weight_rcond, 0);
+testCase.verifyEqual(out.path_diagnostics.P_news, P_news, 'AbsTol', tol);
+
+M = f.cfg.L_pi + f.cfg.L_y;
+testCase.verifySize(out.resid, [M*f.cfg.K_pc, 1]);
+testCase.verifyEqual(out.model_target(1:M), B_model(:,1), 'AbsTol', tol);
+testCase.verifyEqual(out.model_target(M+1:2*M), B_model(:,2), ...
+    'AbsTol', tol);
+
+end
+
+function test_general_measurement_support_defines_rate_tail(testCase)
+
+f = testCase.TestData.fixture;
+[~, base] = profile_pcpath_irfs(f.Pi, f.Y, f.R, f.emp, f.cfg);
+
+emp_general = f.emp;
+emp_general.M_F(4, 6) = 0.35;
+emp_general.V_path_model = ...
+    emp_general.M_F * f.R(:, 1:f.cfg.J_news) * base.news_basis;
+[~, out] = profile_pcpath_irfs( ...
+    f.Pi, f.Y, f.R, emp_general, f.cfg);
+
+testCase.verifyEqual(out.news_basis, base.news_basis, 'AbsTol', 1e-11);
+testCase.verifyEqual( ...
+    out.rate_diagnostics.measurement_support_horizons, [0; 1; 2; 3; 5]);
+testCase.verifyEqual( ...
+    out.rate_diagnostics.last_measurement_rate_horizon, 5);
+testCase.verifyEqual(out.rate_after_news, out.rate_pc_full(5:end, :), ...
+    'AbsTol', 1e-12);
+testCase.verifyEqual(out.rate_after_measurement, ...
+    out.rate_pc_full(7:end, :), 'AbsTol', 1e-12);
+testCase.verifyEqual(out.rate_tail, out.rate_after_measurement, ...
+    'AbsTol', 1e-12);
+
+end
