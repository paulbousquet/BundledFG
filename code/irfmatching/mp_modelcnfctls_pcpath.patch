+function settings = make_settings( ...
+    n_param, N_draws, N_burn, N_keep, keep_every, N_adapt)
+
+settings = struct();
+settings.N_draws = N_draws;
+settings.N_burn = N_burn;
+settings.N_keep = N_keep;
+settings.keep_every = keep_every;
+settings.N_adapt = N_adapt;
+settings.lower_bound = -10 * ones(n_param, 1);
+settings.upper_bound = 10 * ones(n_param, 1);
+
+end
+
+function [objective, out] = synthetic_objective(param)
+
+param = param(:);
+if numel(param) > 1
+    other_penalty = 0.25 * sum(param(2:end).^2);
+else
+    other_penalty = 0;
+end
+objective = (param(1) - 1)^2 + other_penalty;
+out = profile_from_param(param);
+
+end
+
+function [objective, out] = guarded_objective(param)
+
+param = param(:);
+if param(1) > 0.5
+    objective = Inf;
+    out = struct();
+    out.admissible = false;
+    out.failure_identifier = 'synthetic:Inadmissible';
+    out.failure_message = 'Synthetic returned inadmissibility.';
+    return
+end
+objective = sum(param.^2);
+out = profile_from_param(param);
+
+end
+
+function [objective, out] = throwing_objective(param)
+
+param = param(:);
+if param(1) > 0.4
+    error('synthetic:UnexpectedFailure', ...
+        'Synthetic unexpected objective failure.');
+end
+objective = sum(param.^2);
+out = profile_from_param(param);
+
+end
+
+function [objective, out] = numerically_fragile_objective(param)
+
+param = param(:);
+if param(1) > 0.75
+    error('profile_pcpath_irfs:NonfiniteLoss', ...
+        'Synthetic numerical overflow at a feasible proposal.');
+end
+objective = sum(param.^2);
+out = profile_from_param(param);
+
+end
+
+function [objective, out] = extreme_objective(param)
+
+param = param(:);
+if param(1) < 0
+    objective = 1e308;
+else
+    objective = -1e308;
+end
+out = profile_from_param(param);
+
+end
+
+function [objective, out] = quadratic_objective(param)
+
+param = param(:);
+objective = sum(param.^2);
+out = profile_from_param(param);
+
+end
+
+function [objective, out] = zero_rcond_objective(param)
+
+[objective, out] = quadratic_objective(param);
+out.path_diagnostics.rcond = 0;
+
+end
+
+function [objective, out] = negative_path_error_objective(param)
+
+[objective, out] = quadratic_objective(param);
+out.path_diagnostics.max_abs_path_error = -eps;
+
+end
+
+function [objective, out] = missing_path_error_objective(param)
+
+[objective, out] = quadratic_objective(param);
+out.path_diagnostics = rmfield( ...
+    out.path_diagnostics, 'max_abs_path_error');
+
+end
+
+function [objective, out] = nonfinite_path_error_objective(param)
+
+[objective, out] = quadratic_objective(param);
+out.path_diagnostics.max_abs_path_error = NaN;
+
+end
+
+function out = profile_from_param(param)
+
+param = param(:);
+p1 = param(1);
+if numel(param) >= 2
+    p2 = param(2);
+else
+    p2 = 0;
+end
+if numel(param) >= 3
+    p3 = param(3);
+else
+    p3 = 0;
+end
+
+out = struct();
+out.admissible = true;
+out.failure_identifier = '';
+out.failure_message = '';
+out.news_basis = [1 + p1,       0.25 + p2;
+                  p1 - p3, 1 + 0.10 * p1 * (p2 + p3)];
+out.Pi_pc_model = [p1, p2 + p3;
+                   p1^2 + 0.2, 1 + p3^2];
+out.Y_pc_model = [p1 + p2, p3 - p1];
+rate_base = reshape(1:10, 5, 2) / 20;
+out.rate_pc_full = rate_base + ...
+    p1 * [ones(5, 1), zeros(5, 1)] + ...
+    (p2 + p3) * [zeros(5, 1), ones(5, 1)];
+out.rate_tail = out.rate_pc_full(4:5, :);
+out.path_diagnostics = struct();
+out.path_diagnostics.rcond = 1 / (1 + norm(param));
+out.path_diagnostics.max_abs_path_error = 1e-12 * ...
+    (1 + abs(p1) + 2 * abs(p2) + 3 * abs(p3));
+out.path_diagnostics.singular_values = ...
+    [2 + abs(p1); 1 + abs(p2 + p3)];
+out.path_diagnostics.news_norms = ...
+    sqrt(sum(out.news_basis.^2, 1));
+
+end
+
+function verify_stored_profile(testCase, result, index, expected)
+
+tol = 1e-13;
+testCase.verifyEqual(result.news_basis_draws(:, :, index), ...
+    expected.news_basis, 'AbsTol', tol);
+testCase.verifyEqual(result.Pi_pc_draws(:, :, index), ...
+    expected.Pi_pc_model, 'AbsTol', tol);
+testCase.verifyEqual(result.Y_pc_draws(:, :, index), ...
+    expected.Y_pc_model, 'AbsTol', tol);
+testCase.verifyEqual(result.rate_pc_full_draws(:, :, index), ...
+    expected.rate_pc_full, 'AbsTol', tol);
+testCase.verifyEqual(result.rate_tail_draws(:, :, index), ...
+    expected.rate_tail, 'AbsTol', tol);
+testCase.verifyEqual(result.rcond_draws(index), ...
+    expected.path_diagnostics.rcond, 'AbsTol', tol);
+testCase.verifyEqual(result.max_abs_path_error_draws(index), ...
+    expected.path_diagnostics.max_abs_path_error, 'AbsTol', tol);
