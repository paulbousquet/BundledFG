+function out = finite_difference_path_jacobians( ...
+    moment_handle, param0, parameter_scale, lower_bound, upper_bound, options)
+%FINITE_DIFFERENCE_PATH_JACOBIANS Centered two-step identification Jacobians.
+
+if nargin < 6 || isempty(options)
+    options = struct();
+end
+options = normalize_options(options);
+validate_vector(param0, 'param0');
+validate_vector(parameter_scale, 'parameter_scale');
+validate_vector(lower_bound, 'lower_bound');
+validate_vector(upper_bound, 'upper_bound');
+n_param = numel(param0);
+if any([numel(parameter_scale), numel(lower_bound), numel(upper_bound)] ...
+        ~= n_param)
+    error('finite_difference_path_jacobians:DimensionMismatch', ...
+        'All parameter vectors must have the same length.');
+end
+param0 = param0(:);
+parameter_scale = parameter_scale(:);
+lower_bound = lower_bound(:);
+upper_bound = upper_bound(:);
+if any(parameter_scale <= 0) || any(lower_bound >= upper_bound) || ...
+        any(param0 <= lower_bound) || any(param0 >= upper_bound)
+    error('finite_difference_path_jacobians:InvalidParameters', ...
+        'Scales must be positive and param0 must be strictly inside its bounds.');
+end
+
+baseline = moment_handle(param0');
+validate_moments(baseline);
+n_h3 = numel(baseline.m_h3);
+n_pc = numel(baseline.m_pc);
+D_h3_full = zeros(n_h3, n_param);
+D_pc_full = zeros(n_pc, n_param);
+D_h3_half = zeros(n_h3, n_param);
+D_pc_half = zeros(n_pc, n_param);
+full_steps = options.StepFraction * parameter_scale;
+half_steps = options.HalfStepRatio * full_steps;
+evaluation_count = 1;
+
+for i_param = 1:n_param
+    [D_h3_full(:, i_param), D_pc_full(:, i_param), count_full] = ...
+        derivative_at_step(i_param, full_steps(i_param));
+    [D_h3_half(:, i_param), D_pc_half(:, i_param), count_half] = ...
+        derivative_at_step(i_param, half_steps(i_param));
+    evaluation_count = evaluation_count + count_full + count_half;
+end
+
+relative_difference_h3 = column_relative_difference( ...
+    D_h3_full, D_h3_half);
+relative_difference_pc = column_relative_difference( ...
+    D_pc_full, D_pc_half);
+reliable = max(relative_difference_h3, relative_difference_pc) <= ...
+    options.ReliabilityTolerance;
+
+out = struct();
+out.baseline = baseline;
+out.D_h3 = D_h3_half;
+out.D_pc = D_pc_half;
+out.D_h3_full_step = D_h3_full;
+out.D_pc_full_step = D_pc_full;
+out.full_steps = full_steps;
+out.half_steps = half_steps;
+out.relative_difference_h3 = relative_difference_h3;
+out.relative_difference_pc = relative_difference_pc;
+out.reliable = reliable;
+out.all_reliable = all(reliable);
+out.evaluation_count = evaluation_count;
+out.options = options;
+
+    function [derivative_h3, derivative_pc, count] = ...
+            derivative_at_step(index, step)
+        can_move_down = param0(index) - step > lower_bound(index);
+        can_move_up = param0(index) + step < upper_bound(index);
+        if can_move_down && can_move_up
+            param_plus = param0;
+            param_minus = param0;
+            param_plus(index) = param_plus(index) + step;
+            param_minus(index) = param_minus(index) - step;
+            moments_plus = moment_handle(param_plus');
+            moments_minus = moment_handle(param_minus');
+            validate_moments(moments_plus);
+            validate_moments(moments_minus);
+            derivative_h3 = (moments_plus.m_h3 - moments_minus.m_h3) / ...
+                (2 * step);
+            derivative_pc = (moments_plus.m_pc - moments_minus.m_pc) / ...
+                (2 * step);
+            count = 2;
+        elseif can_move_up
+            param_plus = param0;
+            param_plus(index) = param_plus(index) + step;
+            moments_plus = moment_handle(param_plus');
+            derivative_h3 = (moments_plus.m_h3 - baseline.m_h3) / step;
+            derivative_pc = (moments_plus.m_pc - baseline.m_pc) / step;
+            count = 1;
+        elseif can_move_down
+            param_minus = param0;
+            param_minus(index) = param_minus(index) - step;
+            moments_minus = moment_handle(param_minus');
+            derivative_h3 = (baseline.m_h3 - moments_minus.m_h3) / step;
+            derivative_pc = (baseline.m_pc - moments_minus.m_pc) / step;
+            count = 1;
+        else
+            error('finite_difference_path_jacobians:StepOutsideBounds', ...
+                'No feasible derivative step for parameter %d.', index);
+        end
+    end
+
+end
+
+function relative_difference = column_relative_difference(first, second)
+
+n_column = size(first, 2);
+relative_difference = zeros(n_column, 1);
+for i_column = 1:n_column
+    denominator = max([norm(second(:, i_column)), ...
+        norm(first(:, i_column)), 1e-12]);
+    relative_difference(i_column) = ...
+        norm(second(:, i_column) - first(:, i_column)) / denominator;
+end
+
+end
+
+function validate_moments(value)
+
+if ~isstruct(value) || ~isscalar(value) || ...
+        ~all(isfield(value, {'m_h3', 'm_pc'})) || ...
+        any(~isfinite(value.m_h3(:))) || any(~isfinite(value.m_pc(:)))
+    error('finite_difference_path_jacobians:InvalidMoments', ...
+        'moment_handle must return finite m_h3 and m_pc fields.');
+end
+
+end
+
+function validate_vector(value, name)
+
+if ~isnumeric(value) || ~isfloat(value) || ~isreal(value) || ...
+        ~isvector(value) || isempty(value) || any(~isfinite(value(:)))
+    error('finite_difference_path_jacobians:InvalidInput', ...
+        '%s must be a nonempty finite real floating-point vector.', name);
+end
+
+end
+
+function options = normalize_options(options)
+
+defaults = struct( ...
+    'StepFraction', 2e-4, ...
+    'HalfStepRatio', 0.5, ...
+    'ReliabilityTolerance', 0.02);
+if ~isstruct(options) || ~isscalar(options)
+    error('finite_difference_path_jacobians:InvalidOptions', ...
+        'options must be a scalar struct.');
+end
+names = fieldnames(defaults);
+unknown = setdiff(fieldnames(options), names);
+if ~isempty(unknown)
+    error('finite_difference_path_jacobians:InvalidOptions', ...
+        'Unknown option ''%s''.', unknown{1});
+end
+for i_name = 1:numel(names)
+    name = names{i_name};
+    if ~isfield(options, name) || isempty(options.(name))
+        options.(name) = defaults.(name);
+    end
+    value = options.(name);
+    if ~isnumeric(value) || ~isreal(value) || ~isscalar(value) || ...
+            ~isfinite(value) || value <= 0
+        error('finite_difference_path_jacobians:InvalidOptions', ...
+            '%s must be a finite positive scalar.', name);
+    end
+end
+if options.HalfStepRatio >= 1
+    error('finite_difference_path_jacobians:InvalidOptions', ...
+        'HalfStepRatio must be strictly less than one.');
+end
+
+end
diff --git a/_auxiliary_functions/get_empirical_pc_targets.m b/_auxiliary_functions/get_empirical_pc_targets.m
new file mode 100644
index 0000000..73b5319
--- /dev/null
+++ b/_auxiliary_functions/get_empirical_pc_targets.m
@@ -0,0 +1,426 @@
+function emp = get_empirical_pc_targets(data_source, cfg)
+%GET_EMPIRICAL_PC_TARGETS Load and validate exact PCA/LP matching objects.
+%
+% EMP = GET_EMPIRICAL_PC_TARGETS(DATA_SOURCE, CFG) accepts either a MAT-file
+% path or a scalar struct. The source must contain exact, consistently
+% normalized empirical objects; this function does not construct targets
+% from rounded PCA loadings or substitute legacy impulse responses.
+%
+% Required source fields are V_path_model, B_pi_emp, B_y_emp, h_path,
+% metadata, and at least one of Sigma_B or Sigma_B_inv. Required CFG fields
+% are H_path, K_pc, L_pi, L_y, and T_model. M_F may be supplied by either
+% source. If neither supplies it, CFG.allow_identity_M_F must explicitly be
+% true before the point-rate identity selector is used.
+
+if nargin ~= 2
+    error('get_empirical_pc_targets:InvalidInput', ...
+        'Exactly two inputs, data_source and cfg, are required.');
+end
+
+validate_config(cfg);
+source = read_data_source(data_source);
+
+required_fields = {'V_path_model', 'B_pi_emp', 'B_y_emp', ...
+    'h_path', 'metadata'};
+require_fields(source, required_fields, ...
+    'get_empirical_pc_targets:MissingField', 'data source');
+
+validate_finite_matrix(source.V_path_model, 'V_path_model');
+validate_size(source.V_path_model, [cfg.H_path, cfg.K_pc], ...
+    'V_path_model');
+path_singular_values = svd(double(source.V_path_model), 'econ');
+path_rank_tolerance = max(size(source.V_path_model)) * ...
+    eps(max(path_singular_values));
+if sum(path_singular_values > path_rank_tolerance) < cfg.K_pc
+    error('get_empirical_pc_targets:RankDeficientPathTargets', ...
+        ['V_path_model must have numerical column rank K_pc=%d; ' ...
+         'the supplied PC paths are linearly dependent.'], cfg.K_pc);
+end
+
+validate_finite_matrix(source.B_pi_emp, 'B_pi_emp');
+validate_size(source.B_pi_emp, [cfg.L_pi, cfg.K_pc], 'B_pi_emp');
+validate_finite_matrix(source.B_y_emp, 'B_y_emp');
+validate_size(source.B_y_emp, [cfg.L_y, cfg.K_pc], 'B_y_emp');
+
+validate_horizons(source.h_path, cfg.H_path);
+validate_metadata(source.metadata);
+
+% Canonical macro stacking: rows are [inflation; output], while MATLAB's
+% column-major vectorization stacks all rows for PC1, then PC2, and so on.
+B_emp = [source.B_pi_emp; source.B_y_emp];
+target_pc = B_emp(:);
+if isfield(source, 'B_emp')
+    validate_finite_matrix(source.B_emp, 'B_emp');
+    validate_size(source.B_emp, size(B_emp), 'B_emp');
+    require_consistency(source.B_emp, B_emp, 'B_emp', 1e-12, ...
+        'get_empirical_pc_targets:InconsistentTarget');
+end
+if isfield(source, 'target_pc')
+    validate_target_vector(source.target_pc, numel(target_pc));
+    require_consistency(source.target_pc, target_pc, 'target_pc', 1e-12, ...
+        'get_empirical_pc_targets:InconsistentTarget');
+end
+
+n_target = numel(target_pc);
+has_covariance = isfield(source, 'Sigma_B') && ~isempty(source.Sigma_B);
+has_precision = isfield(source, 'Sigma_B_inv') && ...
+    ~isempty(source.Sigma_B_inv);
+if ~has_covariance && ~has_precision
+    error('get_empirical_pc_targets:MissingCovariance', ...
+        ['The data source must contain a nonempty Sigma_B or ' ...
+         'Sigma_B_inv.']);
+end
+
+if has_covariance
+    [Sigma_B, covariance_chol, covariance_rcond] = validate_spd_matrix( ...
+        source.Sigma_B, n_target, 'Sigma_B');
+    Sigma_B_inv_from_covariance = invert_from_cholesky( ...
+        covariance_chol, n_target, 'Sigma_B');
+    [Sigma_B_inv_from_covariance, precision_chol_from_covariance, ...
+        precision_rcond_from_covariance] = validate_spd_matrix( ...
+        Sigma_B_inv_from_covariance, n_target, ...
+        'Sigma_B_inv derived from Sigma_B');
+end
+if has_precision
+    [Sigma_B_inv, precision_chol, precision_rcond] = validate_spd_matrix( ...
+        source.Sigma_B_inv, n_target, 'Sigma_B_inv');
+end
+if has_covariance && has_precision
+    require_consistency(Sigma_B_inv, Sigma_B_inv_from_covariance, ...
+        'Sigma_B and Sigma_B_inv', 1e-8, ...
+        'get_empirical_pc_targets:InconsistentCovariance');
+elseif has_covariance
+    Sigma_B_inv = Sigma_B_inv_from_covariance;
+    precision_chol = precision_chol_from_covariance;
+    precision_rcond = precision_rcond_from_covariance;
+end
+
+M_F = reconcile_measurement_matrix(source, cfg);
+
+% Start from the loaded struct so exact raw loadings, scores, bootstrap
+% draws, hashes, and other provenance fields survive unchanged.
+emp = source;
+emp.B_emp = B_emp;
+emp.target_pc = target_pc;
+if has_covariance
+    emp.Sigma_B = Sigma_B;
+    emp.Sigma_B_chol = covariance_chol;
+    emp.Sigma_B_rcond = covariance_rcond;
+end
+emp.Sigma_B_inv = Sigma_B_inv;
+emp.Sigma_B_inv_chol = precision_chol;
+emp.Sigma_B_inv_rcond = precision_rcond;
+emp.M_F = M_F;
+emp.H_path = cfg.H_path;
+emp.K_pc = cfg.K_pc;
+emp.L_pi = cfg.L_pi;
+emp.L_y = cfg.L_y;
+emp.T_model = cfg.T_model;
+
+end
+
+function validate_metadata(metadata)
+
+if ~isstruct(metadata) || ~isscalar(metadata)
+    error('get_empirical_pc_targets:InvalidMetadata', ...
+        'metadata must be a scalar struct.');
+end
+
+required_fields = { ...
+    'schema_version', ...
+    'source_provenance', ...
+    'pca_reconstruction', ...
+    'score_normalization', ...
+    'rate_unit_conversion', ...
+    'contract_measurement', ...
+    'target_order', ...
+    'covariance_provenance'};
+require_fields(metadata, required_fields, ...
+    'get_empirical_pc_targets:InvalidMetadata', 'metadata');
+
+for i_field = 1:numel(required_fields)
+    field_name = required_fields{i_field};
+    value = metadata.(field_name);
+    if isstring(value) && isscalar(value)
+        value = char(value);
+    end
+    if ~ischar(value) || ~isrow(value) || isempty(strtrim(value))
+        error('get_empirical_pc_targets:InvalidMetadata', ...
+            'metadata.%s must be nonempty text.', field_name);
+    end
+end
+
+if ~strcmp(char(metadata.schema_version), 'pcpaths-v1')
+    error('get_empirical_pc_targets:UnsupportedMetadataSchema', ...
+        ['metadata.schema_version must be ''pcpaths-v1''; ' ...
+         'received ''%s''.'], char(metadata.schema_version));
+end
+canonical_order = 'pc-major:[inflation;output]';
+if ~strcmp(char(metadata.target_order), canonical_order)
+    error('get_empirical_pc_targets:InvalidMetadata', ...
+        ['metadata.target_order must be ''%s'' so Sigma_B and target_pc ' ...
+         'share the canonical vectorization contract.'], canonical_order);
+end
+
+end
+
+function source = read_data_source(data_source)
+
+if isstruct(data_source)
+    if ~isscalar(data_source)
+        error('get_empirical_pc_targets:InvalidDataSource', ...
+            'A struct data_source must be scalar.');
+    end
+    source = data_source;
+    return
+end
+
+is_character_path = ischar(data_source) && isrow(data_source);
+is_string_path = isstring(data_source) && isscalar(data_source);
+if ~(is_character_path || is_string_path)
+    error('get_empirical_pc_targets:InvalidDataSource', ...
+        'data_source must be a MAT-file path or a scalar struct.');
+end
+
+data_path = char(data_source);
+if isempty(strtrim(data_path))
+    error('get_empirical_pc_targets:InvalidDataSource', ...
+        'The MAT-file path must not be empty.');
+end
+if exist(data_path, 'file') ~= 2
+    error('get_empirical_pc_targets:FileNotFound', ...
+        'Empirical target file not found: %s', data_path);
+end
+
+try
+    source = load(data_path);
+catch load_error
+    error('get_empirical_pc_targets:LoadFailed', ...
+        'Could not load empirical target file %s: %s', ...
+        data_path, load_error.message);
+end
+if ~isstruct(source) || ~isscalar(source)
+    error('get_empirical_pc_targets:InvalidDataSource', ...
+        'Loading data_source must produce a scalar struct.');
+end
+
+end
+
+function validate_config(cfg)
+
+if ~isstruct(cfg) || ~isscalar(cfg)
+    error('get_empirical_pc_targets:InvalidConfig', ...
+        'cfg must be a scalar struct.');
+end
+
+required_fields = {'H_path', 'K_pc', 'L_pi', 'L_y', 'T_model'};
+require_fields(cfg, required_fields, ...
+    'get_empirical_pc_targets:InvalidConfig', 'cfg');
+for i_field = 1:numel(required_fields)
+    validate_positive_integer(cfg.(required_fields{i_field}), ...
+        required_fields{i_field});
+end
+
+if cfg.K_pc > cfg.H_path
+    error('get_empirical_pc_targets:InvalidConfig', ...
+        'cfg.K_pc=%d cannot exceed cfg.H_path=%d.', ...
+        cfg.K_pc, cfg.H_path);
+end
+minimum_model_length = max([cfg.H_path, cfg.L_pi, cfg.L_y]);
+if cfg.T_model < minimum_model_length
+    error('get_empirical_pc_targets:InvalidConfig', ...
+        'cfg.T_model=%d must be at least max(H_path,L_pi,L_y)=%d.', ...
+        cfg.T_model, minimum_model_length);
+end
+
+if isfield(cfg, 'allow_identity_M_F') && ...
+        ~isempty(cfg.allow_identity_M_F)
+    validate_binary_scalar(cfg.allow_identity_M_F, ...
+        'allow_identity_M_F');
+end
+
+end
+
+function M_F = reconcile_measurement_matrix(source, cfg)
+
+source_has_M_F = isfield(source, 'M_F') && ~isempty(source.M_F);
+cfg_has_M_F = isfield(cfg, 'M_F') && ~isempty(cfg.M_F);
+expected_size = [cfg.H_path, cfg.T_model];
+
+if source_has_M_F
+    validate_finite_matrix(source.M_F, 'data-source M_F');
+    validate_size(source.M_F, expected_size, 'data-source M_F');
+end
+if cfg_has_M_F
+    validate_finite_matrix(cfg.M_F, 'cfg.M_F');
+    validate_size(cfg.M_F, expected_size, 'cfg.M_F');
+end
+
+if source_has_M_F && cfg_has_M_F
+    require_consistency(source.M_F, cfg.M_F, ...
+        'data-source M_F and cfg.M_F', 1e-12, ...
+        'get_empirical_pc_targets:InconsistentMeasurementMatrix');
+    M_F = source.M_F;
+elseif source_has_M_F
+    M_F = source.M_F;
+elseif cfg_has_M_F
+    M_F = cfg.M_F;
+else
+    allow_identity = false;
+    if isfield(cfg, 'allow_identity_M_F') && ...
+            ~isempty(cfg.allow_identity_M_F)
+        allow_identity = logical(cfg.allow_identity_M_F);
+    end
+    if ~allow_identity
+        error('get_empirical_pc_targets:MissingMeasurementMatrix', ...
+            ['M_F is absent from both the data source and cfg. Set ' ...
+             'cfg.allow_identity_M_F=true only to make the explicit ' ...
+             'point-rate identity-selector assumption.']);
+    end
+    M_F = [eye(cfg.H_path), ...
+        zeros(cfg.H_path, cfg.T_model - cfg.H_path)];
+end
+
+end
+
+function validate_horizons(h_path, H_path)
+
+validate_finite_matrix(h_path, 'h_path');
+if ~iscolumn(h_path) || numel(h_path) ~= H_path
+    error('get_empirical_pc_targets:DimensionMismatch', ...
+        'h_path must be an H_path-by-1 column vector (%d-by-1).', H_path);
+end
+expected_horizons = (0:(H_path - 1))';
+if any(double(h_path) ~= expected_horizons)
+    error('get_empirical_pc_targets:InvalidHorizons', ...
+        'h_path must equal (0:H_path-1)'' exactly.');
+end
+
+end
+
+function validate_target_vector(value, expected_length)
+
+validate_finite_matrix(value, 'target_pc');
+if ~iscolumn(value) || numel(value) ~= expected_length
+    error('get_empirical_pc_targets:DimensionMismatch', ...
+        'target_pc must be a %d-by-1 column vector.', expected_length);
+end
+
+end
+
+function [symmetric_value, lower_factor, reciprocal_condition] = ...
+    validate_spd_matrix( ...
+    value, expected_size, name)
+
+validate_finite_matrix(value, name);
+validate_size(value, [expected_size, expected_size], name);
+
+symmetry_error = norm(value - value', 'fro');
+symmetry_tolerance = 1e-10 * max(1, norm(value, 'fro'));
+if symmetry_error > symmetry_tolerance
+    error('get_empirical_pc_targets:InvalidCovariance', ...
+        ['%s must be symmetric. Symmetry error=%g exceeds ' ...
+         'tolerance=%g.'], name, symmetry_error, symmetry_tolerance);
+end
+
+symmetric_value = (value + value') / 2;
+[lower_factor, chol_status] = chol(symmetric_value, 'lower');
+if chol_status ~= 0
+    error('get_empirical_pc_targets:InvalidCovariance', ...
+        '%s must be positive definite.', name);
+end
+reciprocal_condition = rcond(symmetric_value);
+if ~isfinite(reciprocal_condition) || reciprocal_condition <= 0
+    error('get_empirical_pc_targets:InvalidCovariance', ...
+        '%s is numerically singular (rcond=%g).', ...
+        name, reciprocal_condition);
+end
+
+end
+
+function inverse_value = invert_from_cholesky( ...
+    lower_factor, matrix_size, source_name)
+
+identity_matrix = eye(matrix_size, class(lower_factor));
+inverse_value = lower_factor' \ (lower_factor \ identity_matrix);
+inverse_value = (inverse_value + inverse_value') / 2;
+if any(~isfinite(inverse_value(:)))
+    error('get_empirical_pc_targets:InvalidCovariance', ...
+        'The Cholesky solve for %s produced NaN or Inf values.', ...
+        source_name);
+end
+
+end
+
+function require_consistency(value, reference, name, tolerance_scale, error_id)
+
+difference = norm(value - reference, 'fro');
+reference_scale = max([1, norm(value, 'fro'), norm(reference, 'fro')]);
+tolerance = tolerance_scale * reference_scale;
+if difference > tolerance
+    error(error_id, ...
+        ['Supplied %s is inconsistent with the canonical value. ' ...
+         'Difference=%g exceeds tolerance=%g.'], ...
+        name, difference, tolerance);
+end
+
+end
+
+function validate_size(value, expected_size, name)
+
+if ~isequal(size(value), expected_size)
+    error('get_empirical_pc_targets:DimensionMismatch', ...
+        '%s must be %d-by-%d; received %d-by-%d.', ...
+        name, expected_size(1), expected_size(2), ...
+        size(value, 1), size(value, 2));
+end
+
+end
+
+function validate_finite_matrix(value, name)
+
+if ~isnumeric(value) || ~isfloat(value) || ~isreal(value) || ...
+        ~ismatrix(value) || isempty(value)
+    error('get_empirical_pc_targets:InvalidData', ...
+        '%s must be a nonempty, real floating-point matrix.', name);
+end
+if any(~isfinite(value(:)))
+    error('get_empirical_pc_targets:InvalidData', ...
+        '%s contains NaN or Inf values.', name);
+end
+
+end
+
+function validate_positive_integer(value, name)
+
+if ~isnumeric(value) || ~isreal(value) || ~isscalar(value) || ...
+        ~isfinite(value) || value <= 0 || value ~= fix(value)
+    error('get_empirical_pc_targets:InvalidConfig', ...
+        'cfg.%s must be a finite positive integer scalar.', name);
+end
+
+end
+
+function validate_binary_scalar(value, name)
+
+is_logical_scalar = islogical(value) && isscalar(value);
+is_binary_numeric = isnumeric(value) && isreal(value) && ...
+    isscalar(value) && isfinite(value) && (value == 0 || value == 1);
+if ~(is_logical_scalar || is_binary_numeric)
+    error('get_empirical_pc_targets:InvalidConfig', ...
+        'cfg.%s must be a scalar logical or numeric zero/one.', name);
+end
+
+end
+
+function require_fields(value, field_names, error_id, struct_name)
+
+for i_field = 1:numel(field_names)
+    field_name = field_names{i_field};
+    if ~isfield(value, field_name)
+        error(error_id, '%s is missing required field ''%s''.', ...
+            struct_name, field_name);
+    end
+end
+
+end
diff --git a/_auxiliary_functions/get_empirical_v_n174.m b/_auxiliary_functions/get_empirical_v_n174.m
new file mode 100644
index 0000000..d77b6c5
--- /dev/null
+++ b/_auxiliary_functions/get_empirical_v_n174.m
@@ -0,0 +1,64 @@
+function design = get_empirical_v_n174(T_model)
+%GET_EMPIRICAL_V_N174 Frozen two-PC FF2/ED2-ED8 path design.
+%
+% DESIGN = GET_EMPIRICAL_V_N174(T_MODEL) returns the exact raw-contract
+% loading matrix V, score covariance, and the known contract-to-quarter
+% selection matrix. Contract row j corresponds to model quarter j-1.
+
+if nargin < 1 || isempty(T_model)
+    T_model = 8;
+end
+if ~isnumeric(T_model) || ~isreal(T_model) || ~isscalar(T_model) || ...
+        ~isfinite(T_model) || T_model < 8 || T_model ~= fix(T_model)
+    error('get_empirical_v_n174:InvalidHorizon', ...
+        'T_model must be a finite integer greater than or equal to eight.');
+end
+
+contract_labels = ["FF2"; "ED2"; "ED3"; "ED4"; ...
+    "ED5"; "ED6"; "ED7"; "ED8"];
+contract_standard_deviations = [ ...
+    0.061957457072553; ...
+    0.078151653862559; ...
+    0.086757262560638; ...
+    0.088801492415157; ...
+    0.090563338927930; ...
+    0.089411630655409; ...
+    0.085755771712437; ...
+    0.084908431137473];
+standardized_eigenvectors = [ ...
+     0.210288913413718,  0.875326157912900; ...
+     0.354879848443269,  0.280434559823092; ...
+     0.374344624221295,  0.081475073791727; ...
+     0.372826361654720, -0.116002230596633; ...
+     0.376268275368575, -0.152051531370801; ...
+     0.373598000306016, -0.178957681407913; ...
+     0.369772644647738, -0.200385995669873; ...
+     0.364445308413764, -0.199413646949749];
+score_variances = [6.884493854947044; 0.8757776096042114];
+
+design = struct();
+design.V_path_model = diag(contract_standard_deviations) * ...
+    standardized_eigenvectors;
+design.Sigma_f = diag(score_variances);
+design.M_F = [eye(8), zeros(8, T_model - 8)];
+design.contract_labels = contract_labels;
+design.contract_horizons = (0:7)';
+design.sample_size = 174;
+design.sample_start = '1994-02-04';
+design.sample_end = '2026-04-29';
+design.sample_filter = ['Date >= 1993-01-01, abs(ED2) > 0.01, and complete ' ...
+    'FF2/ED2-ED8 observations'];
+design.pca_implementation = ['sklearn StandardScaler(ddof=0), followed by ' ...
+    'PCA(n_components=2, svd_solver=full)'];
+design.source_file = 'jk_source_classified_with_pc1.csv';
+design.source_sha256 = ...
+    'e939c0abda019ba8828ddee42dd87e738dfc4529505e210231de197461989101';
+design.contract_standard_deviations = contract_standard_deviations;
+design.standardized_eigenvectors = standardized_eigenvectors;
+design.score_variances = score_variances;
+design.raw_loading_formula = ...
+    'V = diag(contract_standard_deviations) * standardized_eigenvectors';
+design.measurement_definition = ...
+    'Contract row j is model quarter H=j-1, so M_F=[I_8,0].';
+
+end
diff --git a/_auxiliary_functions/get_pcpath_parameter_bounds.m b/_auxiliary_functions/get_pcpath_parameter_bounds.m
new file mode 100644
index 0000000..8271f25
--- /dev/null
+++ b/_auxiliary_functions/get_pcpath_parameter_bounds.m
@@ -0,0 +1,18 @@
+function [lower_bound, upper_bound] = get_pcpath_parameter_bounds(n_param)
+%GET_PCPATH_PARAMETER_BOUNDS Shared default support for mode and sampling.
+%
+% The seven- and nine-parameter specifications use the same support in the
+% posterior-mode and MH drivers. Parameter 6 has positive unbounded support;
+% all other parameters lie in [0, 1-1e-13]. Outputs are column vectors.
+
+if ~isnumeric(n_param) || ~isreal(n_param) || ~isscalar(n_param) || ...
+        ~isfinite(n_param) || ~ismember(n_param, [7, 9])
+    error('get_pcpath_parameter_bounds:InvalidParameterCount', ...
+        'n_param must be exactly 7 or 9.');
+end
+
+lower_bound = zeros(n_param, 1);
+upper_bound = (1 - 1e-13) * ones(n_param, 1);
+upper_bound(6) = Inf;
+
+end
diff --git a/_auxiliary_functions/map_paths_to_news.m b/_auxiliary_functions/map_paths_to_news.m
new file mode 100644
index 0000000..9ab186b
--- /dev/null
+++ b/_auxiliary_functions/map_paths_to_news.m
@@ -0,0 +1,199 @@
+function [news_basis, path_fit, diagnostics] = map_paths_to_news( ...
+    R_news, V_path_model, M_F, H_path, J_news, options)
+%MAP_PATHS_TO_NEWS Map empirical policy paths into current/news wedges.
+%
+% Locked contract for the exact square baseline:
+%   P_news = M_F * R_news(:,1:J_news)
+%   news_basis = P_news \ V_path_model
+% Macro outcomes must never enter this function.
+
+if nargin < 6 || isempty(options)
+    options = struct();
+end
+options = normalize_options(options);
+
+validate_finite_matrix(R_news, 'R_news');
+validate_finite_matrix(V_path_model, 'V_path_model');
+validate_finite_matrix(M_F, 'M_F');
+validate_positive_integer(H_path, 'H_path');
+validate_positive_integer(J_news, 'J_news');
+
+if H_path ~= J_news
+    error('map_paths_to_news:NonSquareSystem', ...
+        ['Exact path matching requires H_path == J_news. Received ' ...
+         'H_path=%d and J_news=%d.'], H_path, J_news);
+end
+if size(V_path_model, 1) ~= H_path
+    error('map_paths_to_news:DimensionMismatch', ...
+        'V_path_model must have H_path=%d rows; received %d.', ...
+        H_path, size(V_path_model, 1));
+end
+if size(M_F, 1) ~= H_path
+    error('map_paths_to_news:DimensionMismatch', ...
+        'M_F must have H_path=%d rows; received %d.', ...
+        H_path, size(M_F, 1));
+end
+if size(M_F, 2) ~= size(R_news, 1)
+    error('map_paths_to_news:DimensionMismatch', ...
+        ['M_F must have one column per row of R_news. Received size(M_F,2)=%d ' ...
+         'and size(R_news,1)=%d.'], size(M_F, 2), size(R_news, 1));
+end
+if J_news > size(R_news, 2)
+    error('map_paths_to_news:DimensionMismatch', ...
+        'J_news=%d exceeds the %d columns available in R_news.', ...
+        J_news, size(R_news, 2));
+end
+
+% This is the only block used to select the implementing news shocks.
+P_news = full(M_F * R_news(:, 1:J_news));
+if any(~isfinite(P_news(:)))
+    error('map_paths_to_news:NonfinitePolicyPathJacobian', ...
+        'The policy-path Jacobian contains NaN or Inf values.');
+end
+
+reciprocal_condition = rcond(P_news);
+if ~isfinite(reciprocal_condition) || ...
+        reciprocal_condition <= options.rcond_fail
+    error('map_paths_to_news:SingularPolicyPathJacobian', ...
+        ['The policy-path Jacobian is singular or too ill-conditioned for ' ...
+         'exact inversion: rcond=%g, failure threshold=%g.'], ...
+        reciprocal_condition, options.rcond_fail);
+end
+
+is_ill_conditioned = reciprocal_condition < options.rcond_warn;
+if is_ill_conditioned && options.emit_warning
+    warning('map_paths_to_news:IllConditionedPolicyPathJacobian', ...
+        'The policy-path Jacobian is ill-conditioned: rcond=%g.', ...
+        reciprocal_condition);
+end
+
+% Solve all empirical PC loading paths as simultaneous right-hand sides.
+% Do not replace this operation with inv or pinv.
+news_basis = P_news \ V_path_model;
+if any(~isfinite(news_basis(:)))
+    error('map_paths_to_news:NonfiniteNewsBasis', ...
+        'The recovered news-shock basis contains NaN or Inf values.');
+end
+
+path_fit = P_news * news_basis;
+path_error = path_fit - V_path_model;
+max_abs_path_error = max(abs(path_error(:)));
+path_tolerance = options.path_tol_abs + ...
+    options.path_tol_rel * max(abs(V_path_model(:)));
+if max_abs_path_error > path_tolerance
+    error('map_paths_to_news:PathReconstructionFailed', ...
+        ['Exact policy-path reconstruction failed: maximum absolute error=%g, ' ...
+         'tolerance=%g.'], max_abs_path_error, path_tolerance);
+end
+
+diagnostics = struct();
+diagnostics.P_news = P_news;
+diagnostics.rcond = reciprocal_condition;
+diagnostics.singular_values = svd(P_news);
+diagnostics.path_error = path_error;
+diagnostics.max_abs_path_error = max_abs_path_error;
+diagnostics.path_tolerance = path_tolerance;
+diagnostics.news_norms = sqrt(sum(abs(news_basis).^2, 1));
+diagnostics.is_ill_conditioned = is_ill_conditioned;
+diagnostics.options = options;
+
+end
+
+function options = normalize_options(options)
+
+if ~isstruct(options) || ~isscalar(options)
+    error('map_paths_to_news:InvalidOptions', ...
+        'options must be a scalar struct.');
+end
+
+defaults = struct( ...
+    'rcond_fail', 1e-12, ...
+    'rcond_warn', 1e-8, ...
+    'path_tol_abs', 1e-10, ...
+    'path_tol_rel', 1e-8, ...
+    'emit_warning', false);
+
+option_names = fieldnames(defaults);
+unknown_options = setdiff(fieldnames(options), option_names);
+if ~isempty(unknown_options)
+    error('map_paths_to_news:InvalidOptions', ...
+        'Unknown option ''%s''.', unknown_options{1});
+end
+for i_option = 1:numel(option_names)
+    option_name = option_names{i_option};
+    if ~isfield(options, option_name) || isempty(options.(option_name))
+        options.(option_name) = defaults.(option_name);
+    end
+end
+
+validate_threshold(options.rcond_fail, 'rcond_fail', true);
+validate_threshold(options.rcond_warn, 'rcond_warn', true);
+validate_threshold(options.path_tol_abs, 'path_tol_abs', false);
+validate_threshold(options.path_tol_rel, 'path_tol_rel', false);
+
+if options.rcond_fail > 1 || options.rcond_warn > 1
+    error('map_paths_to_news:InvalidOptions', ...
+        'rcond_fail and rcond_warn must not exceed one.');
+end
+if options.rcond_fail > options.rcond_warn
+    error('map_paths_to_news:InvalidOptions', ...
+        'rcond_fail must be less than or equal to rcond_warn.');
+end
+
+is_binary_numeric = isnumeric(options.emit_warning) && ...
+    isreal(options.emit_warning) && isscalar(options.emit_warning) && ...
+    isfinite(options.emit_warning) && ...
+    (options.emit_warning == 0 || options.emit_warning == 1);
+if ~(islogical(options.emit_warning) && isscalar(options.emit_warning)) && ...
+        ~is_binary_numeric
+    error('map_paths_to_news:InvalidOptions', ...
+        'emit_warning must be a scalar logical or numeric zero/one.');
+end
+options.emit_warning = logical(options.emit_warning);
+
+end
+
+function validate_threshold(value, name, must_be_positive)
+
+is_valid = isnumeric(value) && isreal(value) && isscalar(value) && ...
+    isfinite(value);
+if must_be_positive
+    is_valid = is_valid && value > 0;
+else
+    is_valid = is_valid && value >= 0;
+end
+if ~is_valid
+    if must_be_positive
+        qualifier = 'positive';
+    else
+        qualifier = 'nonnegative';
+    end
+    error('map_paths_to_news:InvalidOptions', ...
+        '%s must be a finite, real, %s numeric scalar.', name, qualifier);
+end
+
+end
+
+function validate_finite_matrix(value, name)
+
+if ~isnumeric(value) || ~isfloat(value) || ~isreal(value) || ...
+        ~ismatrix(value) || isempty(value)
+    error('map_paths_to_news:InvalidInput', ...
+        '%s must be a nonempty, real floating-point matrix.', name);
+end
+if any(~isfinite(value(:)))
+    error('map_paths_to_news:InvalidInput', ...
+        '%s contains NaN or Inf values.', name);
+end
+
+end
+
+function validate_positive_integer(value, name)
+
+if ~isnumeric(value) || ~isreal(value) || ~isscalar(value) || ...
+        ~isfinite(value) || value <= 0 || value ~= fix(value)
+    error('map_paths_to_news:InvalidHorizon', ...
+        '%s must be a finite positive integer scalar.', name);
+end
+
+end
diff --git a/_auxiliary_functions/profile_pcpath_irfs.m b/_auxiliary_functions/profile_pcpath_irfs.m
new file mode 100644
index 0000000..26c8a61
--- /dev/null
+++ b/_auxiliary_functions/profile_pcpath_irfs.m
@@ -0,0 +1,257 @@
+function [md_loss, out] = profile_pcpath_irfs( ...
+    Pi_m_model, Y_m_model, R_n_m_model, emp, cfg)
+%PROFILE_PCPATH_IRFS Profile policy news shocks using rate paths only.
+%
+% The function must first solve P_news * news_basis = V_path_model, then
+% form macro responses in that same PC basis and compute the macro-only
+% minimum-distance loss. It intentionally contains no model priors.
+
+validate_model_irf(Pi_m_model, 'Pi_m_model');
+validate_model_irf(Y_m_model, 'Y_m_model');
+validate_model_irf(R_n_m_model, 'R_n_m_model');
+if ~isequal(size(Pi_m_model), size(Y_m_model), size(R_n_m_model))
+    error('profile_pcpath_irfs:DimensionMismatch', ...
+        'Pi_m_model, Y_m_model, and R_n_m_model must have identical sizes.');
+end
+if size(Pi_m_model, 1) ~= size(Pi_m_model, 2)
+    error('profile_pcpath_irfs:DimensionMismatch', ...
+        'Model IRF matrices must be square T-by-T matrices.');
+end
+
+if ~isstruct(emp) || ~isscalar(emp)
+    error('profile_pcpath_irfs:InvalidEmpiricalTargets', ...
+        'emp must be a scalar struct.');
+end
+if ~isstruct(cfg) || ~isscalar(cfg)
+    error('profile_pcpath_irfs:InvalidConfig', ...
+        'cfg must be a scalar struct.');
+end
+
+required_emp_fields = {'V_path_model', 'target_pc', ...
+    'Sigma_B_inv', 'M_F'};
+require_fields(emp, required_emp_fields, ...
+    'profile_pcpath_irfs:InvalidEmpiricalTargets', 'emp');
+required_cfg_fields = {'H_path', 'J_news', 'K_pc', 'L_pi', 'L_y'};
+require_fields(cfg, required_cfg_fields, ...
+    'profile_pcpath_irfs:InvalidConfig', 'cfg');
+
+validate_positive_integer(cfg.H_path, 'H_path');
+validate_positive_integer(cfg.J_news, 'J_news');
+validate_positive_integer(cfg.K_pc, 'K_pc');
+validate_positive_integer(cfg.L_pi, 'L_pi');
+validate_positive_integer(cfg.L_y, 'L_y');
+
+T_model = size(R_n_m_model, 1);
+if isfield(cfg, 'T_model') && ~isempty(cfg.T_model)
+    validate_positive_integer(cfg.T_model, 'T_model');
+    if cfg.T_model ~= T_model
+        error('profile_pcpath_irfs:DimensionMismatch', ...
+            'cfg.T_model=%d does not match the IRF dimension T=%d.', ...
+            cfg.T_model, T_model);
+    end
+end
+if T_model < max([cfg.H_path, cfg.J_news, cfg.L_pi, cfg.L_y])
+    error('profile_pcpath_irfs:DimensionMismatch', ...
+        ['The model truncation T=%d must be at least H_path=%d, J_news=%d, ' ...
+         'L_pi=%d, and L_y=%d.'], T_model, cfg.H_path, cfg.J_news, ...
+        cfg.L_pi, cfg.L_y);
+end
+
+validate_finite_matrix(emp.V_path_model, 'emp.V_path_model', ...
+    'profile_pcpath_irfs:InvalidEmpiricalTargets');
+if ~isequal(size(emp.V_path_model), [cfg.H_path, cfg.K_pc])
+    error('profile_pcpath_irfs:DimensionMismatch', ...
+        ['emp.V_path_model must be H_path-by-K_pc (%d-by-%d); ' ...
+         'received %d-by-%d.'], cfg.H_path, cfg.K_pc, ...
+        size(emp.V_path_model, 1), size(emp.V_path_model, 2));
+end
+
+validate_finite_matrix(emp.M_F, 'emp.M_F', ...
+    'profile_pcpath_irfs:InvalidEmpiricalTargets');
+if ~isequal(size(emp.M_F), [cfg.H_path, T_model])
+    error('profile_pcpath_irfs:DimensionMismatch', ...
+        'emp.M_F must be H_path-by-T (%d-by-%d); received %d-by-%d.', ...
+        cfg.H_path, T_model, size(emp.M_F, 1), size(emp.M_F, 2));
+end
+
+n_macro_rows = cfg.L_pi + cfg.L_y;
+n_target = n_macro_rows * cfg.K_pc;
+validate_target_vector(emp.target_pc, n_target);
+[weight_matrix, precision_chol, weight_rcond] = ...
+    validate_weight_matrix(emp.Sigma_B_inv, n_target);
+
+if isfield(cfg, 'map_options') && ~isempty(cfg.map_options)
+    map_options = cfg.map_options;
+else
+    map_options = struct();
+end
+
+[news_basis, path_fit, path_diagnostics] = map_paths_to_news( ...
+    R_n_m_model, emp.V_path_model, emp.M_F, ...
+    cfg.H_path, cfg.J_news, map_options);
+
+Pi_pc_model = Pi_m_model(1:cfg.L_pi, 1:cfg.J_news) * news_basis;
+Y_pc_model = Y_m_model(1:cfg.L_y, 1:cfg.J_news) * news_basis;
+B_model = [Pi_pc_model; Y_pc_model];
+model_target = B_model(:);
+
+% Only macro responses enter the minimum-distance residual. The policy
+% path has already been imposed by map_paths_to_news.
+resid = model_target - emp.target_pc;
+if any(~isfinite(resid))
+    error('profile_pcpath_irfs:NonfiniteModelTarget', ...
+        'The profiled macro target or residual contains NaN or Inf values.');
+end
+
+weighted_resid = precision_chol' * resid;
+md_loss = 0.5 * (weighted_resid' * weighted_resid);
+if ~isfinite(md_loss) || ~isreal(md_loss)
+    error('profile_pcpath_irfs:NonfiniteLoss', ...
+        'The minimum-distance loss is not finite and real.');
+end
+if md_loss < 0
+    roundoff_tolerance = 100 * eps(max(1, norm(resid)^2 * ...
+        norm(weight_matrix, 2)));
+    if md_loss < -roundoff_tolerance
+        error('profile_pcpath_irfs:InvalidLoss', ...
+            'The positive-definite weighting matrix produced a negative loss.');
+    end
+    md_loss = 0;
+end
+
+if nargout > 1
+    rate_pc_full = R_n_m_model(:, 1:cfg.J_news) * news_basis;
+
+    out = struct();
+    out.P_news = path_diagnostics.P_news;
+    out.news_basis = news_basis;
+    out.V_fit = path_fit;
+    out.Pi_pc_model = Pi_pc_model;
+    out.Y_pc_model = Y_pc_model;
+    out.B_model = B_model;
+    out.model_target = model_target;
+    out.resid = resid;
+    out.md_loss = md_loss;
+    out.weight_rcond = weight_rcond;
+    out.rate_pc_full = rate_pc_full;
+    measurement_tolerance = max(size(emp.M_F)) * ...
+        eps(max(1, norm(emp.M_F, inf)));
+    measurement_support_indices = find( ...
+        any(abs(emp.M_F) > measurement_tolerance, 1));
+    last_measurement_index = max(measurement_support_indices);
+    out.rate_after_news = rate_pc_full(cfg.J_news + 1:end, :);
+    out.rate_after_measurement = ...
+        rate_pc_full(last_measurement_index + 1:end, :);
+    % Backward-compatible collector name. For a general measurement matrix,
+    % the economically meaningful tail begins after its actual support, not
+    % after the number of contract rows H_path.
+    out.rate_tail = out.rate_after_measurement;
+    out.rate_diagnostics = struct( ...
+        'last_news_horizon', cfg.J_news - 1, ...
+        'measurement_support_horizons', ...
+            measurement_support_indices(:) - 1, ...
+        'last_measurement_rate_horizon', last_measurement_index - 1, ...
+        'measurement_tolerance', measurement_tolerance);
+    out.path_diagnostics = path_diagnostics;
+end
+
+end
+
+function validate_model_irf(value, name)
+
+if ~isnumeric(value) || ~isfloat(value) || ~isreal(value) || ...
+        ~ismatrix(value) || isempty(value)
+    error('profile_pcpath_irfs:InvalidModelIRF', ...
+        '%s must be a nonempty, real floating-point matrix.', name);
+end
+if any(~isfinite(value(:)))
+    error('profile_pcpath_irfs:NonfiniteModelIRF', ...
+        '%s contains NaN or Inf values.', name);
+end
+
+end
+
+function validate_target_vector(target_pc, expected_length)
+
+if ~isnumeric(target_pc) || ~isfloat(target_pc) || ~isreal(target_pc) || ...
+        ~iscolumn(target_pc) || numel(target_pc) ~= expected_length
+    error('profile_pcpath_irfs:InvalidEmpiricalTargets', ...
+        'emp.target_pc must be a real floating-point column vector of length %d.', ...
+        expected_length);
+end
+if any(~isfinite(target_pc))
+    error('profile_pcpath_irfs:InvalidEmpiricalTargets', ...
+        'emp.target_pc contains NaN or Inf values.');
+end
+
+end
+
+function [weight_symmetric, lower_factor, reciprocal_condition] = ...
+    validate_weight_matrix(weight_matrix, expected_size)
+
+validate_finite_matrix(weight_matrix, 'emp.Sigma_B_inv', ...
+    'profile_pcpath_irfs:InvalidWeightMatrix');
+if ~isequal(size(weight_matrix), [expected_size, expected_size])
+    error('profile_pcpath_irfs:DimensionMismatch', ...
+        'emp.Sigma_B_inv must be %d-by-%d; received %d-by-%d.', ...
+        expected_size, expected_size, ...
+        size(weight_matrix, 1), size(weight_matrix, 2));
+end
+
+symmetry_error = norm(weight_matrix - weight_matrix', 'fro');
+symmetry_tolerance = 1e-10 * max(1, norm(weight_matrix, 'fro'));
+if symmetry_error > symmetry_tolerance
+    error('profile_pcpath_irfs:InvalidWeightMatrix', ...
+        ['emp.Sigma_B_inv must be symmetric. Symmetry error=%g exceeds ' ...
+         'tolerance=%g.'], symmetry_error, symmetry_tolerance);
+end
+
+weight_symmetric = (weight_matrix + weight_matrix') / 2;
+[lower_factor, chol_status] = chol(weight_symmetric, 'lower');
+if chol_status ~= 0
+    error('profile_pcpath_irfs:InvalidWeightMatrix', ...
+        'emp.Sigma_B_inv must be positive definite.');
+end
+reciprocal_condition = rcond(weight_symmetric);
+if ~isfinite(reciprocal_condition) || reciprocal_condition <= 0
+    error('profile_pcpath_irfs:InvalidWeightMatrix', ...
+        'emp.Sigma_B_inv is numerically singular (rcond=%g).', ...
+        reciprocal_condition);
+end
+
+end
+
+function require_fields(value, field_names, error_id, struct_name)
+
+for i_field = 1:numel(field_names)
+    field_name = field_names{i_field};
+    if ~isfield(value, field_name)
+        error(error_id, '%s is missing required field ''%s''.', ...
+            struct_name, field_name);
+    end
+end
+
+end
+
+function validate_positive_integer(value, name)
+
+if ~isnumeric(value) || ~isreal(value) || ~isscalar(value) || ...
+        ~isfinite(value) || value <= 0 || value ~= fix(value)
+    error('profile_pcpath_irfs:InvalidConfig', ...
+        'cfg.%s must be a finite positive integer scalar.', name);
+end
+
+end
+
+function validate_finite_matrix(value, name, error_id)
+
+if ~isnumeric(value) || ~isfloat(value) || ~isreal(value) || ...
+        ~ismatrix(value) || isempty(value)
+    error(error_id, ...
+        '%s must be a nonempty, real floating-point matrix.', name);
+end
+if any(~isfinite(value(:)))
+    error(error_id, '%s contains NaN or Inf values.', name);
+end
+
+end
diff --git a/_auxiliary_functions/run_MH_pcpaths.m b/_auxiliary_functions/run_MH_pcpaths.m
new file mode 100644
index 0000000..932a404
--- /dev/null
+++ b/_auxiliary_functions/run_MH_pcpaths.m
@@ -0,0 +1,771 @@
+function result = run_MH_pcpaths( ...
+    objective_handle, initial_param, proposal_factor, settings)
+%RUN_MH_PCPATHS Random-walk MH for the profiled PC-path objective.
+%
+% RESULT = RUN_MH_PCPATHS(OBJECTIVE_HANDLE, INITIAL_PARAM,
+% PROPOSAL_FACTOR, SETTINGS) minimizes the objective in the Metropolis
+% ratio. OBJECTIVE_HANDLE must return [objective, profile] for a parameter
+% column vector. A finite objective and its validated profile are one chain
+% state: every feasible proposal is fully recomputed, accepted profiles
+% replace the current profile, and rejected proposals retain the old one.
+%
+% Required SETTINGS fields are N_draws, N_burn, N_keep, keep_every (or
+% thin), N_adapt, lower_bound, and upper_bound. N_draws must equal
+% N_burn + N_keep*keep_every. Optional fields are adapt_scale,
+% adapt_jitter, normal_draws, and uniform_draws. Supplying both random-draw
+% arrays makes a run deterministic. The RNG state immediately before and
+% after draw preparation is recorded in RESULT for reproducibility.
+
+if nargin ~= 4
+    error('run_MH_pcpaths:InvalidInput', ...
+        ['Exactly four inputs are required: objective_handle, ' ...
+         'initial_param, proposal_factor, and settings.']);
+end
+if ~isa(objective_handle, 'function_handle')
+    error('run_MH_pcpaths:InvalidObjective', ...
+        'objective_handle must be a function handle.');
+end
+
+param_old = validate_initial_parameter(initial_param);
+n_param = numel(param_old);
+proposal_factor = validate_proposal_factor(proposal_factor, n_param);
+settings = normalize_settings(settings, n_param, param_old);
+rng_state_before = rng;
+[normal_draws, uniform_draws, rng_draws_supplied] = ...
+    prepare_random_draws(settings, n_param);
+rng_state_after_draw_generation = rng;
+
+try
+    [objective_old, profile_old] = objective_handle(param_old);
+catch initial_error
+    error('run_MH_pcpaths:InitialObjectiveFailed', ...
+        'Initial objective evaluation failed (%s): %s', ...
+        initial_error.identifier, initial_error.message);
+end
+objective_old = validate_objective_value(objective_old);
+if ~isfinite(objective_old)
+    error('run_MH_pcpaths:InvalidInitialObjective', ...
+        'The initial objective must be finite.');
+end
+initial_param = param_old;
+initial_objective = objective_old;
+[initial_admissible, failure_identifier, failure_message] = ...
+    profile_admissibility(profile_old);
+if ~initial_admissible
+    error('run_MH_pcpaths:InvalidInitialObjective', ...
+        'The initial state is inadmissible (%s): %s', ...
+        failure_identifier, failure_message);
+end
+profile_spec = validate_profile(profile_old, []);
+
+N_draws = settings.N_draws;
+N_keep = settings.N_keep;
+
+param_history = zeros(n_param, N_draws);
+objective_history = NaN(1, N_draws);
+acceptance_history = false(1, N_draws);
+proposal_param_history = NaN(n_param, N_draws);
+proposal_objective_history = NaN(1, N_draws);
+proposal_feasible_history = false(1, N_draws);
+proposal_evaluated_history = false(1, N_draws);
+proposal_returned_history = false(1, N_draws);
+proposal_valid_history = false(1, N_draws);
+log_acceptance_ratio_history = NaN(1, N_draws);
+proposal_failure_identifier_history = cell(1, N_draws);
+proposal_failure_message_history = cell(1, N_draws);
+
+param_draws = zeros(n_param, N_keep);
+objective_draws = NaN(1, N_keep);
+retained_iterations = zeros(1, N_keep);
+news_basis_draws = zeros([profile_spec.news_basis_size, N_keep]);
+Pi_pc_draws = zeros([profile_spec.Pi_pc_size, N_keep]);
+Y_pc_draws = zeros([profile_spec.Y_pc_size, N_keep]);
+rate_pc_full_draws = zeros([profile_spec.rate_pc_full_size, N_keep]);
+rate_tail_draws = zeros([profile_spec.rate_tail_size, N_keep]);
+rcond_draws = NaN(1, N_keep);
+max_abs_path_error_draws = NaN(1, N_keep);
+singular_values_draws = zeros(profile_spec.n_singular_values, N_keep);
+news_norms_draws = zeros(profile_spec.K_pc, N_keep);
+
+initial_proposal_factor = proposal_factor;
+active_dimensions = any(proposal_factor ~= 0, 2);
+adaptation_attempted = false;
+adaptation_succeeded = false;
+adapted_covariance_active = [];
+adaptation_failure_message = '';
+keep_index = 0;
+
+for i_draw = 1:N_draws
+    param_new = param_old + proposal_factor * normal_draws(:, i_draw);
+    proposal_param_history(:, i_draw) = param_new;
+    proposal_feasible = all(isfinite(param_new)) && ...
+        all(param_new >= settings.lower_bound) && ...
+        all(param_new <= settings.upper_bound);
+    proposal_feasible_history(i_draw) = proposal_feasible;
+
+    if proposal_feasible
+        proposal_evaluated_history(i_draw) = true;
+        try
+            [objective_new, profile_new] = objective_handle(param_new);
+            proposal_returned_history(i_draw) = true;
+            objective_new = validate_objective_value(objective_new);
+            proposal_objective_history(i_draw) = objective_new;
+
+            if isfinite(objective_new)
+                [proposal_admissible, failure_identifier, ...
+                    failure_message] = profile_admissibility(profile_new);
+                if proposal_admissible
+                    validate_profile(profile_new, profile_spec);
+                    proposal_valid_history(i_draw) = true;
+                    log_acceptance_ratio = min( ...
+                        0, objective_old - objective_new);
+                    log_acceptance_ratio_history(i_draw) = ...
+                        log_acceptance_ratio;
+                    if log(uniform_draws(i_draw)) < log_acceptance_ratio
+                        acceptance_history(i_draw) = true;
+                        param_old = param_new;
+                        objective_old = objective_new;
+                        profile_old = profile_new;
+                    end
+                else
+                    proposal_failure_identifier_history{i_draw} = ...
+                        failure_identifier;
+                    proposal_failure_message_history{i_draw} = ...
+                        failure_message;
+                end
+            else
+                [failure_identifier, failure_message] = ...
+                    profile_failure_details(profile_new);
+                if isempty(failure_identifier)
+                    failure_identifier = ...
+                        'run_MH_pcpaths:NonfiniteProposalObjective';
+                end
+                if isempty(failure_message)
+                    failure_message = ...
+                        'The proposal objective was NaN or Inf.';
+                end
+                proposal_failure_identifier_history{i_draw} = ...
+                    failure_identifier;
+                proposal_failure_message_history{i_draw} = ...
+                    failure_message;
+            end
+        catch proposal_error
+            if is_numerical_inadmissibility(proposal_error)
+                proposal_failure_identifier_history{i_draw} = ...
+                    proposal_error.identifier;
+                proposal_failure_message_history{i_draw} = ...
+                    proposal_error.message;
+            else
+                contextual_error = MException( ...
+                    'run_MH_pcpaths:ProposalObjectiveFailed', ...
+                    ['Objective/profile evaluation failed unexpectedly at ' ...
+                     'draw %d for a feasible proposal.'], i_draw);
+                contextual_error = addCause(contextual_error, proposal_error);
+                throw(contextual_error);
+            end
+        end
+    else
+        proposal_failure_identifier_history{i_draw} = ...
+            'run_MH_pcpaths:ProposalOutOfBounds';
+        proposal_failure_message_history{i_draw} = ...
+            'The proposal was nonfinite or outside the parameter bounds.';
+    end
+
+    param_history(:, i_draw) = param_old;
+    objective_history(i_draw) = objective_old;
+
+    if i_draw > settings.N_burn && ...
+            mod(i_draw - settings.N_burn, settings.keep_every) == 0
+        keep_index = keep_index + 1;
+        retained_iterations(keep_index) = i_draw;
+        param_draws(:, keep_index) = param_old;
+        objective_draws(keep_index) = objective_old;
+        news_basis_draws(:, :, keep_index) = profile_old.news_basis;
+        Pi_pc_draws(:, :, keep_index) = profile_old.Pi_pc_model;
+        Y_pc_draws(:, :, keep_index) = profile_old.Y_pc_model;
+        rate_pc_full_draws(:, :, keep_index) = ...
+            profile_old.rate_pc_full;
+        rate_tail_draws(:, :, keep_index) = profile_old.rate_tail;
+        rcond_draws(keep_index) = profile_old.path_diagnostics.rcond;
+        max_abs_path_error_draws(keep_index) = ...
+            profile_old.path_diagnostics.max_abs_path_error;
+        singular_values_draws(:, keep_index) = ...
+            profile_old.path_diagnostics.singular_values(:);
+        news_norms_draws(:, keep_index) = ...
+            profile_old.path_diagnostics.news_norms(:);
+    end
+
+    if settings.N_adapt > 0 && i_draw == settings.N_adapt
+        adaptation_attempted = true;
+        [proposal_factor, adaptation_succeeded, ...
+            adapted_covariance_active, adaptation_failure_message] = ...
+            adapt_proposal_factor(param_history(:, 1:i_draw), ...
+            proposal_factor, active_dimensions, settings);
+    end
+end
+
+if keep_index ~= N_keep
+    error('run_MH_pcpaths:InternalRetentionError', ...
+        'Retained %d draws, but settings require %d.', keep_index, N_keep);
+end
+
+result = struct();
+result.initial_param = initial_param;
+result.initial_objective = initial_objective;
+result.param_history = param_history;
+result.objective_history = objective_history;
+result.acceptance_history = acceptance_history;
+result.proposal_param_history = proposal_param_history;
+result.proposal_objective_history = proposal_objective_history;
+result.proposal_feasible_history = proposal_feasible_history;
+result.proposal_evaluated_history = proposal_evaluated_history;
+result.proposal_returned_history = proposal_returned_history;
+result.proposal_valid_history = proposal_valid_history;
+result.log_acceptance_ratio_history = log_acceptance_ratio_history;
+result.proposal_failure_identifier_history = ...
+    proposal_failure_identifier_history;
+result.proposal_failure_message_history = proposal_failure_message_history;
+result.retained_iterations = retained_iterations;
+result.param_draws = param_draws;
+result.objective_draws = objective_draws;
+result.news_basis_draws = news_basis_draws;
+result.Pi_pc_draws = Pi_pc_draws;
+result.Y_pc_draws = Y_pc_draws;
+result.rate_pc_full_draws = rate_pc_full_draws;
+result.rate_tail_draws = rate_tail_draws;
+result.rcond_draws = rcond_draws;
+result.max_abs_path_error_draws = max_abs_path_error_draws;
+result.singular_values_draws = singular_values_draws;
+result.news_norms_draws = news_norms_draws;
+result.final_param = param_old;
+result.final_objective = objective_old;
+result.final_profile = profile_old;
+result.acceptance_rate = mean(acceptance_history);
+result.initial_proposal_factor = initial_proposal_factor;
+result.proposal_factor = proposal_factor;
+result.active_proposal_dimensions = find(active_dimensions);
+result.fixed_proposal_dimensions = find(~active_dimensions);
+result.adaptation_attempted = adaptation_attempted;
+result.adaptation_succeeded = adaptation_succeeded;
+result.adapted_covariance_active = adapted_covariance_active;
+result.adaptation_failure_message = adaptation_failure_message;
+result.objective_evaluation_count = ...
+    1 + sum(proposal_evaluated_history);
+result.successful_proposal_evaluation_count = ...
+    sum(proposal_returned_history);
+result.rng_draws_supplied = rng_draws_supplied;
+result.rng_state_before = rng_state_before;
+result.rng_state_after_draw_generation = ...
+    rng_state_after_draw_generation;
+result.supplied_random_draws = struct( ...
+    'normal_draws', [], 'uniform_draws', []);
+if rng_draws_supplied.normal_draws
+    result.supplied_random_draws.normal_draws = normal_draws;
+end
+if rng_draws_supplied.uniform_draws
+    result.supplied_random_draws.uniform_draws = uniform_draws;
+end
+result.settings = strip_rng_draws(settings);
+
+end
+
+function param = validate_initial_parameter(param)
+
+if ~isnumeric(param) || ~isfloat(param) || ~isreal(param) || ...
+        ~isvector(param) || isempty(param) || any(~isfinite(param(:)))
+    error('run_MH_pcpaths:InvalidInitialParameter', ...
+        ['initial_param must be a nonempty, finite, real ' ...
+         'floating-point vector.']);
+end
+param = double(param(:));
+
+end
+
+function proposal_factor = validate_proposal_factor( ...
+    proposal_factor, n_param)
+
+if ~isnumeric(proposal_factor) || ~isfloat(proposal_factor) || ...
+        ~isreal(proposal_factor) || ...
+        ~isequal(size(proposal_factor), [n_param, n_param]) || ...
+        any(~isfinite(proposal_factor(:)))
+    error('run_MH_pcpaths:InvalidProposalFactor', ...
+        'proposal_factor must be a finite %d-by-%d real matrix.', ...
+        n_param, n_param);
+end
+proposal_factor = double(proposal_factor);
+
+active_rows = any(proposal_factor ~= 0, 2);
+if any(active_rows)
+    active_factor = proposal_factor(active_rows, :);
+    singular_values = svd(active_factor, 'econ');
+    rank_tolerance = max(size(active_factor)) * ...
+        eps(max(singular_values));
+    numerical_rank = sum(singular_values > rank_tolerance);
+    if numerical_rank < size(active_factor, 1)
+        error('run_MH_pcpaths:RankDeficientProposalFactor', ...
+            ['The nonzero rows of proposal_factor have numerical row rank ' ...
+             '%d, but %d active parameter coordinates require independent ' ...
+             'proposal directions. Coordinate-wise conditioning must use ' ...
+             'explicit zero rows.'], numerical_rank, size(active_factor, 1));
+    end
+end
+
+end
+
+function tf = is_numerical_inadmissibility(exception)
+
+identifiers = { ...
+    'map_paths_to_news:NonfinitePolicyPathJacobian', ...
+    'map_paths_to_news:SingularPolicyPathJacobian', ...
+    'map_paths_to_news:NonfiniteNewsBasis', ...
+    'map_paths_to_news:PathReconstructionFailed', ...
+    'profile_pcpath_irfs:NonfiniteModelIRF', ...
+    'profile_pcpath_irfs:NonfiniteModelTarget', ...
+    'profile_pcpath_irfs:NonfiniteLoss'};
+tf = any(strcmp(exception.identifier, identifiers));
+
+end
+
+function settings = normalize_settings(settings, n_param, initial_param)
+
+if ~isstruct(settings) || ~isscalar(settings)
+    error('run_MH_pcpaths:InvalidSettings', ...
+        'settings must be a scalar struct.');
+end
+
+required_fields = {'N_draws', 'N_burn', 'N_keep', 'N_adapt', ...
+    'lower_bound', 'upper_bound'};
+require_fields(settings, required_fields, ...
+    'run_MH_pcpaths:InvalidSettings', 'settings');
+
+has_keep_every = isfield(settings, 'keep_every') && ...
+    ~isempty(settings.keep_every);
+has_thin = isfield(settings, 'thin') && ~isempty(settings.thin);
+if ~has_keep_every && ~has_thin
+    error('run_MH_pcpaths:InvalidSettings', ...
+        'settings must contain keep_every or thin.');
+end
+if has_keep_every
+    validate_positive_integer(settings.keep_every, 'keep_every');
+end
+if has_thin
+    validate_positive_integer(settings.thin, 'thin');
+end
+if has_keep_every && has_thin && settings.keep_every ~= settings.thin
+    error('run_MH_pcpaths:InvalidSettings', ...
+        'settings.keep_every and settings.thin must agree when both exist.');
+elseif has_keep_every
+    settings.thin = settings.keep_every;
+else
+    settings.keep_every = settings.thin;
+end
+
+validate_positive_integer(settings.N_draws, 'N_draws');
+validate_nonnegative_integer(settings.N_burn, 'N_burn');
+validate_positive_integer(settings.N_keep, 'N_keep');
+validate_nonnegative_integer(settings.N_adapt, 'N_adapt');
+
+expected_draws = settings.N_burn + ...
+    settings.N_keep * settings.keep_every;
+if settings.N_draws ~= expected_draws
+    error('run_MH_pcpaths:InvalidSettings', ...
+        ['settings.N_draws must equal N_burn + N_keep*keep_every ' ...
+         '(%d); received %d.'], expected_draws, settings.N_draws);
+end
+if settings.N_adapt == 1
+    error('run_MH_pcpaths:InvalidSettings', ...
+        'settings.N_adapt must be zero or at least two.');
+end
+if settings.N_adapt > settings.N_burn
+    error('run_MH_pcpaths:InvalidSettings', ...
+        'settings.N_adapt must not exceed settings.N_burn.');
+end
+
+settings.lower_bound = validate_bound_vector( ...
+    settings.lower_bound, n_param, 'lower_bound');
+settings.upper_bound = validate_bound_vector( ...
+    settings.upper_bound, n_param, 'upper_bound');
+if any(settings.lower_bound > settings.upper_bound)
+    error('run_MH_pcpaths:InvalidBounds', ...
+        'Each lower bound must be less than or equal to its upper bound.');
+end
+if any(initial_param < settings.lower_bound) || ...
+        any(initial_param > settings.upper_bound)
+    error('run_MH_pcpaths:InvalidInitialParameter', ...
+        'initial_param must lie inside the supplied bounds.');
+end
+
+if ~isfield(settings, 'adapt_scale') || isempty(settings.adapt_scale)
+    settings.adapt_scale = 1;
+end
+if ~isnumeric(settings.adapt_scale) || ...
+        ~isreal(settings.adapt_scale) || ...
+        ~isscalar(settings.adapt_scale) || ...
+        ~isfinite(settings.adapt_scale) || settings.adapt_scale <= 0
+    error('run_MH_pcpaths:InvalidSettings', ...
+        'settings.adapt_scale must be a finite positive scalar.');
+end
+settings.adapt_scale = double(settings.adapt_scale);
+
+if ~isfield(settings, 'adapt_jitter') || isempty(settings.adapt_jitter)
+    settings.adapt_jitter = 1e-10;
+end
+if ~isnumeric(settings.adapt_jitter) || ...
+        ~isreal(settings.adapt_jitter) || ...
+        ~isscalar(settings.adapt_jitter) || ...
+        ~isfinite(settings.adapt_jitter) || settings.adapt_jitter < 0
+    error('run_MH_pcpaths:InvalidSettings', ...
+        'settings.adapt_jitter must be a finite nonnegative scalar.');
+end
+settings.adapt_jitter = double(settings.adapt_jitter);
+
+end
+
+function bound = validate_bound_vector(bound, n_param, name)
+
+if ~isnumeric(bound) || ~isfloat(bound) || ~isreal(bound) || ...
+        ~isvector(bound) || numel(bound) ~= n_param || any(isnan(bound(:)))
+    error('run_MH_pcpaths:InvalidBounds', ...
+        '%s must be a real floating-point vector of length %d without NaN.', ...
+        name, n_param);
+end
+bound = double(bound(:));
+
+end
+
+function [normal_draws, uniform_draws, supplied] = ...
+    prepare_random_draws(settings, n_param)
+
+normal_supplied = isfield(settings, 'normal_draws') && ...
+    ~isempty(settings.normal_draws);
+uniform_supplied = isfield(settings, 'uniform_draws') && ...
+    ~isempty(settings.uniform_draws);
+
+if normal_supplied
+    normal_draws = settings.normal_draws;
+    if ~isnumeric(normal_draws) || ~isfloat(normal_draws) || ...
+            ~isreal(normal_draws) || ...
+            ~isequal(size(normal_draws), [n_param, settings.N_draws]) || ...
+            any(~isfinite(normal_draws(:)))
+        error('run_MH_pcpaths:InvalidRandomDraws', ...
+            'normal_draws must be a finite %d-by-%d real matrix.', ...
+            n_param, settings.N_draws);
+    end
+    normal_draws = double(normal_draws);
+else
+    normal_draws = randn(n_param, settings.N_draws);
+end
+
+if uniform_supplied
+    uniform_draws = settings.uniform_draws;
+    if ~isnumeric(uniform_draws) || ~isfloat(uniform_draws) || ...
+            ~isreal(uniform_draws) || ~isvector(uniform_draws) || ...
+            numel(uniform_draws) ~= settings.N_draws || ...
+            any(~isfinite(uniform_draws(:))) || ...
+            any(uniform_draws(:) < 0) || any(uniform_draws(:) >= 1)
+        error('run_MH_pcpaths:InvalidRandomDraws', ...
+            ['uniform_draws must contain %d finite values in ' ...
+             'the interval [0,1).'], settings.N_draws);
+    end
+    uniform_draws = double(uniform_draws(:).');
+else
+    uniform_draws = rand(1, settings.N_draws);
+end
+
+supplied = struct( ...
+    'normal_draws', normal_supplied, ...
+    'uniform_draws', uniform_supplied);
+
+end
+
+function objective = validate_objective_value(objective)
+
+if ~isnumeric(objective) || ~isfloat(objective) || ...
+        ~isreal(objective) || ~isscalar(objective)
+    error('run_MH_pcpaths:InvalidObjectiveValue', ...
+        'The objective must be a real floating-point scalar.');
+end
+objective = double(objective);
+
+end
+
+function [admissible, failure_identifier, failure_message] = ...
+    profile_admissibility(profile)
+
+if ~isstruct(profile) || ~isscalar(profile)
+    error('run_MH_pcpaths:InvalidProfile', ...
+        'The objective profile output must be a scalar struct.');
+end
+
+admissible = true;
+if isfield(profile, 'admissible')
+    value = profile.admissible;
+    is_binary_numeric = isnumeric(value) && isreal(value) && ...
+        isscalar(value) && isfinite(value) && (value == 0 || value == 1);
+    if ~(islogical(value) && isscalar(value)) && ~is_binary_numeric
+        error('run_MH_pcpaths:InvalidProfile', ...
+            'profile.admissible must be a scalar logical or zero/one.');
+    end
+    admissible = logical(value);
+end
+[failure_identifier, failure_message] = profile_failure_details(profile);
+
+end
+
+function [failure_identifier, failure_message] = ...
+    profile_failure_details(profile)
+
+failure_identifier = '';
+failure_message = '';
+if ~isstruct(profile) || ~isscalar(profile)
+    return
+end
+if isfield(profile, 'failure_identifier')
+    failure_identifier = optional_text(profile.failure_identifier);
+end
+if isfield(profile, 'failure_message')
+    failure_message = optional_text(profile.failure_message);
+end
+
+end
+
+function value = optional_text(value)
+
+if isstring(value) && isscalar(value)
+    value = char(value);
+end
+if ~ischar(value) || ~isrow(value)
+    value = '';
+end
+
+end
+
+function spec = validate_profile(profile, expected_spec)
+
+if ~isstruct(profile) || ~isscalar(profile)
+    error('run_MH_pcpaths:InvalidProfile', ...
+        'The objective profile output must be a scalar struct.');
+end
+required_fields = {'news_basis', 'Pi_pc_model', 'Y_pc_model', ...
+    'rate_pc_full', 'rate_tail', 'path_diagnostics'};
+require_fields(profile, required_fields, ...
+    'run_MH_pcpaths:InvalidProfile', 'profile');
+
+validate_finite_matrix(profile.news_basis, 'profile.news_basis', false);
+validate_finite_matrix(profile.Pi_pc_model, 'profile.Pi_pc_model', false);
+validate_finite_matrix(profile.Y_pc_model, 'profile.Y_pc_model', false);
+validate_finite_matrix(profile.rate_pc_full, ...
+    'profile.rate_pc_full', false);
+validate_finite_matrix(profile.rate_tail, 'profile.rate_tail', true);
+
+K_pc = size(profile.news_basis, 2);
+if size(profile.news_basis, 1) < 1 || K_pc < 1
+    error('run_MH_pcpaths:InvalidProfile', ...
+        'profile.news_basis must have positive row and column dimensions.');
+end
+if size(profile.Pi_pc_model, 2) ~= K_pc || ...
+        size(profile.Y_pc_model, 2) ~= K_pc || ...
+        size(profile.rate_pc_full, 2) ~= K_pc || ...
+        size(profile.rate_tail, 2) ~= K_pc
+    error('run_MH_pcpaths:InvalidProfile', ...
+        'All retained profile matrices must have K_pc columns.');
+end
+if size(profile.rate_tail, 1) > size(profile.rate_pc_full, 1)
+    error('run_MH_pcpaths:InvalidProfile', ...
+        'profile.rate_tail cannot be longer than profile.rate_pc_full.');
+end
+
+diagnostics = profile.path_diagnostics;
+if ~isstruct(diagnostics) || ~isscalar(diagnostics)
+    error('run_MH_pcpaths:InvalidProfile', ...
+        'profile.path_diagnostics must be a scalar struct.');
+end
+diagnostic_fields = {'rcond', 'max_abs_path_error', ...
+    'singular_values', 'news_norms'};
+require_fields(diagnostics, diagnostic_fields, ...
+    'run_MH_pcpaths:InvalidProfile', 'profile.path_diagnostics');
+validate_positive_scalar(diagnostics.rcond, ...
+    'profile.path_diagnostics.rcond');
+validate_nonnegative_scalar(diagnostics.max_abs_path_error, ...
+    'profile.path_diagnostics.max_abs_path_error');
+validate_finite_vector(diagnostics.singular_values, ...
+    size(profile.news_basis, 1), ...
+    'profile.path_diagnostics.singular_values');
+validate_finite_vector(diagnostics.news_norms, K_pc, ...
+    'profile.path_diagnostics.news_norms');
+if any(diagnostics.singular_values(:) < 0) || ...
+        any(diagnostics.news_norms(:) < 0)
+    error('run_MH_pcpaths:InvalidProfile', ...
+        'Singular values and news norms must be nonnegative.');
+end
+
+spec = struct();
+spec.news_basis_size = size(profile.news_basis);
+spec.Pi_pc_size = size(profile.Pi_pc_model);
+spec.Y_pc_size = size(profile.Y_pc_model);
+spec.rate_pc_full_size = size(profile.rate_pc_full);
+spec.rate_tail_size = size(profile.rate_tail);
+spec.n_singular_values = numel(diagnostics.singular_values);
+spec.K_pc = K_pc;
+
+if ~isempty(expected_spec)
+    compare_profile_size(spec.news_basis_size, ...
+        expected_spec.news_basis_size, 'profile.news_basis');
+    compare_profile_size(spec.Pi_pc_size, ...
+        expected_spec.Pi_pc_size, 'profile.Pi_pc_model');
+    compare_profile_size(spec.Y_pc_size, ...
+        expected_spec.Y_pc_size, 'profile.Y_pc_model');
+    compare_profile_size(spec.rate_pc_full_size, ...
+        expected_spec.rate_pc_full_size, 'profile.rate_pc_full');
+    compare_profile_size(spec.rate_tail_size, ...
+        expected_spec.rate_tail_size, 'profile.rate_tail');
+    if spec.n_singular_values ~= expected_spec.n_singular_values || ...
+            spec.K_pc ~= expected_spec.K_pc
+        error('run_MH_pcpaths:ProfileDimensionChanged', ...
+            'Proposal diagnostic dimensions differ from the initial profile.');
+    end
+end
+
+end
+
+function validate_finite_matrix(value, name, allow_empty)
+
+is_valid_type = isnumeric(value) && isfloat(value) && ...
+    isreal(value) && ismatrix(value);
+if ~is_valid_type || (~allow_empty && isempty(value)) || ...
+        any(~isfinite(value(:)))
+    if allow_empty
+        empty_text = 'possibly empty';
+    else
+        empty_text = 'nonempty';
+    end
+    error('run_MH_pcpaths:InvalidProfile', ...
+        '%s must be a %s, finite, real floating-point matrix.', ...
+        name, empty_text);
+end
+
+end
+
+function validate_finite_vector(value, expected_length, name)
+
+if ~isnumeric(value) || ~isfloat(value) || ~isreal(value) || ...
+        ~isvector(value) || numel(value) ~= expected_length || ...
+        any(~isfinite(value(:)))
+    error('run_MH_pcpaths:InvalidProfile', ...
+        '%s must be a finite real vector of length %d.', ...
+        name, expected_length);
+end
+
+end
+
+function validate_positive_scalar(value, name)
+
+if ~isnumeric(value) || ~isfloat(value) || ~isreal(value) || ...
+        ~isscalar(value) || ~isfinite(value) || value <= 0
+    error('run_MH_pcpaths:InvalidProfile', ...
+        '%s must be a finite positive real scalar.', name);
+end
+
+end
+
+function validate_nonnegative_scalar(value, name)
+
+if ~isnumeric(value) || ~isfloat(value) || ~isreal(value) || ...
+        ~isscalar(value) || ~isfinite(value) || value < 0
+    error('run_MH_pcpaths:InvalidProfile', ...
+        '%s must be a finite nonnegative real scalar.', name);
+end
+
+end
+
+function compare_profile_size(actual, expected, name)
+
+if ~isequal(actual, expected)
+    error('run_MH_pcpaths:ProfileDimensionChanged', ...
+        '%s changed size from %d-by-%d to %d-by-%d.', ...
+        name, expected(1), expected(2), actual(1), actual(2));
+end
+
+end
+
+function [new_factor, succeeded, covariance_active, failure_message] = ...
+    adapt_proposal_factor(param_history, old_factor, ...
+    active_dimensions, settings)
+
+new_factor = old_factor;
+succeeded = false;
+failure_message = '';
+active_index = find(active_dimensions);
+if isempty(active_index)
+    succeeded = true;
+    covariance_active = zeros(0, 0);
+    return
+end
+
+active_history = param_history(active_index, :).';
+covariance_active = cov(active_history, 0);
+if isscalar(covariance_active)
+    covariance_active = reshape(covariance_active, 1, 1);
+end
+covariance_scale = max(1, mean(diag(covariance_active)));
+regularized_covariance = covariance_active + ...
+    settings.adapt_jitter * covariance_scale * eye(numel(active_index));
+[adapted_factor_active, chol_status] = chol( ...
+    regularized_covariance, 'lower');
+if chol_status ~= 0 || any(~isfinite(adapted_factor_active(:)))
+    failure_message = ...
+        'Regularized empirical proposal covariance was not positive definite.';
+    return
+end
+
+new_factor = zeros(size(old_factor));
+new_factor(active_index, active_index) = ...
+    settings.adapt_scale * adapted_factor_active;
+succeeded = true;
+
+end
+
+function settings_without_draws = strip_rng_draws(settings)
+
+settings_without_draws = settings;
+draw_fields = {'normal_draws', 'uniform_draws'};
+for i_field = 1:numel(draw_fields)
+    if isfield(settings_without_draws, draw_fields{i_field})
+        settings_without_draws = rmfield( ...
+            settings_without_draws, draw_fields{i_field});
+    end
+end
+
+end
+
+function validate_positive_integer(value, name)
+
+if ~isnumeric(value) || ~isreal(value) || ~isscalar(value) || ...
+        ~isfinite(value) || value <= 0 || value ~= fix(value)
+    error('run_MH_pcpaths:InvalidSettings', ...
+        'settings.%s must be a finite positive integer.', name);
+end
+
+end
+
+function validate_nonnegative_integer(value, name)
+
+if ~isnumeric(value) || ~isreal(value) || ~isscalar(value) || ...
+        ~isfinite(value) || value < 0 || value ~= fix(value)
+    error('run_MH_pcpaths:InvalidSettings', ...
+        'settings.%s must be a finite nonnegative integer.', name);
+end
+
+end
+
+function require_fields(value, field_names, error_id, struct_name)
+
+for i_field = 1:numel(field_names)
+    field_name = field_names{i_field};
+    if ~isfield(value, field_name)
+        error(error_id, '%s is missing required field ''%s''.', ...
+            struct_name, field_name);
+    end
+end
+
+end
