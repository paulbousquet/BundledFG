+testCase.verifyEqual(result.proposal_evaluated_history, ...
+    [false, true, true]);
+testCase.verifyEqual(result.proposal_returned_history, ...
+    [false, true, true]);
+testCase.verifyEqual(result.proposal_valid_history, ...
+    [false, false, true]);
+testCase.verifyEqual(result.acceptance_history, ...
+    [false, false, true]);
+testCase.verifyEqual(result.param_history, [0, 0, 0.25], ...
+    'AbsTol', 1e-14);
+testCase.verifyEqual(result.objective_evaluation_count, 3);
+testCase.verifyEqual( ...
+    result.proposal_failure_identifier_history{1}, ...
