+function test_rank_hank_rank_sequence_has_no_stale_global_effect(testCase)
+
+repo_root = testCase.TestData.repo_root;
+param_rank = [0.73, 0.85, 0.99999, 0.74, 0.99999, 5.3, 0.47];
+
+initialize_model(repo_root, '/rank', 12);
+first = raw_legacy_irfs(param_rank, '/rank');
+initialize_model(repo_root, '/hank', 12);
+raw_legacy_irfs( ...
+    [0.9654, 0.9530, 0.99999, 0.8763, 0.99999, 5.7686, 0.4618], ...
+    '/hank');
+initialize_model(repo_root, '/rank', 12);
+second = raw_legacy_irfs(param_rank, '/rank');
+
+testCase.verifyEqual(second.Pi, first.Pi, 'AbsTol', 1e-12);
+testCase.verifyEqual(second.Y, first.Y, 'AbsTol', 1e-12);
+testCase.verifyEqual(second.R, first.R, 'AbsTol', 1e-12);
+testCase.verifyEqual(second.prior_penalty, first.prior_penalty, ...
+    'AbsTol', 1e-12);
+
+end
