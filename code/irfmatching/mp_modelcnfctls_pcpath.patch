+function test_profiles_follow_accepted_parameter_states(testCase)
+
+initial_param = [0; 0];
+proposal_factor = eye(2);
+settings = make_settings(2, 3, 0, 3, 1, 0);
+settings.normal_draws = [1,  2, -0.5;
+                         0,  0,  1.0];
+settings.uniform_draws = [0.5, 0.9, 0];
+
+result = run_MH_pcpaths( ...
+    @synthetic_objective, initial_param, proposal_factor, settings);
+
+expected_param_history = [1, 1, 0.5;
+                          0, 0, 1.0];
+expected_objective_history = [0, 0, 0.5];
+testCase.verifyEqual(result.param_history, expected_param_history, ...
+    'AbsTol', 1e-14);
+testCase.verifyEqual(result.objective_history, ...
+    expected_objective_history, 'AbsTol', 1e-14);
+testCase.verifyEqual(result.acceptance_history, [true, false, true]);
+testCase.verifyEqual(result.retained_iterations, 1:3);
+testCase.verifyEqual(result.param_draws, expected_param_history, ...
+    'AbsTol', 1e-14);
+testCase.verifyEqual(result.initial_objective, 1, 'AbsTol', 1e-14);
+testCase.verifyEqual(result.objective_evaluation_count, 4);
+testCase.verifyEqual(result.successful_proposal_evaluation_count, 3);
+testCase.verifyFalse(result.adaptation_attempted);
+testCase.verifyFalse(result.adaptation_succeeded);
+testCase.verifyEqual(result.proposal_factor, proposal_factor);
+
+testCase.verifySize(result.news_basis_draws, [2, 2, 3]);
+testCase.verifySize(result.Pi_pc_draws, [2, 2, 3]);
+testCase.verifySize(result.Y_pc_draws, [1, 2, 3]);
+testCase.verifySize(result.rate_pc_full_draws, [5, 2, 3]);
+testCase.verifySize(result.rate_tail_draws, [2, 2, 3]);
+testCase.verifySize(result.max_abs_path_error_draws, [1, 3]);
+testCase.verifySize(result.singular_values_draws, [2, 3]);
+testCase.verifySize(result.news_norms_draws, [2, 3]);
+
+% This is the key profiling-state regression test. Draw 1 accepts a new
+% parameter and must store its newly computed nuisance basis. Draw 2 is
+% rejected and must retain that basis. Draw 3 accepts another state and
+% must replace the basis again.
+for i_keep = 1:settings.N_keep
+    [expected_objective, expected_profile] = ...
+        synthetic_objective(expected_param_history(:, i_keep));
+    testCase.verifyEqual(result.objective_draws(i_keep), ...
+        expected_objective, 'AbsTol', 1e-14);
+    verify_stored_profile(testCase, result, i_keep, expected_profile);
+end
+testCase.verifyEqual(result.news_basis_draws(:, :, 1), ...
+    result.news_basis_draws(:, :, 2), 'AbsTol', 1e-14);
+testCase.verifyNotEqual(result.news_basis_draws(:, :, 2), ...
+    result.news_basis_draws(:, :, 3));
+testCase.verifyEqual(result.max_abs_path_error_draws(1), ...
+    result.max_abs_path_error_draws(2), 'AbsTol', 1e-16);
+testCase.verifyNotEqual(result.max_abs_path_error_draws(2), ...
+    result.max_abs_path_error_draws(3));
+
+end
