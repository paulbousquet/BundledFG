+function compare_legacy_and_pcpath(testCase, param, model_name)
+
+legacy = raw_legacy_irfs(param, model_name);
+global T T_use %#ok<GVMIS>
+
+H_path = 4;
+J_news = 4;
+K_pc = 2;
+news_basis = [1.00, 0.20; -0.30, 0.80; ...
+              0.15, -0.10; 0.05, 0.25];
+M_F = [eye(H_path), zeros(H_path, T - H_path)];
+V_path_model = M_F * legacy.R(:, 1:J_news) * news_basis;
+B_model = [legacy.Pi(1:T_use, 1:J_news) * news_basis; ...
+           legacy.Y(1:T_use, 1:J_news) * news_basis];
+
+cfg = struct( ...
+    'H_path', H_path, ...
+    'J_news', J_news, ...
+    'K_pc', K_pc, ...
+    'L_pi', T_use, ...
+    'L_y', T_use, ...
+    'T_model', T, ...
+    'map_options', struct( ...
+        'rcond_fail', 1e-12, ...
+        'rcond_warn', 1e-8, ...
+        'path_tol_abs', 1e-12, ...
+        'path_tol_rel', 1e-10, ...
+        'emit_warning', false));
+emp = struct( ...
+    'V_path_model', V_path_model, ...
+    'M_F', M_F, ...
+    'target_pc', B_model(:), ...
+    'Sigma_B_inv', eye(numel(B_model)));
+
+[new_objective, out] = solve_model_pcpaths(param, emp, cfg, model_name);
+
+tol = 2e-10;
+testCase.verifyTrue(out.admissible);
+testCase.verifyEqual(out.Pi_m_model, legacy.Pi, 'AbsTol', tol);
+testCase.verifyEqual(out.Y_m_model, legacy.Y, 'AbsTol', tol);
+testCase.verifyEqual(out.R_n_m_model, legacy.R, 'AbsTol', tol);
+testCase.verifyEqual(out.news_basis, news_basis, 'AbsTol', tol);
+testCase.verifyLessThan(out.md_loss, 1e-20);
+testCase.verifyEqual(out.prior_penalty, legacy.prior_penalty, ...
+    'AbsTol', 1e-11);
+testCase.verifyEqual(new_objective, legacy.prior_penalty, ...
+    'AbsTol', 1e-11);
+
+end
+
+function out = raw_legacy_irfs(param, model_name)
+
+global T_use %#ok<GVMIS>
+zero_target = zeros(3 * T_use, 1);
+identity_weight = eye(3 * T_use);
+[prior_penalty, Pi, Y, R, ~, ~, ~, ~] = solve_model( ...
+    param, zero_target, identity_weight, model_name);
+out = struct('prior_penalty', prior_penalty, ...
+    'Pi', Pi, 'Y', Y, 'R', R);
+
+end
