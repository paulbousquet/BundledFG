+    fprintf(file_id, '- Construction: `%s`\n', ...
+        result.design_info.raw_loading_formula);
+    fprintf(file_id, '- Source SHA-256: `%s`\n', ...
+        result.design_info.source_sha256);
+    fprintf(file_id, '- Measurement assumption: `%s`\n\n', ...
+        result.design_info.measurement_assumption);
+else
+    fprintf(file_id, '# Seven-parameter PC-path DSGE demonstration\n\n');
+    fprintf(file_id, ['This is a synthetic method demonstration using the actual ' ...
+        'RANK structural kernel. It is not an empirical estimate.\n\n']);
+    fprintf(file_id, ...
+        '![Completed demonstration](pc_path_rank7_demonstration.png)\n\n');
+end
+fprintf(file_id, '## Parameter recovery\n\n');
+fprintf(file_id, '| Parameter | True | Start | Estimated | Error | Relative error |\n');
+fprintf(file_id, '| --- | ---: | ---: | ---: | ---: | ---: |\n');
+for i_param = 1:height(result.parameter_table)
+    row = result.parameter_table(i_param, :);
+    fprintf(file_id, '| `%s` | %.8g | %.8g | %.8g | %+.3e | %+.3e |\n', ...
+        row.Parameter, row.True, row.Start, row.Estimated, ...
+        row.AbsoluteError, row.RelativeError);
+end
+fprintf(file_id, '\n## Numerical verification\n\n');
+fprintf(file_id, '- Structural parameters estimated: **7**\n');
+fprintf(file_id, '- Optimizer exit flag: `%d`\n', result.exitflag);
+fprintf(file_id, '- Objective evaluations: `%d`\n', result.evaluation_count);
+fprintf(file_id, '- Minimum macro-only loss: `%.12g`\n', result.minimum_loss);
+fprintf(file_id, '- Maximum absolute parameter error: `%.12g`\n', ...
+    result.max_abs_parameter_error);
+fprintf(file_id, '- Maximum path reconstruction error: `%.12g`\n', ...
+    result.max_abs_path_error);
+fprintf(file_id, '- Maximum macro residual: `%.12g`\n\n', ...
+    result.max_abs_macro_residual);
+fprintf(file_id, ['At every parameter proposal, the implementing current/news-wedge ' ...
+    'basis is recomputed from the rate block alone. Inflation and output enter only ' ...
+    'after that inversion.\n\n']);
+if result.empirical_v_used
+    fprintf(file_id, ['Production estimation remains fail-closed until the actual ' ...
+        'estimated `B_pi_emp`, `B_y_emp`, their joint covariance, and associated ' ...
+        'target metadata are supplied.\n']);
+else
+    fprintf(file_id, ['Production estimation remains fail-closed until the actual ' ...
+        'estimated `B_pi_emp`, `B_y_emp`, their joint covariance, model-unit PC ' ...
+        'paths, and a contract/calendar-consistent `M_F` are supplied.\n']);
+end
+
+end
+
+function options = normalize_options(options)
+
+if ~isstruct(options) || ~isscalar(options)
+    error('demo_pcpath_rank7_synthetic:InvalidOptions', ...
+        'options must be a scalar struct.');
+end
+defaults = struct( ...
+    'PathDesign', 'synthetic', ...
+    'SaveOutputs', false, ...
+    'OutputDirectory', '', ...
+    'Overwrite', false, ...
+    'KeepFigureOpen', false, ...
+    'Display', 'off', ...
+    'MaxIter', 1600, ...
+    'MaxFunEvals', 5000, ...
+    'TolX', 1e-9, ...
+    'TolFun', 1e-12);
+allowed = fieldnames(defaults);
+unknown = setdiff(fieldnames(options), allowed);
+if ~isempty(unknown)
+    error('demo_pcpath_rank7_synthetic:InvalidOptions', ...
+        'Unknown option ''%s''.', unknown{1});
+end
+for i_field = 1:numel(allowed)
+    field = allowed{i_field};
+    if ~isfield(options, field) || isempty(options.(field))
+        options.(field) = defaults.(field);
+    end
+end
+if isstring(options.PathDesign) && isscalar(options.PathDesign)
+    options.PathDesign = char(options.PathDesign);
+end
+if ~ischar(options.PathDesign) || ...
+        ~ismember(options.PathDesign, {'synthetic', 'empirical-v-n174'})
+    error('demo_pcpath_rank7_synthetic:InvalidOptions', ...
+        ['PathDesign must be ''synthetic'' or ' ...
+         '''empirical-v-n174''.']);
+end
+options.SaveOutputs = validate_logical(options.SaveOutputs, 'SaveOutputs');
+options.Overwrite = validate_logical(options.Overwrite, 'Overwrite');
+options.KeepFigureOpen = validate_logical( ...
+    options.KeepFigureOpen, 'KeepFigureOpen');
+if isstring(options.OutputDirectory) && isscalar(options.OutputDirectory)
+    options.OutputDirectory = char(options.OutputDirectory);
+end
+if ~ischar(options.OutputDirectory) || ...
+        (~isempty(options.OutputDirectory) && ~isrow(options.OutputDirectory))
+    error('demo_pcpath_rank7_synthetic:InvalidOptions', ...
+        'OutputDirectory must be a character row vector or scalar string.');
+end
+if isstring(options.Display) && isscalar(options.Display)
+    options.Display = char(options.Display);
+end
+if ~ischar(options.Display) || ~ismember(options.Display, {'off', 'final', 'iter'})
+    error('demo_pcpath_rank7_synthetic:InvalidOptions', ...
+        'Display must be ''off'', ''final'', or ''iter''.');
+end
+numeric_fields = {'MaxIter', 'MaxFunEvals', 'TolX', 'TolFun'};
+for i_field = 1:numel(numeric_fields)
+    field = numeric_fields{i_field};
+    value = options.(field);
+    if ~isnumeric(value) || ~isreal(value) || ~isscalar(value) || ...
+            ~isfinite(value) || value <= 0
+        error('demo_pcpath_rank7_synthetic:InvalidOptions', ...
+            '%s must be a finite positive scalar.', field);
+    end
+end
+
+end
+
+function value = validate_logical(value, name)
+
+is_binary = isnumeric(value) && isreal(value) && isscalar(value) && ...
+    isfinite(value) && (value == 0 || value == 1);
+if ~(islogical(value) && isscalar(value)) && ~is_binary
+    error('demo_pcpath_rank7_synthetic:InvalidOptions', ...
+        '%s must be a scalar logical or zero/one.', name);
+end
+value = logical(value);
+
+end
diff --git a/model_estim/diagnose_h3_vs_pc_identification.m b/model_estim/diagnose_h3_vs_pc_identification.m
new file mode 100644
index 0000000..8d03fba
--- /dev/null
+++ b/model_estim/diagnose_h3_vs_pc_identification.m
@@ -0,0 +1,1151 @@
+function result = diagnose_h3_vs_pc_identification(options)
+%DIAGNOSE_H3_VS_PC_IDENTIFICATION Population component-versus-path audit.
+%
+% This standalone diagnostic compares the complete treatment path induced
+% by the H=3 contract with the two empirical policy-path PCs. It generates
+% exact macro targets from the behavioral RANK model and uses no priors or
+% sampling uncertainty in either identification loss.
+
+if nargin < 1 || isempty(options)
+    options = struct();
+end
+options = normalize_options(options);
+
+model_estim_dir = fileparts(mfilename('fullpath'));
+repo_root = fileparts(model_estim_dir);
+auxiliary_dir = fullfile(repo_root, '_auxiliary_functions');
+original_path = path;
+path_cleanup = onCleanup(@() path(original_path));
+addpath(auxiliary_dir);
+
+global T T_use n_shock shocks_match %#ok<GVMIS>
+T = options.TModel;
+T_use = max(options.LPi, options.LY);
+n_shock = 8;
+shocks_match = 1;
+initialize_rank_model(repo_root);
+
+design = get_empirical_v_n174(T);
+scalar_direction = build_scalar_contract_direction( ...
+    design.V_path_model, design.Sigma_f, options.HStar);
+cfg = make_config(options, design.M_F);
+emp_two = make_diagnostic_empirical_object(design, cfg);
+raw_moment_handle = @(param) evaluate_h3_and_pc_moments( ...
+    param, emp_two, cfg, '/rank', scalar_direction);
+moment_handle = @(param) standardize_treatment_moments( ...
+    raw_moment_handle(param), design, scalar_direction);
+
+parameter_names = ["h"; "calvo_p"; "zeta_p"; "calvo_w"; ...
+    "zeta_w"; "kappa"; "psi_uti"; "m_d"; "m_f"];
+param0 = options.Param0(:);
+parameter_scale = options.ParameterScale(:);
+lower_bound = options.LowerBound(:);
+upper_bound = options.UpperBound(:);
+
+fd_options = struct( ...
+    'StepFraction', options.StepFraction, ...
+    'HalfStepRatio', 0.5, ...
+    'ReliabilityTolerance', options.DerivativeReliabilityTolerance);
+finite_difference = finite_difference_path_jacobians( ...
+    moment_handle, param0, parameter_scale, lower_bound, upper_bound, ...
+    fd_options);
+truth = finite_difference.baseline;
+
+n_macro = cfg.L_pi + cfg.L_y;
+B_pc_identification = reshape(truth.m_pc, n_macro, cfg.K_pc);
+macro_scale = max(options.MacroScaleFloor, ...
+    sqrt(mean(B_pc_identification.^2, 2)));
+W_h3_sqrt = diag(1 ./ macro_scale);
+W_pc_sqrt = kron(eye(2), W_h3_sqrt);
+S_parameter = diag(parameter_scale);
+D_h3_scaled = W_h3_sqrt * finite_difference.D_h3 * S_parameter;
+D_pc_scaled = W_pc_sqrt * finite_difference.D_pc * S_parameter;
+D_h3_scaled_full_step = W_h3_sqrt * ...
+    finite_difference.D_h3_full_step * S_parameter;
+D_pc_scaled_full_step = W_pc_sqrt * ...
+    finite_difference.D_pc_full_step * S_parameter;
+
+h3_svd = summarize_svd(D_h3_scaled, options.SvdTolerances);
+pc_svd = summarize_svd(D_pc_scaled, options.SvdTolerances);
+h3_svd_full_step = summarize_svd( ...
+    D_h3_scaled_full_step, options.SvdTolerances);
+pc_svd_full_step = summarize_svd( ...
+    D_pc_scaled_full_step, options.SvdTolerances);
+q_h3 = orient_vector(h3_svd.right_vectors(:, end));
+q_pc = orient_vector(pc_svd.right_vectors(:, end));
+sensitivity_h3_along_q = norm(D_h3_scaled * q_h3);
+sensitivity_pc_along_q = norm(D_pc_scaled * q_h3);
+sensitivity_gain_along_q = sensitivity_pc_along_q / ...
+    max(sensitivity_h3_along_q, realmin);
+minimum_singular_value_gain = pc_svd.singular_values(end) / ...
+    max(h3_svd.singular_values(end), realmin);
+
+classification = classify_local_identification( ...
+    h3_svd, pc_svd, h3_svd_full_step, pc_svd_full_step, ...
+    finite_difference, options);
+
+pairwise_h3 = derivative_cosines(D_h3_scaled);
+pairwise_pc = derivative_cosines(D_pc_scaled);
+loss_profile = trace_weak_direction(moment_handle, param0, ...
+    parameter_scale, lower_bound, upper_bound, q_h3, truth, ...
+    W_h3_sqrt, W_pc_sqrt, options);
+
+if options.RunMultistart
+    starts = deterministic_latin_hypercube( ...
+        options.NStarts, numel(param0), options.RandomSeed);
+    multistart_h3 = run_multistart( ...
+        'h3', starts, moment_handle, truth, W_h3_sqrt, W_pc_sqrt, ...
+        lower_bound, upper_bound, param0, options);
+    multistart_pc = run_multistart( ...
+        'pc', starts, moment_handle, truth, W_h3_sqrt, W_pc_sqrt, ...
+        lower_bound, upper_bound, param0, options);
+else
+    starts = zeros(0, numel(param0));
+    multistart_h3 = empty_multistart(numel(param0));
+    multistart_pc = empty_multistart(numel(param0));
+end
+
+if options.RunRobustness
+    robustness = run_robustness_checks(options, param0, parameter_scale);
+    % Recursive robustness calls reinitialize the global truncation. Restore
+    % the baseline before figures evaluate any retained parameter vectors.
+    T = options.TModel;
+    T_use = max(options.LPi, options.LY);
+    n_shock = 8;
+    shocks_match = 1;
+    initialize_rank_model(repo_root);
+else
+    robustness = empty_robustness();
+end
+classification.robustness_confirmed = false;
+if options.RunRobustness && ...
+        strcmp(classification.label, 'weak_local_identification') && ...
+        robustness.weak_gain_survives
+    classification.robustness_confirmed = true;
+    classification.explanation = [classification.explanation, ...
+        ' The gain survives longer model truncations and nearby truths.'];
+end
+
+result = struct();
+result.description = ['Population identification comparison between the ' ...
+    'complete H=3-induced path and the full empirical two-PC path span.'];
+result.model = '/rank';
+result.behavioral = true;
+result.prior_used = false;
+result.sampling_uncertainty_used = false;
+result.options = options;
+result.parameter_names = parameter_names;
+result.param0 = param0;
+result.parameter_scale = parameter_scale;
+result.lower_bound = lower_bound;
+result.upper_bound = upper_bound;
+result.design = design;
+result.scalar_direction = scalar_direction;
+result.cfg = cfg;
+result.macro_scale = macro_scale;
+result.truth = truth;
+result.B_pc_identification = B_pc_identification;
+result.finite_difference = finite_difference;
+result.D_h3_raw = finite_difference.D_h3;
+result.D_pc_raw = finite_difference.D_pc;
+result.D_h3_scaled = D_h3_scaled;
+result.D_pc_scaled = D_pc_scaled;
+result.h3_svd = h3_svd;
+result.pc_svd = pc_svd;
+result.h3_svd_full_step = h3_svd_full_step;
+result.pc_svd_full_step = pc_svd_full_step;
+result.q_h3 = q_h3;
+result.q_pc = q_pc;
+result.sensitivity_h3_along_q = sensitivity_h3_along_q;
+result.sensitivity_pc_along_q = sensitivity_pc_along_q;
+result.sensitivity_gain_along_q = sensitivity_gain_along_q;
+result.minimum_singular_value_gain = minimum_singular_value_gain;
+result.classification = classification;
+result.pairwise_h3 = pairwise_h3;
+result.pairwise_pc = pairwise_pc;
+result.loss_profile = loss_profile;
+result.starts_unit = starts;
+result.multistart_h3 = multistart_h3;
+result.multistart_pc = multistart_pc;
+result.multistart_loss_threshold = 1e-7;
+result.multistart_h3_evidence = summarize_multistart_evidence( ...
+    multistart_h3, result.multistart_loss_threshold);
+result.multistart_pc_evidence = summarize_multistart_evidence( ...
+    multistart_pc, result.multistart_loss_threshold);
+result.robustness = robustness;
+result.path_rcond = truth.profile.path_diagnostics.rcond;
+result.path_reconstruction_error = ...
+    truth.profile.path_diagnostics.max_abs_path_error;
+result.population_loss_h3_at_truth = 0.5 * norm( ...
+    W_h3_sqrt * (truth.m_h3 - truth.m_h3))^2;
+result.population_loss_pc_at_truth = 0.5 * norm( ...
+    W_pc_sqrt * (truth.m_pc - truth.m_pc))^2;
+result.output_files = struct();
+
+if options.SaveOutputs
+    result = save_outputs(result, options.OutputDirectory, options);
+end
+
+end
+
+function out = standardize_treatment_moments(raw, design, scalar_direction)
+
+factor_square_root = diag(sqrt(design.score_variances));
+out = raw;
+out.m_h3_raw = raw.m_h3;
+out.m_pc_raw = raw.m_pc;
+out.m_h3 = sqrt(scalar_direction.denominator) * raw.m_h3;
+B_pc_standardized = raw.B_pc * factor_square_root;
+out.m_pc = B_pc_standardized(:);
+out.B_pc_standardized = B_pc_standardized;
+out.identification_treatment_normalization = ...
+    ['H=3 response per one-standard-deviation selected-contract change; ' ...
+     'two-PC responses per one-standard-deviation orthogonal factor score.'];
+
+end
+
+function cfg = make_config(options, M_F)
+
+cfg = struct( ...
+    'H_path', 8, ...
+    'J_news', 8, ...
+    'K_pc', 2, ...
+    'L_pi', options.LPi, ...
+    'L_y', options.LY, ...
+    'T_model', options.TModel, ...
+    'allow_identity_M_F', true, ...
+    'M_F', M_F, ...
+    'map_options', struct( ...
+        'rcond_fail', 1e-12, ...
+        'rcond_warn', 1e-8, ...
+        'path_tol_abs', 1e-11, ...
+        'path_tol_rel', 1e-9, ...
+        'emit_warning', false));
+
+end
+
+function emp = make_diagnostic_empirical_object(design, cfg)
+
+n_macro = cfg.L_pi + cfg.L_y;
+emp = struct();
+emp.V_path_model = design.V_path_model;
+emp.target_pc = zeros(n_macro * cfg.K_pc, 1);
+emp.Sigma_B_inv = eye(n_macro * cfg.K_pc);
+emp.M_F = design.M_F;
+
+end
+
+function initialize_rank_model(repo_root)
+
+path = repo_root; %#ok<NASGU>
+vintage = ''; %#ok<NASGU>
+model = '/rank'; %#ok<NASGU>
+load_hank = 1; %#ok<NASGU>
+auxiliary_dir = fullfile(repo_root, '_auxiliary_functions');
+run(fullfile(auxiliary_dir, 'get_calibration_general.m'));
+run(fullfile(auxiliary_dir, 'get_baseline_jacobians.m'));
+run(fullfile(auxiliary_dir, 'get_priors_general.m'));
+
+end
+
+function summary = summarize_svd(D, tolerances)
+
+[left_vectors, singular_matrix, right_vectors] = svd(D, 'econ');
+singular_values = diag(singular_matrix);
+ranks = zeros(numel(tolerances), 1);
+for i_tolerance = 1:numel(tolerances)
+    ranks(i_tolerance) = sum(singular_values > ...
+        tolerances(i_tolerance) * singular_values(1));
+end
+summary = struct();
+summary.left_vectors = left_vectors;
+summary.right_vectors = right_vectors;
+summary.singular_values = singular_values;
+summary.relative_singular_values = singular_values / singular_values(1);
+summary.ranks = ranks;
+summary.tolerances = tolerances(:);
+summary.minimum_to_maximum = singular_values(end) / singular_values(1);
+
+end
+
+function vector = orient_vector(vector)
+
+[~, index] = max(abs(vector));
+if vector(index) < 0
+    vector = -vector;
+end
+
+end
+
+function classification = classify_local_identification( ...
+    h3_half, pc_half, h3_full, pc_full, finite_difference, options)
+
+n_param = numel(h3_half.singular_values);
+stable_rank_difference = sum(h3_half.ranks < n_param & ...
+    pc_half.ranks == n_param & h3_full.ranks < n_param & ...
+    pc_full.ranks == n_param) >= 2;
+full_rank_reference = h3_half.ranks(end) == n_param && ...
+    pc_half.ranks(end) == n_param;
+gain = pc_half.singular_values(end) / ...
+    max(h3_half.singular_values(end), realmin);
+if stable_rank_difference && finite_difference.all_reliable
+    label = 'candidate_exact_local_nonidentification';
+    explanation = ['The H=3 Jacobian loses rank at multiple tolerances and ' ...
+        'both finite-difference steps while the two-PC Jacobian is full rank. ' ...
+        'Truncation and neighborhood checks are still required before calling ' ...
+        'this exact non-identification.'];
+elseif full_rank_reference && gain >= options.WeakIdentificationGain
+    label = 'weak_local_identification';
+    explanation = ['Both Jacobians are numerically full rank at the finest ' ...
+        'tolerance, but the second path direction materially raises the ' ...
+        'smallest singular value.'];
+else
+    label = 'no_material_incremental_identification';
+    explanation = ['The local rank and smallest-singular-value comparison ' ...
+        'does not meet the predeclared threshold for a material gain.'];
+end
+classification = struct( ...
+    'label', label, ...
+    'explanation', explanation, ...
+    'stable_rank_difference_across_steps', stable_rank_difference, ...
+    'full_rank_at_finest_tolerance', full_rank_reference, ...
+    'minimum_singular_value_gain', gain, ...
+    'weak_identification_gain_threshold', options.WeakIdentificationGain);
+
+end
+
+function cosine_matrix = derivative_cosines(D)
+
+column_norm = sqrt(sum(D.^2, 1));
+denominator = column_norm' * column_norm;
+cosine_matrix = abs((D' * D) ./ denominator);
+cosine_matrix(denominator == 0) = NaN;
+
+end
+
+function profile = trace_weak_direction(moment_handle, param0, ...
+    parameter_scale, lower_bound, upper_bound, q_h3, truth, ...
+    W_h3_sqrt, W_pc_sqrt, options)
+
+physical_direction = parameter_scale .* q_h3;
+[a_lower, a_upper] = feasible_direction_interval( ...
+    param0, physical_direction, lower_bound, upper_bound);
+a_lower = max(a_lower * options.ProfileBoundFraction, ...
+    -options.MaximumProfileDistance);
+a_upper = min(a_upper * options.ProfileBoundFraction, ...
+    options.MaximumProfileDistance);
+unit_grid = linspace(-1, 1, options.NProfilePoints)';
+a_grid = zeros(size(unit_grid));
+negative = unit_grid < 0;
+positive = unit_grid > 0;
+a_grid(negative) = abs(a_lower) * unit_grid(negative) .* ...
+    abs(unit_grid(negative));
+a_grid(positive) = a_upper * unit_grid(positive).^2;
+n_grid = numel(a_grid);
+n_param = numel(param0);
+parameters = zeros(n_grid, n_param);
+loss_h3 = zeros(n_grid, 1);
+loss_pc = zeros(n_grid, 1);
+max_h3_difference = zeros(n_grid, 1);
+max_perp_difference = zeros(n_grid, 1);
+for i_grid = 1:n_grid
+    parameters(i_grid, :) = (param0 + ...
+        physical_direction * a_grid(i_grid))';
+    moments = moment_handle(parameters(i_grid, :));
+    residual_h3 = W_h3_sqrt * (moments.m_h3 - truth.m_h3);
+    residual_pc = W_pc_sqrt * (moments.m_pc - truth.m_pc);
+    loss_h3(i_grid) = 0.5 * sum(residual_h3.^2);
+    loss_pc(i_grid) = 0.5 * sum(residual_pc.^2);
+    max_h3_difference(i_grid) = max(abs(moments.m_h3 - truth.m_h3));
+    max_perp_difference(i_grid) = max(abs(moments.m_perp - truth.m_perp));
+end
+
+profile = struct( ...
+    'a', a_grid, ...
+    'parameters', parameters, ...
+    'physical_direction', physical_direction, ...
+    'loss_h3', loss_h3, ...
+    'loss_pc', loss_pc, ...
+    'max_h3_difference', max_h3_difference, ...
+    'max_perp_difference', max_perp_difference);
+
+end
+
+function robustness = run_robustness_checks(options, param0, parameter_scale)
+
+n_truncation = numel(options.RobustnessTModels);
+truncation_gain = NaN(n_truncation, 1);
+truncation_direction_gain = NaN(n_truncation, 1);
+truncation_reliable = false(n_truncation, 1);
+truncation_rcond = NaN(n_truncation, 1);
+for i_check = 1:n_truncation
+    diagnostic_options = robustness_options( ...
+        options, param0, options.RobustnessTModels(i_check));
+    check = diagnose_h3_vs_pc_identification(diagnostic_options);
+    truncation_gain(i_check) = check.minimum_singular_value_gain;
+    truncation_direction_gain(i_check) = check.sensitivity_gain_along_q;
+    truncation_reliable(i_check) = check.finite_difference.all_reliable;
+    truncation_rcond(i_check) = check.path_rcond;
+end
+truncation_table = table(options.RobustnessTModels(:), ...
+    truncation_gain, truncation_direction_gain, truncation_reliable, ...
+    truncation_rcond, 'VariableNames', {'TModel', 'MinimumGain', ...
+    'DirectionGain', 'DerivativesReliable', 'PathRcond'});
+
+n_neighborhood = options.NNeighborhoodChecks;
+neighborhood_gain = NaN(n_neighborhood, 1);
+neighborhood_direction_gain = NaN(n_neighborhood, 1);
+neighborhood_reliable = false(n_neighborhood, 1);
+neighborhood_params = zeros(n_neighborhood, numel(param0));
+sign_pattern = (-1).^(1:numel(param0))';
+for i_check = 1:n_neighborhood
+    magnitude = options.NeighborhoodFraction * ...
+        ceil(i_check / 2) / ceil(n_neighborhood / 2);
+    direction_sign = (-1)^(i_check + 1);
+    perturbation = direction_sign * magnitude * ...
+        parameter_scale .* circshift(sign_pattern, i_check - 1);
+    neighborhood_param = param0 + perturbation;
+    neighborhood_params(i_check, :) = neighborhood_param';
+    diagnostic_options = robustness_options( ...
+        options, neighborhood_param, options.TModel);
+    check = diagnose_h3_vs_pc_identification(diagnostic_options);
+    neighborhood_gain(i_check) = check.minimum_singular_value_gain;
+    neighborhood_direction_gain(i_check) = check.sensitivity_gain_along_q;
+    neighborhood_reliable(i_check) = check.finite_difference.all_reliable;
+end
+neighborhood_table = array2table(neighborhood_params, ...
+    'VariableNames', {'h', 'calvo_p', 'zeta_p', 'calvo_w', ...
+    'zeta_w', 'kappa', 'psi_uti', 'm_d', 'm_f'});
+neighborhood_table.MinimumGain = neighborhood_gain;
+neighborhood_table.DirectionGain = neighborhood_direction_gain;
+neighborhood_table.DerivativesReliable = neighborhood_reliable;
+
+robustness = struct();
+robustness.truncation = truncation_table;
+robustness.neighborhood = neighborhood_table;
+robustness.minimum_truncation_gain = min(truncation_gain);
+robustness.minimum_neighborhood_gain = min(neighborhood_gain);
+robustness.all_derivatives_reliable = ...
+    all(truncation_reliable) && all(neighborhood_reliable);
+robustness.weak_gain_survives = ...
+    robustness.minimum_truncation_gain >= options.WeakIdentificationGain && ...
+    robustness.minimum_neighborhood_gain >= options.WeakIdentificationGain;
+
+end
+
+function output = robustness_options(options, param0, T_model)
+
+output = struct( ...
+    'Param0', param0(:)', ...
+    'ParameterScale', options.ParameterScale, ...
+    'LowerBound', options.LowerBound, ...
+    'UpperBound', options.UpperBound, ...
+    'TModel', T_model, ...
+    'LPi', options.LPi, ...
+    'LY', options.LY, ...
+    'HStar', options.HStar, ...
+    'StepFraction', options.StepFraction, ...
+    'DerivativeReliabilityTolerance', ...
+        options.DerivativeReliabilityTolerance, ...
+    'SvdTolerances', options.SvdTolerances, ...
+    'MacroScaleFloor', options.MacroScaleFloor, ...
+    'WeakIdentificationGain', options.WeakIdentificationGain, ...
+    'NProfilePoints', 3, ...
+    'MaximumProfileDistance', 0.01, ...
+    'RunMultistart', false, ...
+    'RunRobustness', false, ...
+    'SaveOutputs', false);
+
+end
+
+function output = empty_robustness()
+
+output = struct( ...
+    'truncation', [], ...
+    'neighborhood', [], ...
+    'minimum_truncation_gain', NaN, ...
+    'minimum_neighborhood_gain', NaN, ...
+    'all_derivatives_reliable', false, ...
+    'weak_gain_survives', false);
+
+end
+
+function [a_lower, a_upper] = feasible_direction_interval( ...
+    param0, direction, lower_bound, upper_bound)
+
+a_lower = -Inf;
+a_upper = Inf;
+for i_param = 1:numel(param0)
+    if direction(i_param) > 0
+        a_lower = max(a_lower, ...
+            (lower_bound(i_param) - param0(i_param)) / direction(i_param));
+        a_upper = min(a_upper, ...
+            (upper_bound(i_param) - param0(i_param)) / direction(i_param));
+    elseif direction(i_param) < 0
+        a_lower = max(a_lower, ...
+            (upper_bound(i_param) - param0(i_param)) / direction(i_param));
+        a_upper = min(a_upper, ...
+            (lower_bound(i_param) - param0(i_param)) / direction(i_param));
+    end
+end
+
+end
+
+function starts = deterministic_latin_hypercube(n_start, n_param, seed)
+
+previous_rng = rng;
+rng_cleanup = onCleanup(@() rng(previous_rng));
+rng(seed, 'twister');
+starts = zeros(n_start, n_param);
+for i_param = 1:n_param
+    permutation = randperm(n_start)';
+    starts(:, i_param) = (permutation - rand(n_start, 1)) / n_start;
+end
+starts = 0.04 + 0.92 * starts;
+
+end
+
+function output = run_multistart(kind, starts, moment_handle, truth, ...
+    W_h3_sqrt, W_pc_sqrt, lower_bound, upper_bound, param0, options)
+
+n_start = size(starts, 1);
+n_param = size(starts, 2);
+span = upper_bound - lower_bound;
+solutions = zeros(n_start, n_param);
+loss = Inf(n_start, 1);
+exitflag = zeros(n_start, 1);
+function_count = zeros(n_start, 1);
+max_parameter_error = Inf(n_start, 1);
+heldout_max_difference = Inf(n_start, 1);
+optimizer_options = optimoptions('lsqnonlin', ...
+    'Display', 'off', ...
+    'MaxIterations', options.MultistartMaxIterations, ...
+    'MaxFunctionEvaluations', options.MultistartMaxFunctionEvaluations, ...
+    'StepTolerance', options.OptimizerStepTolerance, ...
+    'FunctionTolerance', options.OptimizerFunctionTolerance, ...
+    'OptimalityTolerance', options.OptimizerFunctionTolerance, ...
+    'FiniteDifferenceType', 'forward');
+
+for i_start = 1:n_start
+    start = starts(i_start, :)';
+    residual_handle = @(unit_param) multistart_residual( ...
+        unit_param, kind, moment_handle, truth, W_h3_sqrt, W_pc_sqrt, ...
+        lower_bound, span);
+    [unit_solution, residual_sum_squares, ~, exitflag(i_start), ...
+        optimizer_output] = lsqnonlin(residual_handle, start, ...
+        zeros(n_param, 1), ones(n_param, 1), optimizer_options);
+    solutions(i_start, :) = (lower_bound + span .* unit_solution)';
+    loss(i_start) = 0.5 * residual_sum_squares;
+    function_count(i_start) = optimizer_output.funcCount;
+    max_parameter_error(i_start) = max(abs( ...
+        solutions(i_start, :)' - param0));
+    moments = moment_handle(solutions(i_start, :));
+    heldout_max_difference(i_start) = max(abs( ...
+        moments.m_perp - truth.m_perp));
+    fprintf(['%s multistart %d/%d | loss=%.4g | max parameter ' ...
+        'error=%.4g | held-out difference=%.4g | exit=%d\n'], ...
+        upper(kind), i_start, n_start, loss(i_start), ...
+        max_parameter_error(i_start), heldout_max_difference(i_start), ...
+        exitflag(i_start));
+end
+
+output = struct( ...
+    'kind', kind, ...
+    'starts_unit', starts, ...
+    'solutions', solutions, ...
+    'loss', loss, ...
+    'exitflag', exitflag, ...
+    'function_count', function_count, ...
+    'max_parameter_error', max_parameter_error, ...
+    'heldout_max_difference', heldout_max_difference);
+
+end
+
+function residual = multistart_residual(unit_param, kind, moment_handle, ...
+    truth, W_h3_sqrt, W_pc_sqrt, lower_bound, span)
+
+param = lower_bound + span .* unit_param(:);
+try
+    moments = moment_handle(param');
+    if strcmp(kind, 'h3')
+        residual = W_h3_sqrt * (moments.m_h3 - truth.m_h3);
+    else
+        residual = W_pc_sqrt * (moments.m_pc - truth.m_pc);
+    end
+catch exception
+    if strcmp(exception.identifier, ...
+            'evaluate_h3_and_pc_moments:InadmissibleParameters')
+        if strcmp(kind, 'h3')
+            residual = 1e6 * ones(numel(truth.m_h3), 1);
+        else
+            residual = 1e6 * ones(numel(truth.m_pc), 1);
+        end
+    else
+        rethrow(exception);
+    end
+end
+
+end
+
+function output = empty_multistart(n_param)
+
+output = struct( ...
+    'kind', '', ...
+    'starts_unit', zeros(0, n_param), ...
+    'solutions', zeros(0, n_param), ...
+    'loss', zeros(0, 1), ...
+    'exitflag', zeros(0, 1), ...
+    'function_count', zeros(0, 1), ...
+    'max_parameter_error', zeros(0, 1), ...
+    'heldout_max_difference', zeros(0, 1));
+
+end
+
+function output = summarize_multistart_evidence(multistart, loss_threshold)
+
+output = struct( ...
+    'n_starts', numel(multistart.loss), ...
+    'n_positive_exitflag', sum(multistart.exitflag > 0), ...
+    'n_near_equivalent', 0, ...
+    'minimum_loss', NaN, ...
+    'median_loss', NaN, ...
+    'maximum_parameter_error_near', NaN, ...
+    'maximum_heldout_difference_near', NaN);
+if isempty(multistart.loss)
+    return
+end
+near = isfinite(multistart.loss) & multistart.loss <= loss_threshold;
+output.n_near_equivalent = sum(near);
+output.minimum_loss = min(multistart.loss);
+output.median_loss = median(multistart.loss);
+if any(near)
+    output.maximum_parameter_error_near = max( ...
+        multistart.max_parameter_error(near));
+    output.maximum_heldout_difference_near = max( ...
+        multistart.heldout_max_difference(near));
+end
+
+end
+
+function result = save_outputs(result, output_directory, options)
+
+if isempty(output_directory)
+    error('diagnose_h3_vs_pc_identification:MissingOutputDirectory', ...
+        'OutputDirectory is required when SaveOutputs=true.');
+end
+if ~isfolder(output_directory)
+    mkdir(output_directory);
+end
+files = output_file_manifest(output_directory);
+file_values = struct2cell(files);
+if ~options.Overwrite && any(cellfun(@isfile, file_values))
+    error('diagnose_h3_vs_pc_identification:OutputExists', ...
+        'One or more identification output files already exist.');
+end
+
+singular_table = table((1:numel(result.h3_svd.singular_values))', ...
+    result.h3_svd.singular_values, result.pc_svd.singular_values, ...
+    result.h3_svd.relative_singular_values, ...
+    result.pc_svd.relative_singular_values, ...
+    'VariableNames', {'Index', 'H3', 'TwoPC', 'H3Relative', 'TwoPCRelative'});
+writetable(singular_table, files.singular_values);
+
+weak_table = table(result.parameter_names, result.q_h3, ...
+    result.parameter_scale .* result.q_h3, result.q_pc, ...
+    'VariableNames', {'Parameter', 'H3ScaledLoading', ...
+    'H3PhysicalLoading', 'TwoPCScaledLoading'});
+writetable(weak_table, files.weak_direction);
+
+profile_table = array2table([result.loss_profile.a, ...
+    result.loss_profile.loss_h3, result.loss_profile.loss_pc, ...
+    result.loss_profile.max_h3_difference, ...
+    result.loss_profile.max_perp_difference, ...
+    result.loss_profile.parameters], ...
+    'VariableNames', [{'a', 'Q_H3', 'Q_TwoPC', 'MaxH3Difference', ...
+    'MaxHeldoutDifference'}, cellstr(result.parameter_names')]);
+writetable(profile_table, files.loss_profile_table);
+
+h3_multistart_table = multistart_table(result.multistart_h3, ...
+    result.parameter_names, result.lower_bound, result.upper_bound);
+pc_multistart_table = multistart_table(result.multistart_pc, ...
+    result.parameter_names, result.lower_bound, result.upper_bound);
+writetable(h3_multistart_table, files.multistart_h3);
+writetable(pc_multistart_table, files.multistart_pc);
+
+pairwise_table = pairwise_long_table( ...
+    result.pairwise_h3, result.pairwise_pc, result.parameter_names);
+writetable(pairwise_table, files.pairwise_table);
+
+summary_table = make_summary_table(result);
+writetable(summary_table, files.summary);
+
+make_singular_values_figure(result, files.singular_figure);
+make_loss_profile_figure(result, files.loss_figure);
+make_heldout_figure(result, files.heldout_figure);
+make_pairwise_figure(result, files.pairwise_figure);
+
+result.output_files = files;
+save(files.mat_file, 'result');
+write_report(files.report, result);
+
+end
+
+function files = output_file_manifest(output_directory)
+
+files = struct( ...
+    'summary', fullfile(output_directory, 'identification_summary.csv'), ...
+    'singular_values', fullfile(output_directory, ...
+        'jacobian_singular_values.csv'), ...
+    'weak_direction', fullfile(output_directory, ...
+        'weak_direction_loadings.csv'), ...
+    'multistart_h3', fullfile(output_directory, ...
+        'multistart_h3_solutions.csv'), ...
+    'multistart_pc', fullfile(output_directory, ...
+        'multistart_pc_solutions.csv'), ...
+    'loss_profile_table', fullfile(output_directory, ...
+        'weak_direction_loss_profile.csv'), ...
+    'pairwise_table', fullfile(output_directory, ...
+        'pairwise_derivative_collinearity.csv'), ...
+    'mat_file', fullfile(output_directory, 'identification_demo.mat'), ...
+    'singular_figure', fullfile(output_directory, ...
+        'singular_values_h3_vs_pc.png'), ...
+    'loss_figure', fullfile(output_directory, ...
+        'weak_direction_loss_profiles.png'), ...
+    'heldout_figure', fullfile(output_directory, ...
+        'heldout_path_irf_dispersion.png'), ...
+    'pairwise_figure', fullfile(output_directory, ...
+        'pairwise_derivative_collinearity.png'), ...
+    'report', fullfile(output_directory, 'identification_report.md'));
+
+end
+
+function output = multistart_table( ...
+    multistart, parameter_names, lower_bound, upper_bound)
+
+n_start = numel(multistart.loss);
+output = table((1:n_start)', multistart.exitflag, ...
+    multistart.function_count, multistart.loss, ...
+    multistart.max_parameter_error, multistart.heldout_max_difference, ...
+    'VariableNames', {'Start', 'ExitFlag', 'FunctionCount', 'Loss', ...
+    'MaxParameterError', 'MaxHeldoutDifference'});
+for i_param = 1:numel(parameter_names)
+    initial_name = "Initial_" + parameter_names(i_param);
+    output.(initial_name) = lower_bound(i_param) + ...
+        (upper_bound(i_param) - lower_bound(i_param)) * ...
+        multistart.starts_unit(:, i_param);
+    output.(parameter_names(i_param)) = multistart.solutions(:, i_param);
+end
+
+end
+
+function output = pairwise_long_table(h3, pc, parameter_names)
+
+n_param = numel(parameter_names);
+n_pair = n_param * (n_param - 1) / 2;
+first = strings(n_pair, 1);
+second = strings(n_pair, 1);
+h3_value = zeros(n_pair, 1);
+pc_value = zeros(n_pair, 1);
+index = 0;
+for i_first = 1:n_param
+    for i_second = (i_first + 1):n_param
+        index = index + 1;
+        first(index) = parameter_names(i_first);
+        second(index) = parameter_names(i_second);
+        h3_value(index) = h3(i_first, i_second);
+        pc_value(index) = pc(i_first, i_second);
+    end
+end
+output = table(first, second, h3_value, pc_value, ...
+    'VariableNames', {'Parameter1', 'Parameter2', 'H3Cosine', 'TwoPCCosine'});
+
+end
+
+function output = make_summary_table(result)
+
+keys = [ ...
+    "classification"; "model"; "n_parameters"; "h_star"; ...
+    "H_path"; "J_news"; "L_pi"; "L_y"; "T_model"; ...
+    "prior_used"; "sampling_uncertainty_used"; ...
+    "path_rcond"; "path_reconstruction_error"; ...
+    "h3_sigma_min"; "two_pc_sigma_min"; ...
+    "sigma_min_gain"; "h3_sigma_min_over_max"; ...
+    "two_pc_sigma_min_over_max"; "sensitivity_gain_along_q_h3"; ...
+    "derivatives_all_reliable"; "score_variance_pc1"; ...
+    "score_variance_pc2"; "scalar_normalization_error"; ...
+    "robustness_confirmed"; "minimum_truncation_gain"; ...
+    "minimum_neighborhood_gain"; "multistart_loss_threshold"; ...
+    "h3_near_equivalent_solutions"; ...
+    "h3_max_parameter_error_near"; "h3_max_heldout_difference_near"; ...
+    "two_pc_near_equivalent_solutions"; ...
+    "two_pc_max_parameter_error_near"; ...
+    "two_pc_max_heldout_difference_near"; ...
+    "source_sha256"];
+values = [ ...
+    string(result.classification.label); string(result.model); ...
+    string(numel(result.param0)); string(result.options.HStar); ...
+    string(result.cfg.H_path); string(result.cfg.J_news); ...
+    string(result.cfg.L_pi); string(result.cfg.L_y); ...
+    string(result.cfg.T_model); string(result.prior_used); ...
+    string(result.sampling_uncertainty_used); string(result.path_rcond); ...
+    string(result.path_reconstruction_error); ...
+    string(result.h3_svd.singular_values(end)); ...
+    string(result.pc_svd.singular_values(end)); ...
+    string(result.minimum_singular_value_gain); ...
+    string(result.h3_svd.minimum_to_maximum); ...
+    string(result.pc_svd.minimum_to_maximum); ...
+    string(result.sensitivity_gain_along_q); ...
+    string(result.finite_difference.all_reliable); ...
+    string(result.design.score_variances(1)); ...
+    string(result.design.score_variances(2)); ...
+    string(result.scalar_direction.normalization_error); ...
+    string(result.classification.robustness_confirmed); ...
+    string(result.robustness.minimum_truncation_gain); ...
+    string(result.robustness.minimum_neighborhood_gain); ...
+    string(result.multistart_loss_threshold); ...
+    string(result.multistart_h3_evidence.n_near_equivalent); ...
+    string(result.multistart_h3_evidence.maximum_parameter_error_near); ...
+    string(result.multistart_h3_evidence.maximum_heldout_difference_near); ...
+    string(result.multistart_pc_evidence.n_near_equivalent); ...
+    string(result.multistart_pc_evidence.maximum_parameter_error_near); ...
+    string(result.multistart_pc_evidence.maximum_heldout_difference_near); ...
+    string(result.design.source_sha256)];
+output = table(keys, values, 'VariableNames', {'Statistic', 'Value'});
+
+end
+
+function make_singular_values_figure(result, filename)
+
+figure_handle = figure('Visible', 'off', 'Color', 'w', ...
+    'Position', [100, 100, 1000, 650]);
+cleanup = onCleanup(@() close(figure_handle));
+semilogy(1:numel(result.h3_svd.singular_values), ...
+    result.h3_svd.singular_values, 'o-', 'LineWidth', 1.8);
+hold on;
+semilogy(1:numel(result.pc_svd.singular_values), ...
+    result.pc_svd.singular_values, 's-', 'LineWidth', 1.8);
+hold off;
+grid on;
+xlabel('Singular-value index');
+ylabel('Scaled Jacobian singular value');
+title('Local identification: H=3-induced path versus two-PC span');
+legend({'H=3 scalar experiment', 'Two-PC experiment'}, 'Location', 'best');
+exportgraphics(figure_handle, filename, 'Resolution', 220);
+
+end
+
+function make_loss_profile_figure(result, filename)
+
+figure_handle = figure('Visible', 'off', 'Color', 'w', ...
+    'Position', [100, 100, 1000, 650]);
+cleanup = onCleanup(@() close(figure_handle));
+floor_value = 1e-24;
+semilogy(result.loss_profile.a, ...
+    max(result.loss_profile.loss_h3, floor_value), ...
+    '-', 'LineWidth', 2);
+hold on;
+semilogy(result.loss_profile.a, ...
+    max(result.loss_profile.loss_pc, floor_value), ...
+    '-', 'LineWidth', 2);
+hold off;
+grid on;
+xlabel('Distance along weakest H=3 parameter direction');
+ylabel('Exact population loss');
+title('Exact nonlinear loss along the weakest scalar-experiment direction');
+legend({'H=3 scalar experiment', 'Two-PC experiment'}, 'Location', 'best');
+exportgraphics(figure_handle, filename, 'Resolution', 220);
+
+end
+
+function make_heldout_figure(result, filename)
+
+make_h3_pc_heldout_figure(result, filename);
+
+end
+
+function make_pairwise_figure(result, filename)
+
+figure_handle = figure('Visible', 'off', 'Color', 'w', ...
+    'Position', [100, 100, 1400, 620]);
+cleanup = onCleanup(@() close(figure_handle));
+subplot(1, 2, 1);
+imagesc(result.pairwise_h3, [0, 1]);
+axis image;
+colorbar;
+xticks(1:numel(result.parameter_names));
+yticks(1:numel(result.parameter_names));
+xticklabels(result.parameter_names);
+yticklabels(result.parameter_names);
+xtickangle(45);
+title('H=3 absolute derivative cosine');
+subplot(1, 2, 2);
+imagesc(result.pairwise_pc, [0, 1]);
+axis image;
+colorbar;
+xticks(1:numel(result.parameter_names));
+yticks(1:numel(result.parameter_names));
+xticklabels(result.parameter_names);
+yticklabels(result.parameter_names);
+xtickangle(45);
+title('Two-PC absolute derivative cosine');
+exportgraphics(figure_handle, filename, 'Resolution', 220);
+
+end
+
+function write_report(filename, result)
+
+file_id = fopen(filename, 'w');
+if file_id < 0
+    error('diagnose_h3_vs_pc_identification:ReportWriteFailed', ...
+        'Could not open %s for writing.', filename);
+end
+cleanup = onCleanup(@() fclose(file_id));
+fprintf(file_id, '# H=3 component versus two-PC population identification\n\n');
+fprintf(file_id, '**Conclusion:** `%s`\n\n', result.classification.label);
+fprintf(file_id, '%s\n\n', result.classification.explanation);
+fprintf(file_id, ['Both designs are locally full rank. The result is therefore ' ...
+    '**pronounced weak identification under H=3 alone**, not exact point ' ...
+    'non-identification. The two-PC design sharply steepens the population ' ...
+    'criterion in the weak direction.\n\n']);
+fprintf(file_id, ['This is a model-side population exercise. The empirical `V` and ' ...
+    'factor-score covariance select the treatments, while every macro response is ' ...
+    'generated exactly from the behavioral RANK model at the displayed truth. ' ...
+    'No empirical macro-response matrix, sampling covariance, or prior is needed.\n\n']);
+fprintf(file_id, '## Treatment construction\n\n');
+fprintf(file_id, ['The scalar treatment is the complete path from the population ' ...
+    'regression of all contracts on the H=3 contract, not a path with seven zeros:\n\n']);
+fprintf(file_id, '`v_3 = V Sigma_f V''e_3 / (e_3''V Sigma_f V''e_3)`.\n\n');
+fprintf(file_id, '- Selected contract: `%s` (zero-based H=%d)\n', ...
+    result.design.contract_labels(result.options.HStar + 1), ...
+    result.options.HStar);
+fprintf(file_id, '- Scalar normalization error: `%.3e`\n', ...
+    result.scalar_direction.normalization_error);
+fprintf(file_id, '- Score variances: `[%.8g, %.8g]`\n', ...
+    result.design.score_variances);
+fprintf(file_id, ['- Identification units: one-standard-deviation H=3 ' ...
+    'contract change versus one-standard-deviation factor-score changes\n']);
+fprintf(file_id, '- Path-map rcond: `%.8g`\n', result.path_rcond);
+fprintf(file_id, '- Path reconstruction error: `%.3e`\n\n', ...
+    result.path_reconstruction_error);
+fprintf(file_id, '## Local Jacobian result\n\n');
+fprintf(file_id, '- H=3 smallest singular value: `%.12g`\n', ...
+    result.h3_svd.singular_values(end));
+fprintf(file_id, '- Two-PC smallest singular value: `%.12g`\n', ...
+    result.pc_svd.singular_values(end));
+fprintf(file_id, '- Smallest-singular-value gain: `%.8g`\n', ...
+    result.minimum_singular_value_gain);
+fprintf(file_id, '- Sensitivity gain along weakest H=3 direction: `%.8g`\n', ...
+    result.sensitivity_gain_along_q);
+fprintf(file_id, '- All derivatives stable to step halving: `%s`\n\n', ...
+    string(result.finite_difference.all_reliable));
+if result.options.RunRobustness
+    fprintf(file_id, '## Robustness\n\n');
+    fprintf(file_id, ['- Minimum gain at model truncations T=%s: ' ...
+        '`%.8g`\n'], mat2str(result.options.RobustnessTModels), ...
+        result.robustness.minimum_truncation_gain);
+    fprintf(file_id, '- Minimum gain over %d nearby truths: `%.8g`\n', ...
+        result.options.NNeighborhoodChecks, ...
+        result.robustness.minimum_neighborhood_gain);
+    fprintf(file_id, '- All robustness derivatives stable: `%s`\n\n', ...
+        string(result.robustness.all_derivatives_reliable));
+end
+if result.options.RunMultistart
+    fprintf(file_id, '## Global population recovery\n\n');
+    fprintf(file_id, ['Using the same %d deterministic starts and bounds, a ' ...
+        'fit is called near-equivalent when its population loss is at most ' ...
+        '`%.1e`.\n\n'], result.options.NStarts, ...
+        result.multistart_loss_threshold);
+    fprintf(file_id, ['- H=3: %d near-equivalent fits; maximum parameter ' ...
+        'error `%.6g`; maximum held-out-path response difference `%.6g`.\n'], ...
+        result.multistart_h3_evidence.n_near_equivalent, ...
+        result.multistart_h3_evidence.maximum_parameter_error_near, ...
+        result.multistart_h3_evidence.maximum_heldout_difference_near);
+    fprintf(file_id, ['- Two-PC: %d near-equivalent fits; maximum parameter ' ...
+        'error `%.6g`; maximum held-out-path response difference `%.6g`.\n\n'], ...
+        result.multistart_pc_evidence.n_near_equivalent, ...
+        result.multistart_pc_evidence.maximum_parameter_error_near, ...
+        result.multistart_pc_evidence.maximum_heldout_difference_near);
+end
+fprintf(file_id, '### Weakest H=3 direction\n\n');
+fprintf(file_id, '| Parameter | Scaled loading | Physical loading |\n');
+fprintf(file_id, '| --- | ---: | ---: |\n');
+for i_param = 1:numel(result.parameter_names)
+    fprintf(file_id, '| `%s` | %+.6f | %+.6f |\n', ...
+        result.parameter_names(i_param), result.q_h3(i_param), ...
+        result.parameter_scale(i_param) * result.q_h3(i_param));
+end
+fprintf(file_id, '\n## Figures\n\n');
+fprintf(file_id, '![Singular values](singular_values_h3_vs_pc.png)\n\n');
+fprintf(file_id, '![Loss profiles](weak_direction_loss_profiles.png)\n\n');
+fprintf(file_id, '![Held-out path](heldout_path_irf_dispersion.png)\n\n');
+fprintf(file_id, '![Derivative collinearity](pairwise_derivative_collinearity.png)\n');
+
+end
+
+function options = normalize_options(options)
+
+defaults = struct( ...
+    'Param0', [0.7431614726668860, 0.7648205693282238, ...
+        0.7907190508343160, 0.7699255819901178, 0.5207954305297746, ...
+        5.665753113345150, 0.3626107236203683, 0.6061222114756228, ...
+        0.6448141676771757], ...
+    'ParameterScale', [0.15, 0.15, 0.15, 0.15, 0.15, 1.50, 0.15, 0.15, 0.15], ...
+    'LowerBound', [0.10, 0.40, 0.40, 0.40, 0.40, 1.00, 0.10, 0.40, 0.40], ...
+    'UpperBound', [0.95, 0.98, 0.98, 0.98, 0.98, 9.00, 0.90, 0.98, 0.98], ...
+    'TModel', 80, ...
+    'LPi', 20, ...
+    'LY', 20, ...
+    'HStar', 3, ...
+    'StepFraction', 2e-4, ...
+    'DerivativeReliabilityTolerance', 0.02, ...
+    'SvdTolerances', [1e-6, 1e-8, 1e-10, 1e-12], ...
+    'MacroScaleFloor', 0.01, ...
+    'WeakIdentificationGain', 5, ...
+    'NProfilePoints', 31, ...
+    'MaximumProfileDistance', 0.15, ...
+    'ProfileBoundFraction', 0.90, ...
+    'RunMultistart', false, ...
+    'RunRobustness', true, ...
+    'RobustnessTModels', [100, 120], ...
+    'NNeighborhoodChecks', 4, ...
+    'NeighborhoodFraction', 0.02, ...
+    'NStarts', 25, ...
+    'RandomSeed', 8675309, ...
+    'MultistartMaxIterations', 250, ...
+    'MultistartMaxFunctionEvaluations', 2500, ...
+    'OptimizerStepTolerance', 1e-9, ...
+    'OptimizerFunctionTolerance', 1e-12, ...
+    'SaveOutputs', false, ...
+    'OutputDirectory', '', ...
+    'Overwrite', false);
+if ~isstruct(options) || ~isscalar(options)
+    error('diagnose_h3_vs_pc_identification:InvalidOptions', ...
+        'options must be a scalar struct.');
+end
+names = fieldnames(defaults);
+unknown = setdiff(fieldnames(options), names);
+if ~isempty(unknown)
+    error('diagnose_h3_vs_pc_identification:InvalidOptions', ...
+        'Unknown option ''%s''.', unknown{1});
+end
+for i_name = 1:numel(names)
+    name = names{i_name};
+    if ~isfield(options, name) || isempty(options.(name))
+        options.(name) = defaults.(name);
+    end
+end
+
+vector_fields = {'Param0', 'ParameterScale', 'LowerBound', 'UpperBound'};
+for i_field = 1:numel(vector_fields)
+    name = vector_fields{i_field};
+    value = options.(name);
+    if ~isnumeric(value) || ~isfloat(value) || ~isreal(value) || ...
+            ~isvector(value) || numel(value) ~= 9 || any(~isfinite(value(:)))
+        error('diagnose_h3_vs_pc_identification:InvalidOptions', ...
+            '%s must contain nine finite real values.', name);
+    end
+    options.(name) = value(:)';
+end
+if any(options.ParameterScale <= 0) || ...
+        any(options.LowerBound >= options.UpperBound) || ...
+        any(options.Param0 <= options.LowerBound) || ...
+        any(options.Param0 >= options.UpperBound)
+    error('diagnose_h3_vs_pc_identification:InvalidOptions', ...
+        'Parameter scales/bounds/truth are inconsistent.');
+end
+
+positive_integer_fields = {'TModel', 'LPi', 'LY', 'NProfilePoints', ...
+    'NStarts', 'RandomSeed', 'MultistartMaxIterations', ...
+    'MultistartMaxFunctionEvaluations', 'NNeighborhoodChecks'};
+for i_field = 1:numel(positive_integer_fields)
+    validate_positive_integer(options.(positive_integer_fields{i_field}), ...
+        positive_integer_fields{i_field});
+end
+if options.TModel < max([8, options.LPi, options.LY])
+    error('diagnose_h3_vs_pc_identification:InvalidOptions', ...
+        'TModel must cover every path and macro-response horizon.');
+end
+if ~isnumeric(options.HStar) || ~isscalar(options.HStar) || ...
+        ~isfinite(options.HStar) || options.HStar < 0 || ...
+        options.HStar > 7 || options.HStar ~= fix(options.HStar)
+    error('diagnose_h3_vs_pc_identification:InvalidOptions', ...
+        'HStar must be an integer from zero through seven.');
+end
+positive_fields = {'StepFraction', 'DerivativeReliabilityTolerance', ...
+    'MacroScaleFloor', 'WeakIdentificationGain', 'MaximumProfileDistance', ...
+    'ProfileBoundFraction', 'OptimizerStepTolerance', ...
+    'OptimizerFunctionTolerance', 'NeighborhoodFraction'};
+for i_field = 1:numel(positive_fields)
+    validate_positive_scalar(options.(positive_fields{i_field}), ...
+        positive_fields{i_field});
+end
+if options.ProfileBoundFraction >= 1
+    error('diagnose_h3_vs_pc_identification:InvalidOptions', ...
+        'ProfileBoundFraction must be less than one.');
+end
+if ~isnumeric(options.SvdTolerances) || ...
+        ~isvector(options.SvdTolerances) || ...
+        any(~isfinite(options.SvdTolerances(:))) || ...
+        any(options.SvdTolerances(:) <= 0) || ...
+        any(options.SvdTolerances(:) >= 1)
+    error('diagnose_h3_vs_pc_identification:InvalidOptions', ...
+        'SvdTolerances must contain finite values strictly between zero and one.');
+end
+options.SvdTolerances = options.SvdTolerances(:);
+if ~isnumeric(options.RobustnessTModels) || ...
+        ~isvector(options.RobustnessTModels) || ...
+        any(~isfinite(options.RobustnessTModels(:))) || ...
+        any(options.RobustnessTModels(:) < max([8, options.LPi, options.LY])) || ...
+        any(options.RobustnessTModels(:) ~= fix(options.RobustnessTModels(:)))
+    error('diagnose_h3_vs_pc_identification:InvalidOptions', ...
+        'RobustnessTModels must contain valid integer truncation horizons.');
+end
+options.RobustnessTModels = options.RobustnessTModels(:)';
+logical_fields = {'RunMultistart', 'RunRobustness', ...
+    'SaveOutputs', 'Overwrite'};
+for i_field = 1:numel(logical_fields)
+    name = logical_fields{i_field};
+    options.(name) = validate_logical(options.(name), name);
+end
+if isstring(options.OutputDirectory) && isscalar(options.OutputDirectory)
+    options.OutputDirectory = char(options.OutputDirectory);
+end
+if ~ischar(options.OutputDirectory) || ...
+        (~isempty(options.OutputDirectory) && ~isrow(options.OutputDirectory))
+    error('diagnose_h3_vs_pc_identification:InvalidOptions', ...
+        'OutputDirectory must be a character row vector or scalar string.');
+end
+
+end
+
+function validate_positive_integer(value, name)
+
+if ~isnumeric(value) || ~isreal(value) || ~isscalar(value) || ...
+        ~isfinite(value) || value <= 0 || value ~= fix(value)
+    error('diagnose_h3_vs_pc_identification:InvalidOptions', ...
+        '%s must be a finite positive integer.', name);
+end
+
+end
+
+function validate_positive_scalar(value, name)
+
+if ~isnumeric(value) || ~isreal(value) || ~isscalar(value) || ...
+        ~isfinite(value) || value <= 0
+    error('diagnose_h3_vs_pc_identification:InvalidOptions', ...
+        '%s must be a finite positive scalar.', name);
+end
+
+end
+
+function value = validate_logical(value, name)
+
+is_binary = isnumeric(value) && isreal(value) && isscalar(value) && ...
+    isfinite(value) && (value == 0 || value == 1);
+if ~(islogical(value) && isscalar(value)) && ~is_binary
+    error('diagnose_h3_vs_pc_identification:InvalidOptions', ...
+        '%s must be a scalar logical or zero/one.', name);
+end
+value = logical(value);
+
+end
