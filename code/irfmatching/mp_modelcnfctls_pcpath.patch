+function test_policy_tail_is_reported_but_not_added_to_residual(testCase)
+
+f = testCase.TestData.fixture;
+[loss_base, out_base] = profile_pcpath_irfs(f.Pi, f.Y, f.R, f.emp, f.cfg);
+
+R_tail = f.R;
+R_tail(f.cfg.H_path+1:end,1:f.cfg.J_news) = ...
+    R_tail(f.cfg.H_path+1:end,1:f.cfg.J_news) + ...
+    reshape(0.01:0.01:0.12, f.T-f.cfg.H_path, f.cfg.J_news);
+[loss_tail, out_tail] = profile_pcpath_irfs( ...
+    f.Pi, f.Y, R_tail, f.emp, f.cfg);
